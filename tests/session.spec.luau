-- Run with the standalone Luau CLI; the real session and economy have no engine dependency.
local Config = require("../src/shared/Config")
local Economy = require("../src/shared/Economy")
local Session = require("../src/server/Session")

local passed = 0
local function test(name, run)
	local success, message = pcall(run)
	assert(success, "FAIL " .. name .. ": " .. tostring(message))
	passed += 1
	print("PASS " .. name)
end

local function fresh(baseId)
	return Session.new(baseId or 1, Config, Economy)
end

local function hatch(session, zoneId, rarityRoll, animalRoll)
	assert(session:steal(zoneId))
	local pending = session:deposit(100)
	assert(pending)
	local result = session:finishHatch(pending.slot, pending.readyAt, rarityRoll, animalRoll)
	assert(result)
	return result
end

test("new sessions start independently with 25 cash and three empty hatch slots", function()
	local first = fresh(1)
	local second = fresh(2)
	assert(first.cash == 25 and first.speedLevel == 0 and first.carrying == nil)
	assert(first:freeSlot() == 1 and #first.animals == 0 and next(first.discovered) == nil)
	assert(first:snapshot().baseId == 1 and second:snapshot().baseId == 2)
	assert(first.animals ~= second.animals and first.hatches ~= second.hatches)
	assert(first.discovered ~= second.discovered)
	assert(not first:steal("missing"))
	assert(first.carrying == nil and first.cash == 25)
end)

test("steal, deposit, wait, and hatch award one animal exactly once", function()
	local session = fresh()
	assert(session:deposit(0) == nil)
	assert(session:finishHatch(1, 0, 0, 0) == nil)
	assert(session:steal("turtle"))
	assert(session.carrying == "turtle")
	assert(not session:steal("turtle"))
	local pending = session:deposit(100)
	assert(pending.slot == 1 and pending.zoneId == "turtle" and pending.readyAt == 110)
	assert(session.carrying == nil and #session.animals == 0)
	assert(session:finishHatch(1, 109.999, 0, 0) == nil)
	assert(session.hatches[1] == pending and #session.animals == 0)
	local result = session:finishHatch(1, 110, 0, 0)
	assert(result.animalId == "duck" and result.kept and result.replacedId == nil)
	assert(session.hatches[1] == nil and #session.animals == 1)
	assert(session.animals[1].id == "duck" and session.discovered.duck)
	assert(session:finishHatch(1, 111, 0, 0) == nil)
	assert(#session.animals == 1 and session.cash == 25)
end)

test("repeated deposit requests cannot create more than one hatch", function()
	local session = fresh()
	assert(session:steal("turtle"))
	local first = session:deposit(10)
	for now = 11, 20 do
		assert(session:deposit(now) == nil)
	end
	assert(session.hatches[1] == first and first.readyAt == 20)
	assert(session.hatches[2] == nil and session.hatches[3] == nil)
	assert(session:freeSlot() == 2 and session.carrying == nil)
end)

test("three pending eggs block a fourth steal and finishing a middle slot frees it", function()
	local session = fresh()
	for slot = 1, 3 do
		assert(session:steal("turtle"))
		assert(session:deposit(100).slot == slot)
	end
	assert(session:freeSlot() == nil)
	assert(not session:steal("turtle"))
	assert(session.carrying == nil and #session:snapshot().hatches == 3)
	assert(session:finishHatch(2, 110, 0, 0))
	local remaining = session:snapshot().hatches
	assert(#remaining == 2 and remaining[1].slot == 1 and remaining[2].slot == 3)
	assert(session:steal("turtle"))
	assert(session:deposit(111).slot == 2)
	assert(session:freeSlot() == nil and #session.animals == 1)
end)

test("starting cash needs pet income before the first speed upgrade", function()
	local session = fresh()
	assert(not session:upgrade())
	assert(session.cash == 25 and session.speedLevel == 0)
	hatch(session, "turtle", 0, 0)
	session:earn(5)
	assert(session:upgrade())
	assert(session.cash == 0 and session.speedLevel == 1)
	assert(session:snapshot().walkSpeed == 18 and session:snapshot().upgradeCost == 82)
	for _ = 1, 3 do
		assert(not session:upgrade())
		assert(session.cash == 0 and session.speedLevel == 1)
	end
end)

test("rabbit eggs are locked through level five and unlock at level six", function()
	local session = fresh()
	session.cash = 10000
	for level = 0, 5 do
		assert(session.speedLevel == level)
		assert(not session:steal("rabbit"))
		assert(session.carrying == nil)
		assert(session:upgrade())
	end
	assert(session.speedLevel == 6 and session:snapshot().walkSpeed == 28)
	assert(session:steal("rabbit"))
	assert(session:deposit(100).readyAt == 118)
end)

test("the speed cap rejects upgrades without taking cash", function()
	local session = fresh()
	session.speedLevel = Config.speed.maxLevel
	session.cash = 100000
	assert(not session:upgrade())
	assert(session.cash == 100000 and session.speedLevel == 12)
	assert(session:snapshot().walkSpeed == 40 and session:snapshot().upgradeCost == nil)
end)

test("hatching keeps the best eight animals and records discarded discoveries", function()
	local session = fresh()
	for _ = 1, 8 do
		assert(hatch(session, "turtle", 0, 0).kept)
	end
	assert(#session.animals == 8 and session:snapshot().income == 40)
	session.speedLevel = 6
	local stronger = hatch(session, "rabbit", 0.99, 0)
	assert(stronger.animalId == "dinosaur" and stronger.replacedId == "duck" and stronger.kept)
	assert(#session.animals == 8 and session:snapshot().income == 125)
	assert(session.discovered.dinosaur and session.discovered.duck and not session.discovered.frog)
	local weaker = hatch(session, "turtle", 0, 0.75)
	assert(weaker.animalId == "frog" and weaker.replacedId == nil and not weaker.kept)
	assert(session.discovered.frog and #session.animals == 8 and session:snapshot().income == 125)
	local equal = hatch(session, "turtle", 0, 0)
	assert(not equal.kept and equal.replacedId == nil)
	assert(session:freeSlot() == 1 and session.cash == 25 and session:snapshot().income == 125)
end)

test("passive earnings use owned animal income and the exact whole elapsed seconds", function()
	local session = fresh()
	session:earn(60)
	assert(session.cash == 25)
	hatch(session, "turtle", 0, 0)
	session:earn(0)
	assert(session.cash == 25)
	session:earn(3)
	assert(session.cash == 40)
	hatch(session, "turtle", 0, 0.75)
	session:earn(11)
	assert(session.cash == 139 and session:snapshot().income == 9)
	assert(session:upgrade())
	assert(session.cash == 89)
	session:earn(1)
	assert(session.cash == 98)
end)

test("crossing a boundary secures the carried egg without depositing or rewarding it", function()
	local session = fresh()
	assert(not session.escaped and not session:snapshot().escaped)
	assert(not session:markEscaped("turtle"))
	assert(session:steal("turtle"))
	assert(not session:markEscaped("rabbit"))
	assert(not session.escaped and session.carrying == "turtle")
	assert(session:markEscaped("turtle"))
	assert(session.escaped and session:snapshot().escaped and session.carrying == "turtle")
	assert(session.cash == 25 and #session.animals == 0 and next(session.hatches) == nil)
	assert(not session:markEscaped("turtle"), "Reentry cannot certify the same egg twice")
	assert(not session:steal("turtle"), "A secured egg still occupies the carrying slot")
	assert(session:deposit(100).readyAt == 110)
	assert(not session.escaped and not session:snapshot().escaped and session.carrying == nil)
	assert(session:steal("turtle"))
	assert(not session.escaped, "The next egg must start a fresh chase")
end)

test("losing an escaped egg clears only its carry state", function()
	local session = fresh()
	hatch(session, "turtle", 0, 0)
	session:earn(10)
	assert(session:steal("turtle"))
	assert(session:markEscaped("turtle"))
	assert(session:loseCarry() == "turtle")
	assert(not session.escaped and session.carrying == nil)
	assert(session.cash == 75 and #session.animals == 1 and session.discovered.duck)
	assert(session:loseCarry() == nil and not session.escaped)
end)

test("invalid elapsed times cannot grant cash or corrupt the balance", function()
	local session = fresh()
	hatch(session, "turtle", 0, 0)
	for _, seconds in { -1, 0.5, math.huge, -math.huge, 0 / 0 } do
		assert(not pcall(function()
			session:earn(seconds)
		end))
		assert(session.cash == 25)
	end
end)

test("death or a guardian catch only loses the carried egg and is safe to repeat", function()
	local session = fresh()
	hatch(session, "turtle", 0, 0)
	session:earn(3)
	assert(session:steal("turtle"))
	local pending = session:deposit(100)
	assert(session:steal("turtle"))
	assert(session:loseCarry() == "turtle" and session.carrying == nil)
	assert(session:loseCarry() == nil)
	assert(session.cash == 40 and #session.animals == 1 and session.animals[1].id == "duck")
	assert(session.discovered.duck and session.hatches[1] == pending)
	assert(session:deposit(105) == nil)
	assert(session:finishHatch(1, 110, 0, 0).animalId == "duck")
	assert(#session.animals == 2 and session.cash == 40)
	assert(session:steal("turtle"))
end)

test("a failed reward roll leaves a ready hatch available for a valid retry", function()
	local session = fresh()
	assert(session:steal("turtle"))
	local pending = session:deposit(100)
	assert(not pcall(function()
		session:finishHatch(1, 110, 1, 0)
	end))
	assert(session.hatches[1] == pending and #session.animals == 0)
	assert(next(session.discovered) == nil)
	assert(session:finishHatch(1, 110, 0, 0).animalId == "duck")
	assert(session:finishHatch(1, 110, 0, 0) == nil and #session.animals == 1)
end)

test("snapshots are detached from all mutable session collections", function()
	local session = fresh(3)
	hatch(session, "turtle", 0, 0)
	assert(session:steal("turtle"))
	session:deposit(100)
	assert(session:steal("turtle"))
	local snapshot = session:snapshot()
	assert(snapshot.baseId == 3 and snapshot.carrying == "turtle" and snapshot.sessionOnly)
	assert(snapshot.animals ~= session.animals and snapshot.animals[1] ~= session.animals[1])
	assert(snapshot.hatches ~= session.hatches and snapshot.hatches[1] ~= session.hatches[1])
	assert(snapshot.discovered ~= session.discovered)
	snapshot.cash = 99999
	snapshot.animals[1].id = "dinosaur"
	table.insert(snapshot.animals, { id = "rabbit" })
	snapshot.hatches[1].readyAt = 0
	snapshot.hatches[1].zoneId = "rabbit"
	table.clear(snapshot.discovered)
	snapshot.carrying = nil
	assert(session.cash == 25 and session.carrying == "turtle")
	assert(#session.animals == 1 and session.animals[1].id == "duck")
	assert(session.hatches[1].readyAt == 110 and session.hatches[1].zoneId == "turtle")
	assert(session.discovered.duck)
	local previous = session:snapshot()
	session:earn(2)
	session:finishHatch(1, 110, 0, 0.75)
	assert(previous.cash == 25 and #previous.animals == 1 and #previous.hatches == 1)
	assert(previous.discovered.frog == nil and session.discovered.frog)
end)

print(string.format("%d session tests passed", passed))
