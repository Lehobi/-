        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">AnimalFactory</string>
            <string name="Source"><![CDATA[-- Original, asset-free toy animals. Models face local -Z and stand at local Y = 0.
local AnimalFactory = {}

local WHITE = Color3.fromRGB(255, 252, 237)
local INK = Color3.fromRGB(32, 36, 57)
local PINK = Color3.fromRGB(255, 141, 172)
local ORANGE = Color3.fromRGB(255, 175, 68)

local function colorFrom(value)
	if typeof(value) == "Color3" then
		return value
	end
	value = value or {}
	return Color3.fromRGB(value.r or value[1] or 140, value.g or value[2] or 210, value.b or value[3] or 140)
end

local function piece(model, name, size, position, color, shape, rotation)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
	part.Color = color
	part.Shape = shape or Enum.PartType.Ball
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function newModel(name)
	local model = Instance.new("Model")
	model.Name = name
	local root = piece(model, "Root", Vector3.new(0.2, 0.2, 0.2), Vector3.zero, WHITE)
	root.Transparency = 1
	root.CastShadow = false
	model.PrimaryPart = root
	return model
end

local function eyes(model, y, z, spacing, scale)
	scale = scale or 1
	for _, side in ipairs({ -1, 1 }) do
		local x = side * spacing
		piece(model, "Eye", Vector3.new(0.43, 0.49, 0.32) * scale, Vector3.new(x, y, z), WHITE)
		piece(
			model,
			"Pupil",
			Vector3.new(0.2, 0.28, 0.13) * scale,
			Vector3.new(x + 0.045 * scale, y - 0.01, z - 0.16 * scale),
			INK
		)
		piece(
			model,
			"EyeShine",
			Vector3.new(0.07, 0.09, 0.05) * scale,
			Vector3.new(x + 0.01, y + 0.055 * scale, z - 0.23 * scale),
			WHITE
		)
	end
end

local function feet(model, color, x, z, size)
	for _, side in ipairs({ -1, 1 }) do
		piece(model, "Foot", size or Vector3.new(0.7, 0.35, 0.85), Vector3.new(side * x, 0.19, z), color)
	end
end

local function cheeks(model, x, y, z)
	for _, side in ipairs({ -1, 1 }) do
		piece(model, "Cheek", Vector3.new(0.28, 0.15, 0.09), Vector3.new(side * x, y, z), PINK)
	end
end

local builders = {}

function builders.turtle(model, color)
	piece(model, "Shell", Vector3.new(2.5, 1.35, 2.65), Vector3.new(0, 0.95, 0.25), color)
	piece(
		model,
		"ShellCrown",
		Vector3.new(1.35, 0.35, 1.5),
		Vector3.new(0, 1.59, 0.25),
		color:Lerp(WHITE, 0.3)
	)
	piece(
		model,
		"ShellBelly",
		Vector3.new(2.25, 0.4, 2.3),
		Vector3.new(0, 0.48, 0.25),
		Color3.fromRGB(245, 219, 142)
	)
	local skin = color:Lerp(Color3.fromRGB(154, 231, 120), 0.6)
	piece(model, "Head", Vector3.new(1.4, 1.05, 1.2), Vector3.new(0, 0.92, -1.12), skin)
	feet(model, skin, 0.97, -0.57, Vector3.new(0.65, 0.45, 0.8))
	feet(model, skin, 0.97, 1.04, Vector3.new(0.65, 0.45, 0.8))
	piece(model, "Tail", Vector3.new(0.38, 0.32, 0.7), Vector3.new(0, 0.5, 1.64), skin)
	eyes(model, 1.13, -1.6, 0.36, 0.82)
	cheeks(model, 0.5, 0.8, -1.57)
	piece(model, "Smile", Vector3.new(0.33, 0.08, 0.09), Vector3.new(0, 0.75, -1.71), INK)
end

function builders.rabbit(model, color)
	piece(model, "Body", Vector3.new(1.8, 1.75, 1.45), Vector3.new(0, 1.02, 0.16), color)
	piece(model, "Belly", Vector3.new(1.05, 1.17, 0.28), Vector3.new(0, 0.94, -0.53), WHITE)
	piece(model, "Head", Vector3.new(1.8, 1.5, 1.5), Vector3.new(0, 1.99, -0.22), color)
	for _, side in ipairs({ -1, 1 }) do
		local tilt = CFrame.Angles(0, 0, math.rad(side * -12))
		piece(
			model,
			"Ear",
			Vector3.new(0.56, 1.58, 0.44),
			Vector3.new(side * 0.47, 3.08, -0.12),
			color,
			nil,
			tilt
		)
		piece(
			model,
			"InnerEar",
			Vector3.new(0.28, 1.12, 0.12),
			Vector3.new(side * 0.47, 3.1, -0.35),
			PINK,
			nil,
			tilt
		)
	end
	feet(model, color, 0.57, -0.45, Vector3.new(0.73, 0.38, 1))
	piece(model, "CottonTail", Vector3.new(0.7, 0.7, 0.7), Vector3.new(0, 0.94, 0.9), WHITE)
	eyes(model, 2.13, -0.91, 0.44, 0.84)
	piece(model, "Nose", Vector3.new(0.27, 0.2, 0.17), Vector3.new(0, 1.83, -1), PINK)
	piece(
		model,
		"GoofyTooth",
		Vector3.new(0.2, 0.22, 0.1),
		Vector3.new(0.06, 1.61, -0.95),
		WHITE,
		Enum.PartType.Block
	)
end

function builders.duck(model, color)
	piece(model, "Body", Vector3.new(2.1, 1.8, 1.85), Vector3.new(0, 1.07, 0.2), color)
	piece(model, "Head", Vector3.new(1.57, 1.47, 1.47), Vector3.new(0, 2.04, -0.28), color)
	for _, side in ipairs({ -1, 1 }) do
		piece(
			model,
			"Wing",
			Vector3.new(0.5, 1.1, 1.22),
			Vector3.new(side * 0.98, 1.1, 0.23),
			color:Lerp(WHITE, 0.18)
		)
	end
	piece(model, "Beak", Vector3.new(1.06, 0.34, 0.92), Vector3.new(0, 1.83, -1.02), ORANGE)
	feet(model, ORANGE, 0.51, -0.26, Vector3.new(0.75, 0.3, 0.95))
	eyes(model, 2.26, -0.92, 0.39, 0.83)
	piece(
		model,
		"HeadTuft",
		Vector3.new(0.35, 0.65, 0.42),
		Vector3.new(0.04, 2.88, -0.1),
		color,
		nil,
		CFrame.Angles(0, 0, math.rad(-22))
	)
end

function builders.frog(model, color)
	piece(model, "Body", Vector3.new(2, 1.6, 1.65), Vector3.new(0, 0.94, 0.1), color)
	piece(model, "Belly", Vector3.new(1.3, 0.98, 0.3), Vector3.new(0, 0.78, -0.67), color:Lerp(WHITE, 0.7))
	piece(model, "Head", Vector3.new(2.32, 1.24, 1.55), Vector3.new(0, 1.66, -0.15), color)
	for _, side in ipairs({ -1, 1 }) do
		piece(model, "EyeBump", Vector3.new(0.89, 0.94, 0.82), Vector3.new(side * 0.65, 2.11, -0.34), color)
	end
	eyes(model, 2.13, -0.73, 0.65, 1.15)
	feet(model, color, 0.89, -0.38, Vector3.new(1, 0.35, 1.06))
	piece(model, "Smile", Vector3.new(0.75, 0.09, 0.1), Vector3.new(0, 1.45, -0.93), INK)
	piece(model, "Tongue", Vector3.new(0.28, 0.22, 0.11), Vector3.new(0.22, 1.34, -0.94), PINK)
	cheeks(model, 0.91, 1.55, -0.78)
end

function builders.cat(model, color)
	piece(model, "Body", Vector3.new(1.73, 1.67, 1.5), Vector3.new(0, 1.03, 0.18), color)
	piece(model, "Head", Vector3.new(2, 1.6, 1.48), Vector3.new(0, 2.04, -0.15), color)
	for _, side in ipairs({ -1, 1 }) do
		piece(
			model,
			"Ear",
			Vector3.new(0.65, 0.98, 0.55),
			Vector3.new(side * 0.65, 2.85, -0.04),
			color,
			nil,
			CFrame.Angles(0, 0, math.rad(side * -24))
		)
		piece(model, "InnerEar", Vector3.new(0.31, 0.5, 0.12), Vector3.new(side * 0.65, 2.92, -0.3), PINK)
	end
	piece(model, "Muzzle", Vector3.new(0.9, 0.49, 0.32), Vector3.new(0, 1.75, -0.82), WHITE)
	piece(model, "Nose", Vector3.new(0.25, 0.18, 0.16), Vector3.new(0, 1.88, -1), PINK)
	feet(model, WHITE, 0.48, -0.34)
	piece(
		model,
		"Tail",
		Vector3.new(0.42, 1.78, 0.48),
		Vector3.new(0.78, 1.14, 0.99),
		color,
		nil,
		CFrame.Angles(0, 0, math.rad(-29))
	)
	eyes(model, 2.19, -0.82, 0.47, 0.83)
end

function builders.penguin(model, color)
	piece(model, "Body", Vector3.new(1.85, 2.3, 1.75), Vector3.new(0, 1.42, 0.1), color)
	piece(model, "Belly", Vector3.new(1.34, 1.85, 0.4), Vector3.new(0, 1.28, -0.66), WHITE)
	piece(model, "Head", Vector3.new(1.7, 1.45, 1.56), Vector3.new(0, 2.39, -0.06), color)
	for _, side in ipairs({ -1, 1 }) do
		piece(
			model,
			"Flipper",
			Vector3.new(0.37, 1.56, 0.78),
			Vector3.new(side * 0.99, 1.38, 0.09),
			color,
			nil,
			CFrame.Angles(0, 0, math.rad(side * 23))
		)
	end
	feet(model, ORANGE, 0.48, -0.42, Vector3.new(0.74, 0.31, 0.95))
	eyes(model, 2.54, -0.78, 0.4, 0.86)
	piece(model, "Beak", Vector3.new(0.61, 0.34, 0.5), Vector3.new(0, 2.22, -0.91), ORANGE)
	cheeks(model, 0.61, 2.22, -0.76)
end

function builders.dinosaur(model, color)
	piece(model, "Body", Vector3.new(1.83, 1.95, 1.75), Vector3.new(0, 1.22, 0.17), color)
	piece(model, "Belly", Vector3.new(1.15, 1.35, 0.32), Vector3.new(0, 1.1, -0.66), color:Lerp(WHITE, 0.58))
	piece(model, "Head", Vector3.new(1.94, 1.5, 1.65), Vector3.new(0, 2.39, -0.16), color)
	piece(model, "Snout", Vector3.new(1.76, 0.87, 1.15), Vector3.new(0, 2.14, -0.9), color)
	for _, side in ipairs({ -1, 1 }) do
		piece(model, "TinyArm", Vector3.new(0.4, 0.65, 0.55), Vector3.new(side * 0.93, 1.43, -0.35), color)
		piece(model, "Nostril", Vector3.new(0.12, 0.12, 0.08), Vector3.new(side * 0.4, 2.34, -1.43), INK)
	end
	feet(model, color, 0.6, -0.31, Vector3.new(0.81, 0.45, 1.13))
	piece(model, "Tail", Vector3.new(0.76, 0.76, 1.71), Vector3.new(0, 0.74, 1.48), color)
	piece(model, "BackSpike", Vector3.new(0.62, 0.75, 0.43), Vector3.new(0, 2.4, 0.64), ORANGE)
	piece(model, "TailSpike", Vector3.new(0.5, 0.5, 0.4), Vector3.new(0, 1.25, 1.34), ORANGE)
	eyes(model, 2.68, -0.81, 0.52, 0.86)
	piece(
		model,
		"GoofyTooth",
		Vector3.new(0.22, 0.26, 0.12),
		Vector3.new(0.42, 1.76, -1.32),
		WHITE,
		Enum.PartType.Block
	)
end

function AnimalFactory.create(species, color, name)
	local model = newModel(name or species)
	model:SetAttribute("Species", species)
	model:SetAttribute("VisualRole", "Animal")
	local builder = builders[species] or builders.frog
	builder(model, colorFrom(color))
	return model
end

function AnimalFactory.egg(color, name)
	local model = newModel(name or "GoofyEgg")
	local tint = colorFrom(color)
	piece(model, "Shell", Vector3.new(2.3, 3, 2.3), Vector3.zero, tint:Lerp(WHITE, 0.65))
	piece(model, "Spot", Vector3.new(0.66, 0.82, 0.13), Vector3.new(-0.45, 0.18, -1.01), tint)
	piece(model, "Spot", Vector3.new(0.46, 0.5, 0.13), Vector3.new(0.57, -0.47, -0.93), tint)
	piece(model, "Spot", Vector3.new(0.41, 0.54, 0.13), Vector3.new(0.39, 0.88, -0.8), tint)
	piece(model, "Spot", Vector3.new(0.13, 0.68, 0.56), Vector3.new(1.02, -0.25, 0.35), tint)
	model:SetAttribute("VisualRole", "Egg")
	return model
end

return AnimalFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[--!strict
-- Shared gameplay numbers. Keep this module free of Roblox-only APIs so the
-- economy can also be exercised with the standalone Luau test runner.

export type RGB = { r: number, g: number, b: number }
export type AnimalDefinition = {
	id: string,
	name: string,
	rarity: string,
	income: number,
	species: string,
	color: RGB,
	personality: string,
}
export type ZoneDefinition = {
	id: string,
	name: string,
	guardian: string,
	position: { x: number, z: number },
	guardianOffset: number,
	guardianSpeed: number,
	requiredLevel: number,
	hatchSeconds: number,
	cooldownSeconds: number,
	color: RGB,
	weights: { [string]: number },
}

local Config = {
	startCash = 25,
	hatchSlots = 3,
	maxAnimals = 8,
	speed = {
		base = 16,
		perLevel = 2,
		maxLevel = 12,
		baseCost = 25,
		costGrowth = 1.55,
	},
	basePositions = {
		{ x = -80, z = -25 },
		{ x = 80, z = -25 },
		{ x = -80, z = -110 },
		{ x = 80, z = -110 },
		{ x = 0, z = -195 },
	},
	rarities = {
		Common = { order = 1, color = { r = 205, g = 218, b = 221 } },
		Uncommon = { order = 2, color = { r = 133, g = 225, b = 133 } },
		Rare = { order = 3, color = { r = 96, g = 182, b = 255 } },
		Epic = { order = 4, color = { r = 195, g = 126, b = 255 } },
		Legendary = { order = 5, color = { r = 255, g = 195, b = 73 } },
		Mythic = { order = 6, color = { r = 255, g = 110, b = 156 } },
		Secret = { order = 7, color = { r = 114, g = 255, b = 225 } },
	} :: { [string]: { order: number, color: RGB } },
	animals = {
		frog = {
			id = "frog",
			name = "Wobble Frog",
			rarity = "Common",
			income = 4,
			species = "frog",
			color = { r = 144, g = 215, b = 116 },
			personality = "Bounces before thinking.",
		},
		duck = {
			id = "duck",
			name = "Disco Duck",
			rarity = "Common",
			income = 5,
			species = "duck",
			color = { r = 255, g = 218, b = 102 },
			personality = "Every waddle is a dance move.",
		},
		turtle = {
			id = "turtle",
			name = "Turbo Turtle",
			rarity = "Uncommon",
			income = 10,
			species = "turtle",
			color = { r = 111, g = 186, b = 136 },
			personality = "Thinks slow and dreams fast.",
		},
		cat = {
			id = "cat",
			name = "Noodle Cat",
			rarity = "Uncommon",
			income = 12,
			species = "cat",
			color = { r = 246, g = 174, b = 128 },
			personality = "Has no idea how its legs work.",
		},
		penguin = {
			id = "penguin",
			name = "Puddle Penguin",
			rarity = "Rare",
			income = 28,
			species = "penguin",
			color = { r = 116, g = 150, b = 187 },
			personality = "Slides into every conversation.",
		},
		rabbit = {
			id = "rabbit",
			name = "Rocket Rabbit",
			rarity = "Rare",
			income = 32,
			species = "rabbit",
			color = { r = 231, g = 185, b = 220 },
			personality = "Hops first, asks questions later.",
		},
		dinosaur = {
			id = "dinosaur",
			name = "Dizzy Dino",
			rarity = "Epic",
			income = 90,
			species = "dinosaur",
			color = { r = 165, g = 159, b = 234 },
			personality = "Tiny arms. Enormous confidence.",
		},
	} :: { [string]: AnimalDefinition },
	zones = {
		{
			id = "turtle",
			name = "Turtle Meadow",
			guardian = "turtle",
			position = { x = 0, z = 140 },
			guardianOffset = 20,
			guardianSpeed = 12,
			requiredLevel = 0,
			hatchSeconds = 10,
			cooldownSeconds = 8,
			color = { r = 132, g = 203, b = 150 },
			weights = {
				Common = 78,
				Uncommon = 20,
				Rare = 2,
				Epic = 0,
				Legendary = 0,
				Mythic = 0,
				Secret = 0,
			},
		},
		{
			id = "rabbit",
			name = "Rabbit Ridge",
			guardian = "rabbit",
			position = { x = 0, z = 310 },
			guardianOffset = 20,
			guardianSpeed = 22,
			requiredLevel = 4,
			hatchSeconds = 18,
			cooldownSeconds = 10,
			color = { r = 223, g = 181, b = 217 },
			weights = {
				Common = 52,
				Uncommon = 32,
				Rare = 14,
				Epic = 2,
				Legendary = 0,
				Mythic = 0,
				Secret = 0,
			},
		},
	} :: { ZoneDefinition },
}

return Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
local Config = if script then require(script.Parent.Config) else require("./Config")

export type OwnedAnimal = { id: string }

local Economy = {}

local function finite(value: number): boolean
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function positiveInteger(value: number): boolean
	return finite(value) and value > 0 and value % 1 == 0
end

local function checkLevel(level: number)
	assert(
		finite(level) and level % 1 == 0 and level >= 0 and level <= Config.speed.maxLevel,
		"Invalid speed level"
	)
end

local function checkRoll(roll: number)
	assert(finite(roll) and roll >= 0 and roll < 1, "Roll must be a finite number in [0, 1)")
end

local function getAnimal(animalId: string)
	local animal = Config.animals[animalId]
	assert(animal ~= nil, "Unknown animal: " .. tostring(animalId))
	return animal
end

local function orderedRarities(): { string }
	local result = {}
	for name in Config.rarities do
		table.insert(result, name)
	end
	table.sort(result, function(a, b)
		return Config.rarities[a].order < Config.rarities[b].order
	end)
	return result
end

function Economy.walkSpeed(level: number): number
	checkLevel(level)
	return Config.speed.base + Config.speed.perLevel * level
end

function Economy.upgradeCost(level: number): number?
	checkLevel(level)
	if level == Config.speed.maxLevel then
		return nil
	end
	return math.floor(Config.speed.baseCost * Config.speed.costGrowth ^ level)
end

function Economy.getZone(zoneId: string): typeof(Config.zones[1])?
	for _, zone in Config.zones do
		if zone.id == zoneId then
			return zone
		end
	end
	return nil
end

function Economy.rollAnimal(zoneId: string, rarityRoll: number, animalRoll: number): string
	checkRoll(rarityRoll)
	checkRoll(animalRoll)
	local zone = Economy.getZone(zoneId)
	assert(zone ~= nil, "Unknown zone: " .. tostring(zoneId))
	local threshold = rarityRoll * 100
	local cumulative = 0
	local selectedRarity: string? = nil
	for _, rarity in orderedRarities() do
		local weight = zone.weights[rarity] or 0
		cumulative += weight
		if weight > 0 and threshold < cumulative then
			selectedRarity = rarity
			break
		end
	end
	assert(selectedRarity ~= nil, "Zone rarity weights do not cover this roll")
	local candidates = {}
	for id, animal in Config.animals do
		if animal.rarity == selectedRarity then
			table.insert(candidates, id)
		end
	end
	table.sort(candidates)
	assert(#candidates > 0, "Selected rarity has no animals")
	return candidates[math.floor(animalRoll * #candidates) + 1]
end

function Economy.income(animals: { OwnedAnimal }): number
	local total = 0
	for _, owned in animals do
		total += getAnimal(owned.id).income
	end
	return total
end

function Economy.addAnimal(animals: { OwnedAnimal }, animalId: string): ({ OwnedAnimal }, string?, boolean)
	local incoming = getAnimal(animalId)
	assert(#animals <= Config.maxAnimals, "Animal capacity already exceeded")
	local result = table.clone(animals)
	local weakestIndex = 1
	local weakestIncome = math.huge
	for index, owned in animals do
		local value = getAnimal(owned.id).income
		if value < weakestIncome then
			weakestIndex = index
			weakestIncome = value
		end
	end
	if #result < Config.maxAnimals then
		table.insert(result, { id = animalId })
		return result, nil, true
	end
	if incoming.income > weakestIncome then
		local replacedId = result[weakestIndex].id
		result[weakestIndex] = { id = animalId }
		return result, replacedId, true
	end
	return result, nil, false
end

function Economy.validateConfig(): boolean
	assert(finite(Config.startCash) and Config.startCash >= 0, "Starting cash must be nonnegative")
	assert(positiveInteger(Config.hatchSlots), "Hatch slots must be a positive integer")
	assert(positiveInteger(Config.maxAnimals), "Animal capacity must be a positive integer")
	assert(Config.hatchSlots <= Config.maxAnimals, "Hatch slots exceed animal capacity")
	assert(#Config.basePositions >= 1, "At least one base is required")
	local positions = {}
	for _, position in Config.basePositions do
		assert(finite(position.x) and finite(position.z), "Base coordinates must be finite")
		local key = tostring(position.x) .. ":" .. tostring(position.z)
		assert(not positions[key], "Duplicate base position")
		positions[key] = true
	end
	assert(finite(Config.speed.base) and Config.speed.base > 0, "Base speed must be positive")
	assert(finite(Config.speed.perLevel) and Config.speed.perLevel > 0, "Speed increase must be positive")
	assert(positiveInteger(Config.speed.maxLevel), "Maximum speed level must be a positive integer")
	assert(positiveInteger(Config.speed.baseCost), "Base upgrade cost must be a positive integer")
	assert(finite(Config.speed.costGrowth) and Config.speed.costGrowth > 1, "Upgrade costs must grow")
	assert(
		finite(Config.speed.baseCost * Config.speed.costGrowth ^ Config.speed.maxLevel),
		"Upgrade cost overflow"
	)

	local orders = {}
	local population: { [string]: number } = {}
	for rarity, definition in Config.rarities do
		assert(
			positiveInteger(definition.order) and not orders[definition.order],
			"Rarity orders must be unique"
		)
		orders[definition.order] = true
		population[rarity] = 0
	end
	for id, animal in Config.animals do
		assert(id == animal.id, "Animal key and ID must match")
		assert(population[animal.rarity] ~= nil, "Unknown animal rarity")
		assert(finite(animal.income) and animal.income > 0, "Animal income must be positive")
		population[animal.rarity] += 1
	end
	assert(#Config.zones > 0, "At least one zone is required")
	local zoneIds = {}
	for _, zone in Config.zones do
		assert(zone.id ~= "" and not zoneIds[zone.id], "Zone IDs must be nonempty and unique")
		zoneIds[zone.id] = true
		assert(finite(zone.position.x) and finite(zone.position.z), "Zone coordinates must be finite")
		assert(finite(zone.guardianOffset) and zone.guardianOffset > 0, "Guardian offset must be positive")
		assert(finite(zone.guardianSpeed) and zone.guardianSpeed > 0, "Guardian speed must be positive")
		checkLevel(zone.requiredLevel)
		assert(finite(zone.hatchSeconds) and zone.hatchSeconds > 0, "Hatch time must be positive")
		assert(finite(zone.cooldownSeconds) and zone.cooldownSeconds >= 0, "Cooldown must be nonnegative")
		local total = 0
		for rarity, weight in zone.weights do
			assert(population[rarity] ~= nil, "Zone has an unknown rarity")
			assert(finite(weight) and weight >= 0, "Rarity weights must be finite and nonnegative")
			assert(weight == 0 or population[rarity] > 0, "Positive rarity weight has no animals")
			total += weight
		end
		assert(math.abs(total - 100) < 1e-9, "Zone rarity weights must sum to 100")
	end
	return true
end

return Economy
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">GoofyEgg</string>
      </Properties>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- All rewards, balances, egg ownership, upgrades, and chase decisions live on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local shared = ReplicatedStorage:WaitForChild("GoofyEgg"):WaitForChild("Shared")
local remotes = ReplicatedStorage.GoofyEgg.Remotes
local Config = require(shared.Config)
local Economy = require(shared.Economy)
local AnimalFactory = require(shared.AnimalFactory)
local Session = require(script.Parent.Session)
local World = require(script.Parent.World)

Economy.validateConfig()
local world = World.build(Config)
local rng = Random.new()
local sessions = {}
local owners = {}
local guardians = {}
local connections = {}
local lastAction = {}
local lastRead = {}
local motion = {}
local characterConnections = {}
local carryModels = {}
local shuttingDown = false
local checkMotion

local function clock()
	return Workspace:GetServerTimeNow()
end

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function notice(player, text, kind)
	remotes.Notice:FireClient(player, { text = text, kind = kind or "info" })
end

local function body(player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function near(player, position, distance)
	if checkMotion and not checkMotion(player, clock()) then
		return false
	end
	local root = body(player)
	return root ~= nil and (root.Position - position).Magnitude <= distance
end

local function send(player)
	local session = sessions[player]
	if not session then
		return
	end
	local snapshot = session:snapshot()
	local leaderboard = player:FindFirstChild("leaderstats")
	if leaderboard then
		leaderboard.Cash.Value = math.floor(snapshot.cash)
		leaderboard.Speed.Value = snapshot.speedLevel
	end
	remotes.State:FireClient(player, snapshot)
end

local function clearCarry(player)
	local model = carryModels[player]
	if model then
		model:Destroy()
		carryModels[player] = nil
	end
end

local function showCarry(player, zone)
	clearCarry(player)
	local root = body(player)
	if not root then
		return
	end
	local model = AnimalFactory.egg(zone.color, "CarriedEgg")
	model:PivotTo(root.CFrame * CFrame.new(0, 1, -2.8))
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.Massless = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
	end
	model.Parent = player.Character
	carryModels[player] = model
end

local function endChase(player)
	for _, guardian in guardians do
		if guardian.target == player then
			guardian.target = nil
			guardian.state = "Returning"
			guardian.world.guardian:SetAttribute("Chasing", false)
		end
	end
end

local function resetMotion(player)
	local root = body(player)
	motion[player] = if root then { position = root.Position, time = clock(), credit = 8 } else nil
end

local function returnHome(player)
	local session = sessions[player]
	local root = body(player)
	if session and root then
		player.Character:PivotTo(world.bases[session.baseId].spawn)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		resetMotion(player)
	end
end

local function loseEgg(player, message, teleport)
	local session = sessions[player]
	if not session then
		return
	end
	local hadEgg = session:loseCarry() ~= nil
	clearCarry(player)
	endChase(player)
	if teleport then
		returnHome(player)
	end
	if message and hadEgg then
		notice(player, message, "warning")
	end
	send(player)
end

local function deposit(player)
	local session = sessions[player]
	if not session or not session.carrying then
		return
	end
	local base = world.bases[session.baseId]
	if not near(player, base.depositPrompt.Parent.Position, 14) then
		return
	end
	local hatch = session:deposit(clock())
	if not hatch then
		notice(player, "All hatch slots are busy!", "warning")
		return
	end
	clearCarry(player)
	endChase(player)
	world:showHatch(session.baseId, hatch.slot, hatch.zoneId, hatch.readyAt)
	notice(player, "Safe at home! Your egg is hatching.", "success")
	send(player)
end

local function upgrade(player)
	local session = sessions[player]
	if not session or not body(player) then
		return
	end
	local ok, reason = session:upgrade()
	if ok then
		local _, humanoid = body(player)
		humanoid.WalkSpeed = Economy.walkSpeed(session.speedLevel)
		notice(player, "Speed level " .. session.speedLevel .. "!", "success")
	else
		notice(player, reason, "warning")
	end
	send(player)
end

local function permitted(player)
	local now = clock()
	if now - (lastAction[player] or -math.huge) < 0.25 then
		return false
	end
	lastAction[player] = now
	return sessions[player] ~= nil
end

for _, zone in Config.zones do
	local zoneWorld = world.zones[zone.id]
	local guardian = { world = zoneWorld, state = "Idle", target = nil, readyAt = 0, startedAt = 0 }
	guardians[zone.id] = guardian
	connect(zoneWorld.prompt.Triggered, function(player)
		if not permitted(player) or guardian.state ~= "Idle" then
			return
		end
		-- Triggered can be forged by exploit clients; check actual alive character and egg distance.
		if not near(player, zoneWorld.egg:GetPivot().Position, 13) then
			return
		end
		local session = sessions[player]
		local ok, reason = session:steal(zone.id)
		if not ok then
			notice(player, reason, "warning")
			return
		end
		guardian.state = "Chasing"
		guardian.target = player
		guardian.startedAt = clock()
		guardian.world.guardian:SetAttribute("Chasing", true)
		world:setEggAvailable(zone.id, false)
		showCarry(player, zone)
		notice(
			player,
			"The " .. zone.guardian .. " woke up! Run to base " .. session.baseId .. "!",
			"warning"
		)
		send(player)
	end)
end

for _, base in world.bases do
	connect(base.depositPrompt.Triggered, function(player)
		local session = sessions[player]
		if session and session.baseId == base.id and permitted(player) then
			deposit(player)
		end
	end)
	connect(base.upgradePrompt.Triggered, function(player)
		local session = sessions[player]
		if
			session
			and session.baseId == base.id
			and permitted(player)
			and near(player, base.upgradePrompt.Parent.Position, 13)
		then
			upgrade(player)
		end
	end)
end

connect(remotes.Action.OnServerEvent, function(player, action, ...)
	-- Only fixed intents cross this boundary. Never accept prices, results, level, or target users.
	if typeof(action) ~= "string" or select("#", ...) ~= 0 or not permitted(player) then
		return
	end
	if action == "UpgradeSpeed" then
		upgrade(player)
	elseif action == "DepositEgg" then
		deposit(player)
	end
end)

remotes.GetState.OnServerInvoke = function(player, ...)
	if select("#", ...) ~= 0 then
		return nil
	end
	local now = clock()
	if now - (lastRead[player] or -math.huge) < 0.5 then
		return nil
	end
	lastRead[player] = now
	return if sessions[player] then sessions[player]:snapshot() else nil
end

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or not sessions[player] or character ~= player.Character then
		return
	end
	if characterConnections[player] then
		characterConnections[player]:Disconnect()
	end
	humanoid.WalkSpeed = Economy.walkSpeed(sessions[player].speedLevel)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 40
	returnHome(player)
	characterConnections[player] = humanoid.Died:Connect(function()
		loseEgg(player, "Oops! Your egg was lost. Your animals are safe.", false)
	end)
	send(player)
end

local function addPlayer(player)
	if sessions[player] or shuttingDown then
		return
	end
	local baseId
	for id = 1, #world.bases do
		if not owners[id] then
			baseId = id
			break
		end
	end
	if not baseId then
		player:Kick("All five bases are occupied. Please join another server.")
		return
	end
	owners[baseId] = player
	sessions[player] = Session.new(baseId, Config, Economy)
	world:setBaseOwner(baseId, player)
	local leaderboard = Instance.new("Folder")
	leaderboard.Name = "leaderstats"
	for _, name in { "Cash", "Speed" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = leaderboard
	end
	leaderboard.Parent = player
	-- Keep per-player connections separate so leaving players are not retained by closures.
	local added = player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	local removing = player.CharacterRemoving:Connect(function()
		loseEgg(player, nil, false)
		motion[player] = nil
	end)
	sessions[player].connections = { added, removing }
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

local function removePlayer(player)
	lastAction[player] = nil
	lastRead[player] = nil
	local session = sessions[player]
	if not session then
		return
	end
	clearCarry(player)
	endChase(player)
	for _, connection in session.connections do
		connection:Disconnect()
	end
	if characterConnections[player] then
		characterConnections[player]:Disconnect()
	end
	world:setBaseOwner(session.baseId, nil)
	owners[session.baseId] = nil
	sessions[player] = nil
	lastAction[player] = nil
	lastRead[player] = nil
	motion[player] = nil
	characterConnections[player] = nil
end

-- Conservative displacement budget: limits obvious teleports/speed edits during egg runs.
-- This supplements server distance/ownership checks; Studio latency testing is still required.
checkMotion = function(player, now)
	local root, humanoid = body(player)
	local session = sessions[player]
	if not root or not session then
		return false
	end
	local speed = Economy.walkSpeed(session.speedLevel)
	humanoid.WalkSpeed = speed
	local previous = motion[player]
	if not previous then
		resetMotion(player)
		return true
	end
	local elapsed = now - previous.time
	local distance = flatDistance(root.Position, previous.position)
	local available = previous.credit + speed * 1.2 * elapsed
	local invalid = distance ~= distance
		or distance == math.huge
		or distance > available
		or root.Position.Y > 40
		or root.Position.Y < -20
	if invalid then
		loseEgg(player, "Your egg run reset after unexpected movement. Your animals are safe.", true)
		return false
	else
		previous.credit = math.min(8, available - distance)
		previous.position = root.Position
		previous.time = now
	end
	return true
end

local function moveGuardian(guardian, targetPosition, speed, dt, now)
	local model = guardian.world.guardian
	local from = model:GetPivot().Position
	local destination = Vector3.new(targetPosition.X, guardian.world.home.Position.Y, targetPosition.Z)
	local delta = destination - Vector3.new(from.X, destination.Y, from.Z)
	local distance = delta.Magnitude
	if distance > 0.05 then
		local position = Vector3.new(from.X, destination.Y, from.Z)
			+ delta.Unit * math.min(distance, speed * dt)
		-- Tiny procedural bounce makes the original part animal waddle without physics overhead.
		position += Vector3.new(0, math.abs(math.sin(now * 9)) * 0.18, 0)
		model:PivotTo(CFrame.lookAt(position, position + delta.Unit))
	end
	return distance
end

local lastEconomy = clock()
local accumulated = 0
connect(RunService.Heartbeat, function(dt)
	if shuttingDown then
		return
	end
	accumulated += dt
	if accumulated < 0.1 then
		return
	end
	local step = math.min(accumulated, 0.25)
	accumulated = 0
	local now = clock()
	for player, session in sessions do
		checkMotion(player, now)
		if session.carrying then
			deposit(player)
		end
	end
	for zoneId, guardian in guardians do
		local zone = guardian.world.config
		if guardian.state == "Chasing" then
			local player = guardian.target
			local session = sessions[player]
			local root = player and body(player)
			if not root or not session or session.carrying ~= zoneId then
				guardian.target = nil
				guardian.state = "Returning"
				guardian.world.guardian:SetAttribute("Chasing", false)
			elseif now - guardian.startedAt > 60 then
				loseEgg(player, "The guardian reclaimed its egg. Try a quicker route!", true)
			else
				moveGuardian(guardian, root.Position, zone.guardianSpeed, step, now)
				if flatDistance(guardian.world.guardian:GetPivot().Position, root.Position) < 4.5 then
					loseEgg(player, "Caught! Your egg is gone, but your animals are safe.", true)
				end
			end
		elseif guardian.state == "Returning" then
			if
				moveGuardian(guardian, guardian.world.home.Position, zone.guardianSpeed * 1.5, step, now) < 1
			then
				guardian.world.guardian:PivotTo(guardian.world.home)
				guardian.state = "Cooldown"
				guardian.readyAt = now + zone.cooldownSeconds
			end
		elseif guardian.state == "Cooldown" and now >= guardian.readyAt then
			guardian.state = "Idle"
			world:setEggAvailable(zoneId, true)
		end
	end
	local seconds = math.floor(now - lastEconomy)
	if seconds < 1 then
		return
	end
	lastEconomy += seconds
	for player, session in sessions do
		session:earn(seconds)
		for slot = 1, Config.hatchSlots do
			local result = session:finishHatch(slot, now, rng:NextNumber(), rng:NextNumber())
			if result then
				world:clearHatch(session.baseId, slot)
				world:setAnimals(session.baseId, session.animals)
				local animal = Config.animals[result.animalId]
				remotes.Hatch:FireClient(player, {
					animalId = result.animalId,
					rarity = animal.rarity,
					income = animal.income,
					kept = result.kept,
					replacedName = result.replacedId and Config.animals[result.replacedId].name or nil,
				})
				if not result.kept then
					notice(
						player,
						"Discovered " .. animal.name .. "! Your eight higher earners stayed on display.",
						"info"
					)
				end
			end
		end
		send(player)
	end
end)

connect(Players.PlayerAdded, addPlayer)
connect(Players.PlayerRemoving, removePlayer)
for _, player in Players:GetPlayers() do
	addPlayer(player)
end

game:BindToClose(function()
	shuttingDown = true
	remotes.GetState.OnServerInvoke = nil
	for _, connection in connections do
		connection:Disconnect()
	end
	for player in sessions do
		removePlayer(player)
	end
	world:destroy()
end)

print("Steal a Goofy Egg: Phase 1 initialized (five bases, session-only progress, no music).")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[-- Pure session state: synchronous mutations make deposits/hatches exactly-once in this server.
-- Persistence and paid products intentionally belong to later phases.
local Session = {}
Session.__index = Session

function Session.new(baseId, config, economy)
	return setmetatable({
		baseId = baseId,
		cash = config.startCash,
		speedLevel = 0,
		carrying = nil,
		hatches = {},
		animals = {},
		discovered = {},
		config = config,
		economy = economy,
	}, Session)
end

function Session:freeSlot()
	for slot = 1, self.config.hatchSlots do
		if self.hatches[slot] == nil then
			return slot
		end
	end
	return nil
end

function Session:steal(zoneId)
	local zone = self.economy.getZone(zoneId)
	if not zone then
		return false, "Unknown zone."
	elseif self.carrying then
		return false, "Take your egg home first!"
	elseif self.speedLevel < zone.requiredLevel then
		return false, "Reach speed level " .. zone.requiredLevel .. " for this zone."
	elseif not self:freeSlot() then
		return false, "Your hatch slots are full. Wait for an egg to hatch."
	end
	self.carrying = zoneId
	return true
end

function Session:deposit(now)
	local slot = self:freeSlot()
	if not self.carrying or not slot then
		return nil
	end
	local zone = self.economy.getZone(self.carrying)
	local hatch = { slot = slot, zoneId = zone.id, readyAt = now + zone.hatchSeconds }
	self.hatches[slot] = hatch
	self.carrying = nil
	return hatch
end

function Session:loseCarry()
	local previous = self.carrying
	self.carrying = nil
	return previous
end

function Session:finishHatch(slot, now, rarityRoll, animalRoll)
	local hatch = self.hatches[slot]
	if not hatch or now < hatch.readyAt then
		return nil
	end
	local animalId = self.economy.rollAnimal(hatch.zoneId, rarityRoll, animalRoll)
	local animals, replacedId, kept = self.economy.addAnimal(self.animals, animalId)
	-- Remove the hatch in the same non-yielding transaction that grants its reward.
	self.hatches[slot] = nil
	self.animals = animals
	self.discovered[animalId] = true
	return { animalId = animalId, replacedId = replacedId, kept = kept }
end

function Session:upgrade()
	local cost = self.economy.upgradeCost(self.speedLevel)
	if not cost then
		return false, "Your speed is already at the maximum!"
	elseif self.cash < cost then
		return false, "You need $" .. cost .. " for the next speed level."
	end
	self.cash -= cost
	self.speedLevel += 1
	return true
end

function Session:earn(seconds)
	assert(seconds >= 0 and seconds % 1 == 0 and seconds < math.huge, "Whole elapsed seconds required")
	self.cash += self.economy.income(self.animals) * seconds
end

function Session:snapshot()
	local hatches = {}
	for slot = 1, self.config.hatchSlots do
		local hatch = self.hatches[slot]
		if hatch then
			table.insert(hatches, table.clone(hatch))
		end
	end
	local animals = {}
	for _, animal in self.animals do
		table.insert(animals, { id = animal.id })
	end
	local nextZone = "All prototype zones unlocked!"
	for _, zone in self.config.zones do
		if self.speedLevel < zone.requiredLevel then
			nextZone = zone.name .. " unlocks at speed level " .. zone.requiredLevel
			break
		end
	end
	return {
		cash = self.cash,
		income = self.economy.income(self.animals),
		speedLevel = self.speedLevel,
		walkSpeed = self.economy.walkSpeed(self.speedLevel),
		upgradeCost = self.economy.upgradeCost(self.speedLevel),
		baseId = self.baseId,
		carrying = self.carrying,
		hatches = hatches,
		animals = animals,
		discovered = table.clone(self.discovered),
		nextZone = nextZone,
		tutorial = if self.carrying
			then "Bring your egg to your own glowing base!"
			elseif
				#self.animals == 0
			then "Follow the path to Turtle Meadow. Hold the egg prompt, then run home!"
			else "Your animals earn cash every second. Upgrade speed and try Rabbit Ridge!",
		sessionOnly = true,
	}
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- The complete starter map is generated from original parts; no downloaded assets.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnimalFactory =
	require(ReplicatedStorage:WaitForChild("GoofyEgg"):WaitForChild("Shared"):WaitForChild("AnimalFactory"))

local World = {}
World.__index = World

local COLORS = {
	grass = Color3.fromRGB(135, 201, 121),
	path = Color3.fromRGB(249, 226, 169),
	edge = Color3.fromRGB(255, 248, 221),
	ink = Color3.fromRGB(37, 54, 72),
	wood = Color3.fromRGB(143, 102, 75),
	leaf = Color3.fromRGB(77, 166, 108),
	mint = Color3.fromRGB(102, 222, 183),
	white = Color3.fromRGB(255, 254, 242),
}

local BASE_COLORS = {
	Color3.fromRGB(117, 203, 239),
	Color3.fromRGB(255, 185, 119),
	Color3.fromRGB(204, 170, 244),
	Color3.fromRGB(244, 159, 190),
	Color3.fromRGB(157, 218, 135),
}

local function colorFrom(value)
	if typeof(value) == "Color3" then
		return value
	end
	value = value or {}
	return Color3.fromRGB(value.r or value[1] or 140, value.g or value[2] or 210, value.b or value[3] or 140)
end

local function folder(name, parent)
	local result = Instance.new("Folder")
	result.Name = name
	result.Parent = parent
	return result
end

local function model(name, parent)
	local result = Instance.new("Model")
	result.Name = name
	result.Parent = parent
	return result
end

local function part(parent, name, size, position, color, collidable, shape, rotation)
	local result = Instance.new("Part")
	result.Name = name
	result.Size = size
	result.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
	result.Color = color
	result.Material = Enum.Material.SmoothPlastic
	result.Shape = shape or Enum.PartType.Block
	result.Anchored = true
	result.CanCollide = collidable == true
	result.CanTouch = false
	result.CanQuery = collidable == true
	result.TopSurface = Enum.SurfaceType.Smooth
	result.BottomSurface = Enum.SurfaceType.Smooth
	result.Parent = parent
	return result
end

local function disc(parent, name, diameter, thickness, position, color, collidable)
	return part(
		parent,
		name,
		Vector3.new(thickness, diameter, diameter),
		position,
		color,
		collidable,
		Enum.PartType.Cylinder,
		CFrame.Angles(0, 0, math.pi / 2)
	)
end

local function billboard(parent, name, width, height, offset, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Adornee = parent
	gui.Size = UDim2.fromOffset(width, height)
	gui.StudsOffsetWorldSpace = offset or Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 95
	gui.Parent = parent
	return gui
end

local function textLabel(parent, name, text, color, y, height)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = UDim2.fromScale(1, height or 1)
	label.Position = UDim2.fromScale(0, y or 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or COLORS.white
	label.TextStrokeColor3 = COLORS.ink
	label.TextStrokeTransparency = 0.25
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

local function prompt(parent, name, action, object, holdDuration)
	local result = Instance.new("ProximityPrompt")
	result.Name = name
	result.ActionText = action
	result.ObjectText = object
	result.HoldDuration = holdDuration or 0.25
	result.MaxActivationDistance = 11
	result.RequiresLineOfSight = false
	result.KeyboardKeyCode = Enum.KeyCode.E
	result.GamepadKeyCode = Enum.KeyCode.ButtonX
	result.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	result.Parent = parent
	return result
end

local function sign(parent, name, position, text, color, width, maxDistance)
	part(
		parent,
		name .. "Post",
		Vector3.new(0.6, 5, 0.6),
		position + Vector3.new(0, 2.5, 0),
		COLORS.wood,
		false
	)
	local board = part(
		parent,
		name,
		Vector3.new(width or 12, 3, 0.65),
		position + Vector3.new(0, 5, 0),
		color or COLORS.ink,
		false
	)
	local gui = billboard(board, name .. "Billboard", 280, 65, Vector3.zero, maxDistance or 110)
	return textLabel(gui, "Title", text, COLORS.white)
end

local function tree(parent, x, z, scale)
	local base = Vector3.new(x, 0, z)
	local treeModel = model("LollipopTree", parent)
	part(
		treeModel,
		"Trunk",
		Vector3.new(1.8, 8, 1.8) * scale,
		base + Vector3.new(0, 4 * scale, 0),
		COLORS.wood,
		false
	)
	part(
		treeModel,
		"Crown",
		Vector3.new(8, 8, 8) * scale,
		base + Vector3.new(0, 10 * scale, 0),
		COLORS.leaf,
		false,
		Enum.PartType.Ball
	)
	part(
		treeModel,
		"CrownLight",
		Vector3.new(5, 5, 5) * scale,
		base + Vector3.new(-2 * scale, 12 * scale, -scale),
		COLORS.leaf:Lerp(COLORS.white, 0.13),
		false,
		Enum.PartType.Ball
	)
end

local function shrubs(parent, x, z, color)
	for index = 1, 3 do
		part(
			parent,
			"Shrub",
			Vector3.new(3.8, 3.2, 3.5),
			Vector3.new(x + (index - 2) * 2.8, 1.2, z),
			color or COLORS.leaf,
			false,
			Enum.PartType.Ball
		)
	end
end

local function buildGround(root)
	local map = folder("Landscape", root)
	local ground = part(map, "Meadow", Vector3.new(360, 2, 760), Vector3.new(0, -1, 85), COLORS.grass, true)
	ground.Material = Enum.Material.Grass
	part(map, "MainPath", Vector3.new(64, 0.16, 405), Vector3.new(0, 0.08, 200), COLORS.path, true)
	part(map, "LobbyPlaza", Vector3.new(235, 0.2, 45), Vector3.new(0, 0.1, 21), COLORS.path, true)
	for _, x in ipairs({ -33, 33 }) do
		part(map, "PathTrim", Vector3.new(1.5, 0.22, 405), Vector3.new(x, 0.11, 200), COLORS.edge, false)
	end
	for _, x in ipairs({ -179, 179 }) do
		part(map, "Boundary", Vector3.new(2, 4, 760), Vector3.new(x, 2, 85), COLORS.leaf, true)
	end
	for _, z in ipairs({ -294, 464 }) do
		part(map, "Boundary", Vector3.new(360, 4, 2), Vector3.new(0, 2, z), COLORS.leaf, true)
	end
	local decor = folder("Decorations", root)
	for index = 1, 10 do
		local z = -235 + index * 63
		tree(decor, -153, z, 0.8 + (index % 3) * 0.16)
		tree(decor, 151, z + 18, 0.95 + (index % 2) * 0.18)
	end
	for _, z in ipairs({ 72, 220, 395 }) do
		shrubs(decor, -51, z)
		shrubs(decor, 51, z)
	end
	for _, x in ipairs({ -48, 48 }) do
		part(decor, "WelcomeArchPost", Vector3.new(2, 17, 2), Vector3.new(x, 8.5, 52), COLORS.wood, false)
	end
	local arch =
		part(decor, "WelcomeArch", Vector3.new(100, 5, 2), Vector3.new(0, 16, 52), COLORS.mint, false)
	textLabel(
		billboard(arch, "Welcome", 520, 65, Vector3.zero, 180),
		"Title",
		"STEAL A GOOFY EGG",
		COLORS.white
	)
	sign(
		decor,
		"HowTo",
		Vector3.new(-65, 0, 41),
		"STEAL → ESCAPE → HATCH\nBring eggs to your base!",
		COLORS.ink,
		23,
		80
	)
	sign(
		decor,
		"Route",
		Vector3.new(65, 0, 41),
		"FOLLOW THE PATH\nSneak past the guardians!",
		COLORS.ink,
		23,
		80
	)
	for _, z in ipairs({ 86, 232, 389 }) do
		local arrow = part(
			decor,
			"RouteArrow",
			Vector3.new(0.35, 0.06, 4),
			Vector3.new(0, 0.21, z),
			COLORS.white,
			false
		)
		arrow.Transparency = 0.1
		for _, side in ipairs({ -1, 1 }) do
			part(
				decor,
				"ArrowTip",
				Vector3.new(0.35, 0.06, 2.6),
				Vector3.new(side * 0.85, 0.21, z + 1.05),
				COLORS.white,
				false,
				nil,
				CFrame.Angles(0, math.rad(side * -43), 0)
			)
		end
	end
end

local function buildBase(config, parent, id, position)
	local baseModel = model("Base_" .. id, parent)
	baseModel:SetAttribute("BaseId", id)
	baseModel:SetAttribute("OwnerUserId", 0)
	local center = Vector3.new(position.x, 0, position.z)
	local color = BASE_COLORS[id] or COLORS.mint
	part(baseModel, "Foundation", Vector3.new(64, 0.9, 56), center + Vector3.new(0, 0.05, 0), color, true)
	part(baseModel, "Floor", Vector3.new(61, 0.12, 53), center + Vector3.new(0, 0.56, 0), COLORS.edge, true)
	part(baseModel, "BackRail", Vector3.new(64, 2, 1), center + Vector3.new(0, 1.45, -27.5), color, true)
	for _, side in ipairs({ -1, 1 }) do
		part(
			baseModel,
			"SideRail",
			Vector3.new(1, 2, 56),
			center + Vector3.new(side * 31.5, 1.45, 0),
			color,
			true
		)
		part(
			baseModel,
			"EntrancePost",
			Vector3.new(1.5, 6, 1.5),
			center + Vector3.new(side * 12, 3, 27),
			color,
			false
		)
	end
	local ownerSign =
		sign(baseModel, "OwnerSign", center + Vector3.new(0, 0, -26), "UNCLAIMED BASE", color, 25, 125)
	local hatchFolder = folder("Hatches", baseModel)
	local animalFolder = folder("Animals", baseModel)
	local slots = {}
	for index = 1, config.hatchSlots do
		local x = (index - (config.hatchSlots + 1) / 2) * 18
		local slot =
			disc(baseModel, "HatchSlot_" .. index, 9.3, 0.3, center + Vector3.new(x, 0.78, -12), color, false)
		slot:SetAttribute("SlotIndex", index)
		slots[index] = slot
		local gui = billboard(slot, "SlotLabel", 120, 25, Vector3.new(0, 0.55, 0), 46)
		textLabel(gui, "Title", "HATCH " .. index, COLORS.ink).TextStrokeTransparency = 1
	end
	local animalSpots = {}
	for index = 1, config.maxAnimals do
		local column = (index - 1) % 4
		local row = math.floor((index - 1) / 4)
		local x = (column - 1.5) * 12
		local z = 5 + row * 9
		disc(
			baseModel,
			"AnimalSpot_" .. index,
			6.6,
			0.18,
			center + Vector3.new(x, 0.73, z),
			color:Lerp(COLORS.white, 0.55),
			false
		)
		animalSpots[index] = CFrame.new(center + Vector3.new(x, 0.85, z)) * CFrame.Angles(0, math.pi, 0)
	end
	local deposit =
		disc(baseModel, "DepositPad", 9, 0.25, center + Vector3.new(0, 0.79, 0), COLORS.mint, false)
	local depositPrompt = prompt(deposit, "DepositEgg", "Hatch egg", "Your hatchery", 0.35)
	local depositGui = billboard(deposit, "DepositLabel", 170, 42, Vector3.new(0, 2.5, 0), 50)
	textLabel(depositGui, "Title", "BRING EGG HERE", COLORS.white)
	local shop =
		part(baseModel, "SpeedShop", Vector3.new(5, 3, 4), center + Vector3.new(-24, 2.1, 20), color, false)
	part(
		baseModel,
		"ShopTop",
		Vector3.new(6, 0.45, 5),
		center + Vector3.new(-24, 3.85, 20),
		COLORS.ink,
		false
	)
	local shopGui = billboard(shop, "ShopLabel", 160, 52, Vector3.new(0, 3.4, 0), 65)
	textLabel(shopGui, "Title", "SPEED SHOP\nRun a little faster", COLORS.white)
	local upgradePrompt = prompt(shop, "UpgradeSpeed", "Upgrade speed", "Speed shop", 0.35)
	return {
		id = id,
		center = center,
		spawn = CFrame.lookAt(center + Vector3.new(0, 4, 19), center + Vector3.new(0, 4, 35)),
		model = baseModel,
		slots = slots,
		animalSpots = animalSpots,
		sign = ownerSign,
		depositPrompt = depositPrompt,
		upgradePrompt = upgradePrompt,
		hatchFolder = hatchFolder,
		animalFolder = animalFolder,
		hatches = {},
	}
end

local function buildZone(parent, zone)
	local zoneModel = model("Zone_" .. zone.id, parent)
	zoneModel:SetAttribute("ZoneId", zone.id)
	local color = colorFrom(zone.color)
	local center = Vector3.new(zone.position.x, 0, zone.position.z)
	part(
		zoneModel,
		"ZoneCourt",
		Vector3.new(85, 0.15, 86),
		center + Vector3.new(0, 0.15, 0),
		color:Lerp(COLORS.white, 0.65),
		true
	)
	for _, side in ipairs({ -1, 1 }) do
		part(
			zoneModel,
			"ZoneEdge",
			Vector3.new(1.2, 0.6, 86),
			center + Vector3.new(side * 43, 0.3, 0),
			color,
			false
		)
		shrubs(zoneModel, center.X + side * 55, center.Z - 23, color:Lerp(COLORS.leaf, 0.6))
	end
	local levelText = zone.requiredLevel > 1 and (" · LEVEL " .. zone.requiredLevel) or " · START HERE"
	sign(
		zoneModel,
		"ZoneSign",
		center + Vector3.new(-26, 0, -35),
		string.upper(zone.name) .. levelText,
		color,
		26,
		110
	)
	local eggPosition = center + Vector3.new(0, 2.5, 0)
	disc(zoneModel, "EggPlinth", 9, 1.1, center + Vector3.new(0, 0.75, 0), COLORS.edge, true)
	disc(zoneModel, "EggRing", 10, 0.15, center + Vector3.new(0, 0.32, 0), color, false)
	local egg = AnimalFactory.egg(zone.color, "WildEgg")
	egg:SetAttribute("ZoneId", zone.id)
	egg:SetAttribute("Available", true)
	egg:PivotTo(CFrame.new(eggPosition))
	egg.Parent = zoneModel
	local stealPrompt = prompt(egg.PrimaryPart, "StealEgg", "Steal egg", zone.name, 0.65)
	local eggGui = billboard(egg.PrimaryPart, "EggBillboard", 190, 43, Vector3.new(0, 3, 0), 72)
	textLabel(eggGui, "Title", "GOOFY EGG\nGrab it. Run!", COLORS.white)
	local homePosition = center + Vector3.new(zone.guardianOffset or 20, 0.3, 0)
	local home = CFrame.lookAt(homePosition, Vector3.new(center.X, homePosition.Y, center.Z))
	local guardian = AnimalFactory.create(zone.guardian, zone.color, "Guardian")
	guardian:SetAttribute("VisualRole", "Guardian")
	guardian:SetAttribute("ZoneId", zone.id)
	guardian:SetAttribute("State", "Idle")
	guardian:SetAttribute("HomeX", homePosition.X)
	guardian:SetAttribute("HomeY", homePosition.Y)
	guardian:SetAttribute("HomeZ", homePosition.Z)
	guardian:ScaleTo(1.65)
	guardian:PivotTo(home)
	guardian.Parent = zoneModel
	local guardianGui = billboard(
		guardian.PrimaryPart,
		"GuardianBillboard",
		180,
		48,
		Vector3.new(0, zone.guardian == "rabbit" and 7.5 or 4.5, 0),
		85
	)
	textLabel(guardianGui, "Title", string.upper(zone.guardian) .. " GUARDIAN", COLORS.white, 0, 0.56)
	textLabel(guardianGui, "State", "Protecting the egg", COLORS.white, 0.6, 0.4)
	return {
		config = zone,
		home = home,
		egg = egg,
		prompt = stealPrompt,
		guardian = guardian,
		model = zoneModel,
	}
end

function World.build(config)
	local previous = workspace:FindFirstChild("GoofyEggWorld")
	if previous then
		previous:Destroy()
	end
	local root = folder("GoofyEggWorld", workspace)
	local self = setmetatable({ config = config, root = root, bases = {}, zones = {} }, World)
	buildGround(root)
	local basesFolder = folder("Bases", root)
	for id, position in ipairs(config.basePositions) do
		self.bases[id] = buildBase(config, basesFolder, id, position)
	end
	local zonesFolder = folder("Zones", root)
	for _, zone in ipairs(config.zones) do
		self.zones[zone.id] = buildZone(zonesFolder, zone)
	end
	return self
end

function World:setBaseOwner(baseId, player)
	local base = self.bases[baseId]
	if not base then
		return
	end
	base.model:SetAttribute("OwnerUserId", player and player.UserId or 0)
	base.sign.Text = player and (player.DisplayName .. "'S BASE") or "UNCLAIMED BASE"
	base.depositPrompt.ObjectText = player and (player.DisplayName .. "'s hatchery") or "Unclaimed hatchery"
	if not player then
		for index = 1, self.config.hatchSlots do
			self:clearHatch(baseId, index)
		end
		self:setAnimals(baseId, {})
	end
end

function World:showHatch(baseId, slotIndex, zoneId, readyAt)
	local base = self.bases[baseId]
	local zone = self.zones[zoneId]
	if not base or not base.slots[slotIndex] or not zone then
		return
	end
	self:clearHatch(baseId, slotIndex)
	local egg = AnimalFactory.egg(zone.config.color, "Hatch_" .. slotIndex)
	egg:SetAttribute("VisualRole", "HatchingEgg")
	egg:SetAttribute("ReadyAt", readyAt)
	egg:SetAttribute("ZoneId", zoneId)
	egg:SetAttribute("BaseId", baseId)
	egg:SetAttribute("SlotIndex", slotIndex)
	egg:PivotTo(CFrame.new(base.slots[slotIndex].Position + Vector3.new(0, 2, 0)))
	egg.Parent = base.hatchFolder
	local gui = billboard(egg.PrimaryPart, "HatchBillboard", 190, 64, Vector3.new(0, 3.4, 0), 85)
	textLabel(gui, "Title", zone.config.name, COLORS.white, 0, 0.5)
	textLabel(
		gui,
		"Countdown",
		math.max(0, math.ceil(readyAt - workspace:GetServerTimeNow())) .. "s",
		COLORS.mint,
		0.53,
		0.47
	)
	base.hatches[slotIndex] = egg
end

function World:clearHatch(baseId, slotIndex)
	local base = self.bases[baseId]
	if not base then
		return
	end
	local egg = base.hatches[slotIndex]
	if egg then
		egg:Destroy()
		base.hatches[slotIndex] = nil
	end
end

function World:setAnimals(baseId, animals)
	local base = self.bases[baseId]
	if not base then
		return
	end
	base.animalFolder:ClearAllChildren()
	for index, owned in ipairs(animals) do
		local animalConfig = self.config.animals[owned.id]
		local spot = base.animalSpots[index]
		if animalConfig and spot then
			local animal = AnimalFactory.create(animalConfig.species, animalConfig.color, animalConfig.name)
			animal:SetAttribute("AnimalId", owned.id)
			animal:SetAttribute("BaseId", baseId)
			animal:SetAttribute("SlotIndex", index)
			animal:SetAttribute("Personality", animalConfig.personality)
			animal:PivotTo(spot)
			animal.Parent = base.animalFolder
			local rarity = self.config.rarities[animalConfig.rarity]
			local rarityColor = rarity and colorFrom(rarity.color) or COLORS.white
			local gui = billboard(animal.PrimaryPart, "AnimalBillboard", 148, 59, Vector3.new(0, 4.6, 0), 65)
			textLabel(gui, "Title", animalConfig.name, COLORS.white, 0, 0.36)
			textLabel(gui, "Rarity", animalConfig.rarity, rarityColor, 0.38, 0.27)
			textLabel(gui, "Income", "$" .. animalConfig.income .. "/s", COLORS.mint, 0.7, 0.3)
		end
	end
end

function World:setEggAvailable(zoneId, available)
	local zone = self.zones[zoneId]
	if not zone then
		return
	end
	zone.egg:SetAttribute("Available", available)
	zone.prompt.Enabled = available
	for _, descendant in ipairs(zone.egg:GetDescendants()) do
		if descendant:IsA("BasePart") then
			if descendant:GetAttribute("OriginalTransparency") == nil then
				descendant:SetAttribute("OriginalTransparency", descendant.Transparency)
			end
			descendant.Transparency = available and descendant:GetAttribute("OriginalTransparency") or 1
		elseif descendant:IsA("BillboardGui") then
			descendant.Enabled = available
		end
	end
end

function World:destroy()
	self.root:Destroy()
	self.bases = {}
	self.zones = {}
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="18">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="19">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="Folder" referent="20">
      <Properties>
        <string name="Name">GoofyUI</string>
      </Properties>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--!nonstrict
-- All artwork is made from Roblox UI primitives. No image or audio assets are required.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Hud = {}
Hud.__index = Hud

local C = {
	ink = Color3.fromRGB(39, 37, 63),
	muted = Color3.fromRGB(113, 110, 132),
	paper = Color3.fromRGB(255, 253, 248),
	blue = Color3.fromRGB(91, 153, 255),
	lilac = Color3.fromRGB(187, 156, 255),
	mint = Color3.fromRGB(151, 231, 175),
	yellow = Color3.fromRGB(255, 216, 105),
	pink = Color3.fromRGB(255, 151, 171),
}

local function make(class, properties, parent)
	local instance = Instance.new(class)
	for key, value in pairs(properties) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function round(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 16) }, parent)
end

local function border(parent, color, thickness)
	return make(
		"UIStroke",
		{ Color = color or C.ink, Thickness = thickness or 2, Transparency = 0.08 },
		parent
	)
end

local function label(parent, text, size, color, position, dimensions, bold)
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham,
		TextSize = size,
		TextColor3 = color or C.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = position or UDim2.new(),
		Size = dimensions or UDim2.fromScale(1, 1),
	}, parent)
end

local function panel(parent, name, color, position, dimensions)
	local frame = make("Frame", {
		Name = name,
		BackgroundColor3 = color or C.paper,
		BorderSizePixel = 0,
		Position = position,
		Size = dimensions,
	}, parent)
	round(frame)
	border(frame)
	return frame
end

local function cash(value)
	value = tonumber(value) or 0
	if value >= 1e9 then
		return string.format("%.1fB", value / 1e9)
	elseif value >= 1e6 then
		return string.format("%.1fM", value / 1e6)
	elseif value >= 1e4 then
		return string.format("%.1fK", value / 1e3)
	end
	local formatted = tostring(math.floor(value))
	while true do
		local changed
		formatted, changed = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if changed == 0 then
			break
		end
	end
	return formatted
end

local function tint(rgb, fallback)
	if type(rgb) ~= "table" then
		return fallback or C.mint
	end
	return Color3.fromRGB(rgb.r or 150, rgb.g or 200, rgb.b or 170)
end

-- A small original egg mascot, also used as the unrevealed collection portrait.
local function eggArt(parent, position, dimensions, color, asleep)
	local art = make("Frame", {
		BackgroundTransparency = 1,
		Position = position,
		Size = dimensions,
	}, parent)
	local egg = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromScale(0.66, 0.83),
		BackgroundColor3 = color or C.yellow,
		BorderSizePixel = 0,
		Rotation = -7,
	}, art)
	make("UICorner", { CornerRadius = UDim.new(0.48, 0) }, egg)
	border(egg, C.ink, 2)
	for _, x in ipairs({ 0.32, 0.68 }) do
		local eye = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, 0.52),
			Size = UDim2.fromScale(0.085, if asleep then 0.025 else 0.12),
			BackgroundColor3 = C.ink,
			BorderSizePixel = 0,
		}, egg)
		round(eye, 8)
	end
	local smile = label(egg, "v", 18, C.ink, UDim2.fromScale(0.35, 0.57), UDim2.fromScale(0.3, 0.22), true)
	smile.TextXAlignment = Enum.TextXAlignment.Center
	return art
end

-- Flat animal portraits echo the procedural world models without external artwork.
local function animalArt(parent, position, dimensions, animal)
	local art = make("Frame", { BackgroundTransparency = 1, Position = position, Size = dimensions }, parent)
	local color = tint(animal.color)
	local function shape(x, y, w, h, fill, radius)
		local piece = make("Frame", {
			Position = UDim2.fromScale(x, y),
			Size = UDim2.fromScale(w, h),
			BackgroundColor3 = fill,
			BorderSizePixel = 0,
		}, art)
		make("UICorner", { CornerRadius = UDim.new(radius or 0.5, 0) }, piece)
		return piece
	end
	local species = animal.species
	if species == "rabbit" then
		shape(0.25, 0.02, 0.16, 0.49, color)
		shape(0.59, 0.02, 0.16, 0.49, color)
		shape(0.3, 0.06, 0.06, 0.3, C.pink)
		shape(0.64, 0.06, 0.06, 0.3, C.pink)
	elseif species == "cat" then
		local left = shape(0.2, 0.14, 0.26, 0.31, color, 0.18)
		left.Rotation = -20
		local right = shape(0.54, 0.14, 0.26, 0.31, color, 0.18)
		right.Rotation = 20
	elseif species == "dinosaur" then
		shape(0.43, 0.12, 0.16, 0.29, C.mint, 0.2)
	end
	local head = shape(0.12, 0.29, 0.76, 0.61, color)
	border(head, C.ink, 1.5)
	if species == "penguin" then
		shape(0.28, 0.45, 0.44, 0.38, C.paper)
	elseif species == "turtle" then
		shape(0.3, 0.78, 0.4, 0.12, color:Lerp(C.ink, 0.2))
	end
	if species == "frog" then
		shape(0.22, 0.22, 0.23, 0.25, color)
		shape(0.55, 0.22, 0.23, 0.25, color)
	end
	local eyeY = if species == "frog" then 0.28 else 0.48
	shape(0.31, eyeY, 0.075, 0.1, C.ink)
	shape(0.62, eyeY, 0.075, 0.1, C.ink)
	if species == "duck" or species == "penguin" then
		shape(0.37, 0.61, 0.28, 0.14, C.yellow:Lerp(C.pink, 0.25))
	else
		local smile =
			label(art, "v", 17, C.ink, UDim2.fromScale(0.38, 0.59), UDim2.fromScale(0.24, 0.21), true)
		smile.TextXAlignment = Enum.TextXAlignment.Center
	end
	return art
end

function Hud:_connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

function Hud:_button(parent, text, color, position, dimensions, callback)
	local button = make("TextButton", {
		Text = text,
		TextColor3 = C.ink,
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = position,
		Size = dimensions,
		AutoButtonColor = true,
	}, parent)
	round(button, 12)
	border(button, C.ink, 1.5)
	-- Activated works for mouse, touch, and gamepad selection.
	self:_connect(button.Activated, function()
		if self.destroyed then
			return
		end
		callback()
	end)
	return button
end

function Hud:_action(action)
	if not self.state then
		self:notice({ text = "Your base is still loading. One moment!", kind = "info" })
		return
	end
	local now = os.clock()
	if now - self.lastAction < 0.3 then
		return
	end
	self.lastAction = now
	-- The UI only requests an action. Price, distance, and rewards are server decisions.
	self.callbacks.action(action)
end

function Hud:_open(name)
	if self.activePanel == name and self.modal.Visible then
		self.modal.Visible = false
		self.activePanel = nil
		return
	end
	self.activePanel = name
	self.modal.Visible = true
	self.modalTitle.Text = name
	for key, page in pairs(self.pages) do
		page.Visible = key == name
	end
end

function Hud.new(config, callbacks)
	local self = setmetatable({}, Hud)
	self.config = config
	self.callbacks = callbacks
	self.connections = {}
	self.state = nil
	self.lastAction = 0
	self.noticeUntil = 0
	self.revealUntil = 0
	self.reducedMotion = false
	self.effects = true
	self.destroyed = false
	self.collectionCards = {}
	self.slotLabels = {}
	self.zoneById = {}
	for _, zone in ipairs(config.zones) do
		self.zoneById[zone.id] = zone
	end

	self.gui = make("ScreenGui", {
		Name = "GoofyEggHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 20,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.root = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, self.gui)
	self.scale = make("UIScale", { Scale = 1 }, self.root)

	self.brand =
		label(self.root, "GOOFY EGG", 21, C.paper, UDim2.fromOffset(18, 12), UDim2.fromOffset(190, 30), true)
	make("UIStroke", { Color = C.ink, Thickness = 2 }, self.brand)
	self.sessionLabel = label(
		self.root,
		"PROTOTYPE · progress resets when you leave",
		11,
		C.paper,
		UDim2.fromOffset(18, 41),
		UDim2.fromOffset(370, 22),
		true
	)
	make("UIStroke", { Color = C.ink, Thickness = 1.2 }, self.sessionLabel)

	self.stats = make(
		"Frame",
		{ BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 73), Size = UDim2.fromOffset(410, 62) },
		self.root
	)
	local statNames = { "CASH", "PER SECOND", "SPEED" }
	local statColors = { C.yellow, C.mint, C.lilac }
	self.statValues = {}
	for index, title in ipairs(statNames) do
		local stat = panel(
			self.stats,
			title,
			statColors[index],
			UDim2.new((index - 1) / 3, 3, 0, 0),
			UDim2.new(1 / 3, -8, 1, 0)
		)
		label(stat, title, 11, C.ink, UDim2.fromOffset(12, 7), UDim2.new(1, -24, 0, 17), true)
		self.statValues[index] =
			label(stat, "...", 22, C.ink, UDim2.fromOffset(12, 26), UDim2.new(1, -20, 0, 27), true)
	end

	self.mission = panel(self.root, "Mission", C.paper, UDim2.fromOffset(18, 145), UDim2.fromOffset(350, 97))
	self.missionHeading = label(
		self.mission,
		"LET'S GET GOOFY",
		12,
		C.muted,
		UDim2.fromOffset(14, 9),
		UDim2.new(1, -28, 0, 18),
		true
	)
	self.missionText = label(
		self.mission,
		"Setting up your base...",
		15,
		C.ink,
		UDim2.fromOffset(14, 30),
		UDim2.new(1, -28, 0, 53),
		true
	)
	self.missionText.TextWrapped = true
	self.missionText.TextYAlignment = Enum.TextYAlignment.Top

	self.hatching =
		panel(self.root, "Hatching", C.paper, UDim2.fromOffset(18, 252), UDim2.fromOffset(350, 69))
	label(self.hatching, "YOUR NEST", 11, C.muted, UDim2.fromOffset(13, 7), UDim2.new(1, -26, 0, 18), true)
	for index = 1, config.hatchSlots do
		local slot = label(
			self.hatching,
			"○ Empty",
			12,
			C.muted,
			UDim2.new((index - 1) / config.hatchSlots, 12, 0, 30),
			UDim2.new(1 / config.hatchSlots, -18, 0, 28),
			true
		)
		self.slotLabels[index] = slot
	end

	self.upgrade = self:_button(
		self.root,
		"SPEED UP · ...",
		C.lilac,
		UDim2.fromOffset(18, 333),
		UDim2.fromOffset(232, 48),
		function()
			self:_action("UpgradeSpeed")
		end
	)
	self.deposit = self:_button(
		self.root,
		"DEPOSIT EGG",
		C.yellow,
		UDim2.fromOffset(18, 391),
		UDim2.fromOffset(232, 46),
		function()
			self:_action("DepositEgg")
		end
	)
	self.deposit.Visible = false

	self.navigation = make("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 74),
		Size = UDim2.fromOffset(142, 172),
	}, self.root)
	for index, definition in ipairs({
		{ "Collection", C.mint },
		{ "Shop", C.yellow },
		{ "Settings", C.paper },
	}) do
		local name = definition[1]
		self:_button(
			self.navigation,
			name,
			definition[2],
			UDim2.fromOffset(0, (index - 1) * 58),
			UDim2.fromOffset(142, 48),
			function()
				self:_open(name)
			end
		)
	end

	self.noticeFrame =
		panel(self.root, "Notice", C.yellow, UDim2.new(0.5, 0, 0, 18), UDim2.fromOffset(430, 54))
	self.noticeFrame.AnchorPoint = Vector2.new(0.5, 0)
	self.noticeFrame.ZIndex = 80
	self.noticeFrame.Visible = false
	self.noticeText =
		label(self.noticeFrame, "", 15, C.ink, UDim2.fromOffset(14, 6), UDim2.new(1, -28, 1, -12), true)
	self.noticeText.TextWrapped = true

	self.modal = make("Frame", {
		Name = "Menus",
		BackgroundColor3 = C.ink,
		BackgroundTransparency = 0.4,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 40,
		Active = true,
	}, self.root)
	self.modalPanel =
		panel(self.modal, "Card", C.paper, UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(570, 450))
	self.modalPanel.AnchorPoint = Vector2.new(0.5, 0.5)
	self.modalTitle = label(
		self.modalPanel,
		"Collection",
		25,
		C.ink,
		UDim2.fromOffset(22, 16),
		UDim2.new(1, -100, 0, 39),
		true
	)
	self:_button(self.modalPanel, "X", C.pink, UDim2.new(1, -60, 0, 16), UDim2.fromOffset(40, 40), function()
		self.modal.Visible = false
		self.activePanel = nil
	end)
	self.pages = {}
	for _, name in ipairs({ "Collection", "Shop", "Settings" }) do
		self.pages[name] = make("ScrollingFrame", {
			Name = name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(18, 68),
			Size = UDim2.new(1, -36, 1, -84),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 5,
			ScrollBarImageColor3 = C.lilac,
			Visible = false,
		}, self.modalPanel)
	end
	self:_buildCollection()
	self:_buildShop()
	self:_buildSettings()
	self:_buildReveal()

	self:_connect(self.gui:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:_layout()
	end)
	self:_layout()
	local elapsed = 0
	self:_connect(RunService.Heartbeat, function(dt)
		elapsed += dt
		if elapsed < 0.1 then
			return
		end
		elapsed = 0
		self:_tick()
	end)
	return self
end

function Hud:_layout()
	local size = self.gui.AbsoluteSize
	local scale = if size.X < 480 then 0.82 elseif size.X < 780 then 0.9 else 1
	if size.Y < 450 then
		scale = math.min(scale, 0.82)
	end
	self.scale.Scale = scale
	self.root.Size = UDim2.fromScale(1 / scale, 1 / scale)
	local width, height = size.X / scale, size.Y / scale
	local compact = width < 650
	self.brand.Position = UDim2.fromOffset(18, 8)
	self.sessionLabel.Position = UDim2.fromOffset(18, 37)
	self.stats.Size = UDim2.fromOffset(math.min(410, width - 36), 62)
	self.stats.Position = UDim2.fromOffset(15, 69)
	self.mission.Size = UDim2.fromOffset(if compact then math.max(210, width - 192) else 350, 97)
	self.mission.Position = UDim2.fromOffset(18, 141)
	self.hatching.Size = UDim2.fromOffset(if compact then math.max(210, width - 192) else 350, 69)
	self.hatching.Position = UDim2.fromOffset(18, 249)
	self.navigation.Position = UDim2.new(1, -18, 0, if compact then 141 else 69)
	self.upgrade.Position = UDim2.fromOffset(18, 329)
	self.upgrade.Size = UDim2.fromOffset(if compact then math.max(210, width - 192) else 232, 48)
	self.deposit.Position = UDim2.fromOffset(18, 387)
	self.deposit.Size = self.upgrade.Size
	-- Landscape phones keep controls above the movement/jump touch controls.
	if height < 510 and not compact then
		self.mission.Position = UDim2.fromOffset(18, 141)
		self.hatching.Position = UDim2.fromOffset(18, 249)
		self.upgrade.Position = UDim2.new(1, -274, 0, 255)
		self.deposit.Position = UDim2.new(1, -274, 0, 311)
		self.mission.Size = UDim2.fromOffset(350, 97)
	end
	self.modalPanel.Size = UDim2.fromOffset(math.min(570, width - 30), math.min(450, height - 30))
	self.noticeFrame.Size = UDim2.fromOffset(math.min(430, width - 36), 62)
	self.revealCard.Size = UDim2.fromOffset(math.min(400, width - 38), math.min(400, height - 30))
	self.collectionGrid.CellSize = UDim2.new(0.5, -8, 0, 103)
end

function Hud:_buildCollection()
	local page = self.pages.Collection
	self.collectionCount = label(
		page,
		"Discover a friend. Start a collection!",
		14,
		C.muted,
		UDim2.new(),
		UDim2.new(1, -8, 0, 30)
	)
	local grid = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, page)
	self.collectionGrid = make("UIGridLayout", {
		CellSize = UDim2.new(0.5, -8, 0, 103),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	make(
		"UIPadding",
		{ PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2) },
		grid
	)
	local entries = {}
	for id, animal in pairs(self.config.animals) do
		table.insert(entries, { id = id, animal = animal })
	end
	table.sort(entries, function(a, b)
		local aOrder = self.config.rarities[a.animal.rarity].order
		local bOrder = self.config.rarities[b.animal.rarity].order
		return if aOrder == bOrder then a.id < b.id else aOrder < bOrder
	end)
	for index, entry in ipairs(entries) do
		local card = panel(grid, entry.id, Color3.fromRGB(243, 240, 247), UDim2.new(), UDim2.new())
		card.LayoutOrder = index
		local art = eggArt(card, UDim2.fromOffset(9, 19), UDim2.fromOffset(49, 64), C.lilac, true)
		local name = label(card, "???", 14, C.ink, UDim2.fromOffset(65, 12), UDim2.new(1, -71, 0, 32), true)
		name.TextWrapped = true
		local rarity = label(
			card,
			entry.animal.rarity,
			11,
			C.muted,
			UDim2.fromOffset(65, 47),
			UDim2.new(1, -71, 0, 19),
			true
		)
		local income =
			label(card, "Not discovered", 10, C.muted, UDim2.fromOffset(65, 68), UDim2.new(1, -71, 0, 23))
		income.TextWrapped = true
		self.collectionCards[entry.id] =
			{ frame = card, name = name, rarity = rarity, income = income, art = art }
	end
end

function Hud:_buildShop()
	local page = self.pages.Shop
	local text = label(
		page,
		"A little faster. A little goofier.",
		18,
		C.ink,
		UDim2.fromOffset(0, 0),
		UDim2.new(1, -8, 0, 32),
		true
	)
	text.TextWrapped = true
	self.shopSpeed =
		label(page, "Loading your speed...", 14, C.muted, UDim2.fromOffset(0, 40), UDim2.new(1, -8, 0, 42))
	self.shopSpeed.TextWrapped = true
	self.shopUpgrade = self:_button(
		page,
		"UPGRADE SPEED",
		C.lilac,
		UDim2.fromOffset(2, 99),
		UDim2.new(1, -12, 0, 52),
		function()
			self:_action("UpgradeSpeed")
		end
	)
	local progression =
		label(page, "ZONE GUIDE", 12, C.muted, UDim2.fromOffset(0, 172), UDim2.new(1, -8, 0, 22), true)
	progression.Name = "ZoneGuide"
	self.zoneGuide =
		label(page, "", 14, C.ink, UDim2.fromOffset(0, 201), UDim2.new(1, -8, 0, #self.config.zones * 33))
	self.zoneGuide.TextWrapped = true
	self.zoneGuide.TextYAlignment = Enum.TextYAlignment.Top
	local footer = label(
		page,
		"Every upgrade uses earned game cash.\nRobux shop: planned for a future phase; no paid purchases are active.",
		12,
		C.muted,
		UDim2.fromOffset(0, 212 + #self.config.zones * 33),
		UDim2.new(1, -10, 0, 70)
	)
	footer.TextWrapped = true
end

function Hud:_buildSettings()
	local page = self.pages.Settings
	self.motionButton = self:_button(
		page,
		"REDUCED MOTION: OFF",
		C.mint,
		UDim2.fromOffset(2, 5),
		UDim2.new(1, -12, 0, 52),
		function()
			self.reducedMotion = not self.reducedMotion
			self.motionButton.Text = "REDUCED MOTION: " .. (if self.reducedMotion then "ON" else "OFF")
			if self.reducedMotion and self.revealTween then
				self.revealTween:Cancel()
				self.revealTween = nil
				self.revealScale.Scale = 1
			end
		end
	)
	self.effectsButton = self:_button(
		page,
		"VISUAL EFFECTS: ON",
		C.lilac,
		UDim2.fromOffset(2, 72),
		UDim2.new(1, -12, 0, 52),
		function()
			self.effects = not self.effects
			self.effectsButton.Text = "VISUAL EFFECTS: " .. (if self.effects then "ON" else "OFF")
		end
	)
	local details = label(
		page,
		"Reduced motion stops idle bobbing and reveal animation.\n\nVisual effects controls decorative animal motion.\n\nNo background music. This prototype has no audio assets.\n\nSettings and progress last for this session only.",
		14,
		C.muted,
		UDim2.fromOffset(2, 143),
		UDim2.new(1, -12, 0, 186)
	)
	details.TextWrapped = true
	details.TextYAlignment = Enum.TextYAlignment.Top
end

function Hud:_buildReveal()
	self.revealOverlay = make("Frame", {
		Name = "HatchReveal",
		BackgroundColor3 = C.ink,
		BackgroundTransparency = 0.38,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 60,
		Active = true,
	}, self.root)
	self.revealCard =
		panel(self.revealOverlay, "NewFriend", C.paper, UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(400, 400))
	self.revealCard.AnchorPoint = Vector2.new(0.5, 0.5)
	self.revealScale = make("UIScale", { Scale = 1 }, self.revealCard)
	local title = label(
		self.revealCard,
		"YOU HATCHED A FRIEND!",
		15,
		C.muted,
		UDim2.new(0, 16, 0, 19),
		UDim2.new(1, -32, 0, 26),
		true
	)
	title.TextXAlignment = Enum.TextXAlignment.Center
	self.revealArt =
		eggArt(self.revealCard, UDim2.new(0.5, -50, 0.17, 0), UDim2.fromOffset(100, 105), C.yellow, false)
	self.revealName =
		label(self.revealCard, "", 24, C.ink, UDim2.new(0, 18, 0.46, 0), UDim2.new(1, -36, 0, 44), true)
	self.revealName.TextWrapped = true
	self.revealName.TextXAlignment = Enum.TextXAlignment.Center
	self.revealRarity =
		label(self.revealCard, "", 15, C.ink, UDim2.new(0, 18, 0.58, 0), UDim2.new(1, -36, 0, 26), true)
	self.revealRarity.TextXAlignment = Enum.TextXAlignment.Center
	self.revealIncome =
		label(self.revealCard, "", 16, C.ink, UDim2.new(0, 18, 0.67, 0), UDim2.new(1, -36, 0, 23), true)
	self.revealIncome.TextXAlignment = Enum.TextXAlignment.Center
	self.revealNote =
		label(self.revealCard, "", 11, C.muted, UDim2.new(0, 18, 0.74, 0), UDim2.new(1, -36, 0, 27))
	self.revealNote.TextWrapped = true
	self.revealNote.TextXAlignment = Enum.TextXAlignment.Center
	self:_button(
		self.revealCard,
		"NICE!",
		C.yellow,
		UDim2.new(0.5, -75, 1, -61),
		UDim2.fromOffset(150, 44),
		function()
			self.revealOverlay.Visible = false
		end
	)
end

function Hud:update(state)
	if self.destroyed or type(state) ~= "table" then
		return
	end
	self.state = state
	self.statValues[1].Text = "$" .. cash(state.cash)
	self.statValues[2].Text = "+$" .. cash(state.income)
	self.statValues[3].Text = "LV " .. tostring(state.speedLevel or 0)
	local cost = state.upgradeCost
	local upgradeText = if cost then "SPEED UP · $" .. cash(cost) else "SPEED MAXED!"
	self.upgrade.Text = upgradeText
	self.shopUpgrade.Text = upgradeText
	self.upgrade.BackgroundColor3 = if cost and (state.cash or 0) >= cost
		then C.lilac
		else Color3.fromRGB(214, 204, 235)
	self.shopUpgrade.BackgroundColor3 = self.upgrade.BackgroundColor3
	self.shopSpeed.Text = string.format(
		"Level %d / %d  ·  Movement speed %d",
		state.speedLevel or 0,
		self.config.speed.maxLevel,
		state.walkSpeed or self.config.speed.base
	)
	self.deposit.Visible = state.carrying ~= nil
	if state.carrying then
		local zone = self.zoneById[state.carrying]
		self.missionHeading.Text = "EGG ON BOARD · RUN HOME!"
		self.missionText.Text = "Bring your "
			.. (if zone then zone.name else "stolen")
			.. " egg to base "
			.. tostring(state.baseId or "")
			.. ". Deposit it at your nest."
		self.mission.BackgroundColor3 = C.yellow
	else
		self.missionHeading.Text = "BASE " .. tostring(state.baseId or "?") .. " · YOUR NEXT ADVENTURE"
		self.missionText.Text = state.tutorial or "Follow the path. Approach an egg and use its steal prompt!"
		self.mission.BackgroundColor3 = C.paper
	end
	local lines = {}
	for _, zone in ipairs(self.config.zones) do
		local unlocked = (state.speedLevel or 0) >= zone.requiredLevel
		table.insert(
			lines,
			(if unlocked then "OPEN  " else "LOCKED  ")
				.. zone.name
				.. " · speed level "
				.. tostring(zone.requiredLevel)
		)
	end
	self.zoneGuide.Text = table.concat(lines, "\n")
	local owned = {}
	for _, animal in ipairs(state.animals or {}) do
		owned[animal.id] = (owned[animal.id] or 0) + 1
	end
	local found, total = 0, 0
	for id, card in pairs(self.collectionCards) do
		total += 1
		local discovered = (state.discovered or {})[id] == true
		local animal = self.config.animals[id]
		if discovered then
			found += 1
		end
		card.name.Text = if discovered then animal.name else "???"
		card.income.Text = if discovered
			then "$" .. cash(animal.income) .. "/s · owned " .. tostring(owned[id] or 0)
			else "Not discovered"
		card.frame.BackgroundColor3 = if discovered
			then tint(self.config.rarities[animal.rarity].color):Lerp(C.paper, 0.76)
			else Color3.fromRGB(243, 240, 247)
		if discovered and not card.discovered then
			card.art:Destroy()
			card.art = animalArt(card.frame, UDim2.fromOffset(7, 19), UDim2.fromOffset(52, 64), animal)
			card.discovered = true
		end
	end
	self.collectionCount.Text = string.format(
		"%d / %d discovered · %d / %d animal spaces",
		found,
		total,
		#(state.animals or {}),
		self.config.maxAnimals
	)
	self:_tick()
end

function Hud:_tick()
	if self.destroyed then
		return
	end
	local now = os.clock()
	self.noticeFrame.Visible = now < self.noticeUntil
	if self.revealOverlay.Visible and now >= self.revealUntil then
		self.revealOverlay.Visible = false
	end
	local bySlot = {}
	for _, hatch in ipairs(if self.state then self.state.hatches or {} else {}) do
		bySlot[hatch.slot] = hatch
	end
	local serverNow = Workspace:GetServerTimeNow()
	for index, slot in ipairs(self.slotLabels) do
		local hatch = bySlot[index]
		if hatch then
			local remaining = math.max(0, math.ceil(hatch.readyAt - serverNow))
			slot.Text = if remaining > 0 then "EGG · " .. tostring(remaining) .. "s" else "Hatching!"
			slot.TextColor3 = C.ink
		else
			slot.Text = "○ Empty"
			slot.TextColor3 = C.muted
		end
	end
end

function Hud:notice(payload)
	if self.destroyed or type(payload) ~= "table" then
		return
	end
	self.noticeText.Text = tostring(payload.text or "")
	self.noticeFrame.BackgroundColor3 = if payload.kind == "error"
		then C.pink
		elseif payload.kind == "success" then C.mint
		else C.yellow
	self.noticeUntil = os.clock() + 4
	self.noticeFrame.Visible = true
end

function Hud:reveal(payload)
	if self.destroyed or type(payload) ~= "table" then
		return
	end
	local animal = self.config.animals[payload.animalId]
	if not animal then
		return
	end
	local rarity = self.config.rarities[animal.rarity]
	self.revealName.Text = animal.name
	self.revealRarity.Text = string.upper(animal.rarity)
	self.revealRarity.TextColor3 = tint(rarity.color):Lerp(C.ink, 0.28)
	self.revealIncome.Text = "$" .. cash(payload.income or animal.income) .. "/s animal income"
	self.revealNote.Text = if payload.kept == false
		then "Discovered! Your eight higher earners stayed on display."
		elseif payload.replacedName then "Replaced " .. payload.replacedName .. " in your full collection."
		else animal.personality or "Your newest nest mate!"
	self.revealCard.BackgroundColor3 = tint(rarity.color):Lerp(C.paper, 0.87)
	self.revealArt:Destroy()
	self.revealArt =
		animalArt(self.revealCard, UDim2.new(0.5, -50, 0.17, 0), UDim2.fromOffset(100, 105), animal)
	self.revealOverlay.Visible = true
	self.revealUntil = os.clock() + 8
	if self.revealTween then
		self.revealTween:Cancel()
		self.revealTween = nil
	end
	if not self.reducedMotion and self.effects then
		self.revealScale.Scale = 0.84
		self.revealTween = TweenService:Create(
			self.revealScale,
			TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }
		)
		self.revealTween:Play()
	else
		self.revealScale.Scale = 1
	end
end

function Hud:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	if self.revealTween then
		self.revealTween:Cancel()
	end
	self.gui:Destroy()
end

return Hud
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">GoofyEgg</string>
        </Properties>
        <Item class="LocalScript" referent="25">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Presentation only. The server owns cash, movement levels, catches, and hatch results.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local connections = {}
local animated = {}
local countdowns = {}
local guardians = {}
local closed = false
local receivedState = false
local hud

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function required(parent, name)
	local child = parent:WaitForChild(name, 25)
	assert(child, "Missing " .. parent:GetFullName() .. "." .. name)
	return child
end

local function showBootstrapError()
	local screen = Instance.new("ScreenGui")
	screen.Name = "GoofyEggStartupError"
	screen.ResetOnSpawn = false
	screen.Parent = playerGui
	local text = Instance.new("TextLabel")
	text.AnchorPoint = Vector2.new(0.5, 0)
	text.Position = UDim2.new(0.5, 0, 0, 70)
	text.Size = UDim2.new(0.9, 0, 0, 94)
	text.BackgroundColor3 = Color3.fromRGB(255, 216, 105)
	text.TextColor3 = Color3.fromRGB(39, 37, 63)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 17
	text.TextWrapped = true
	text.Text =
		"Your goofy world could not finish loading. Rejoin to try again.\nIn Studio, check Output for the missing setup item."
	text.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = text
end

local ok, problem = pcall(function()
	local packageFolder = required(ReplicatedStorage, "GoofyEgg")
	local config = require(required(required(packageFolder, "Shared"), "Config"))
	local Hud = require(required(required(playerGui, "GoofyUI"), "Hud"))
	local remotes = required(packageFolder, "Remotes")
	local stateRemote = required(remotes, "State")
	local actionRemote = required(remotes, "Action")
	local noticeRemote = required(remotes, "Notice")
	local hatchRemote = required(remotes, "Hatch")
	local getState = required(remotes, "GetState")

	hud = Hud.new(config, {
		action = function(action)
			if not closed and (action == "UpgradeSpeed" or action == "DepositEgg") then
				actionRemote:FireServer(action)
			end
		end,
	})
	-- Subscribe first so a live server update cannot be missed during the initial request.
	connect(stateRemote.OnClientEvent, function(state)
		if not closed and type(state) == "table" then
			receivedState = true
			hud:update(state)
		end
	end)
	connect(noticeRemote.OnClientEvent, function(payload)
		if not closed then
			hud:notice(payload)
		end
	end)
	connect(hatchRemote.OnClientEvent, function(payload)
		if not closed then
			hud:reveal(payload)
		end
	end)

	task.spawn(function()
		local success, initial = pcall(function()
			return getState:InvokeServer()
		end)
		if closed then
			return
		end
		if success and type(initial) == "table" then
			-- A periodic live update may have arrived while InvokeServer was in flight.
			if not receivedState then
				receivedState = true
				hud:update(initial)
			end
		elseif not receivedState then
			hud:notice({ text = "Your base is still loading. Waiting for the server...", kind = "info" })
		end
	end)
	task.delay(15, function()
		if not closed and not receivedState then
			hud:notice({
				text = "Still waiting for a base. If this continues, rejoin the server.",
				kind = "error",
			})
		end
	end)
end)

if not ok then
	warn("Goofy Egg client setup failed: " .. tostring(problem))
	if hud then
		hud:destroy()
	end
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	closed = true
	showBootstrapError()
	return
end

local function observe(instance)
	if not instance:IsA("Model") then
		return
	end
	if instance:GetAttribute("VisualRole") == "Animal" then
		-- Only static collection models bob. Never move a server-controlled guardian here.
		animated[instance] =
			{ origin = instance:GetPivot(), phase = math.random() * math.pi * 2, moved = false }
	elseif instance:GetAttribute("VisualRole") == "Guardian" then
		guardians[instance] = true
	end
	if type(instance:GetAttribute("ReadyAt")) == "number" then
		countdowns[instance] = true
	end
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
	observe(descendant)
end
connect(Workspace.DescendantAdded, function(instance)
	-- Builders set model attributes and parents in the same task; defer until they finish.
	task.defer(function()
		if not closed and instance.Parent then
			observe(instance)
		end
	end)
end)
connect(Workspace.DescendantRemoving, function(instance)
	animated[instance] = nil
	countdowns[instance] = nil
	guardians[instance] = nil
end)

local accumulated = 0
local countdownElapsed = 0
connect(RunService.Heartbeat, function(dt)
	if closed then
		return
	end
	accumulated += dt
	countdownElapsed += dt
	-- Decorative world updates are capped at 20Hz, keeping mobile cost predictable.
	if accumulated >= 0.05 then
		accumulated = 0
		local active = hud.effects and not hud.reducedMotion
		local now = os.clock()
		local camera = Workspace.CurrentCamera
		for model, entry in pairs(animated) do
			if not model.Parent then
				animated[model] = nil
			elseif active and camera and (entry.origin.Position - camera.CFrame.Position).Magnitude < 160 then
				local wave = math.sin(now * 2.1 + entry.phase)
				model:PivotTo(
					entry.origin * CFrame.new(0, wave * 0.12, 0) * CFrame.Angles(0, 0, wave * 0.035)
				)
				entry.moved = true
			elseif entry.moved then
				model:PivotTo(entry.origin)
				entry.moved = false
			end
		end
	end
	if countdownElapsed >= 0.25 then
		countdownElapsed = 0
		local serverNow = Workspace:GetServerTimeNow()
		for model in pairs(countdowns) do
			local readyAt = model:GetAttribute("ReadyAt")
			if not model.Parent or type(readyAt) ~= "number" then
				countdowns[model] = nil
			else
				local countdown = model:FindFirstChild("Countdown", true)
				if countdown and countdown:IsA("TextLabel") then
					local remaining = math.max(0, math.ceil(readyAt - serverNow))
					countdown.Text = if remaining > 0 then "Hatching · " .. remaining .. "s" else "Hatching!"
				end
			end
		end
		for model in pairs(guardians) do
			if not model.Parent then
				guardians[model] = nil
			else
				local stateLabel = model:FindFirstChild("State", true)
				if stateLabel and stateLabel:IsA("TextLabel") then
					stateLabel.Text = if model:GetAttribute("Chasing")
						then "HEY! THAT'S MY EGG!"
						else "Keeping one eye on the nest..."
				end
			end
		end
	end
end)

connect(script.Destroying, function()
	closed = true
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	for model, entry in pairs(animated) do
		if model.Parent and entry.moved then
			model:PivotTo(entry.origin)
		end
	end
	table.clear(animated)
	table.clear(countdowns)
	table.clear(guardians)
	hud:destroy()
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="26">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-80</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
