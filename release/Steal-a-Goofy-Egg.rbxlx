        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
local Config = if script then require(script.Parent.Config) else require("./Config")

export type OwnedAnimal = { id: string }

local Economy = {}

local function finite(value: number): boolean
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function positiveInteger(value: number): boolean
	return finite(value) and value > 0 and value % 1 == 0
end

local function checkLevel(level: number)
	assert(
		finite(level) and level % 1 == 0 and level >= 0 and level <= Config.speed.maxLevel,
		"Invalid speed level"
	)
end

local function checkRoll(roll: number)
	assert(finite(roll) and roll >= 0 and roll < 1, "Roll must be a finite number in [0, 1)")
end

local function getAnimal(animalId: string)
	local animal = Config.animals[animalId]
	assert(animal ~= nil, "Unknown animal: " .. tostring(animalId))
	return animal
end

local function orderedRarities(): { string }
	local result = {}
	for name in Config.rarities do
		table.insert(result, name)
	end
	table.sort(result, function(a, b)
		return Config.rarities[a].order < Config.rarities[b].order
	end)
	return result
end

function Economy.walkSpeed(level: number): number
	checkLevel(level)
	return Config.speed.base + Config.speed.perLevel * level
end

function Economy.upgradeCost(level: number): number?
	checkLevel(level)
	if level == Config.speed.maxLevel then
		return nil
	end
	return math.floor(Config.speed.baseCost * Config.speed.costGrowth ^ level)
end

function Economy.getZone(zoneId: string): typeof(Config.zones[1])?
	for _, zone in Config.zones do
		if zone.id == zoneId then
			return zone
		end
	end
	return nil
end

function Economy.rollAnimal(zoneId: string, rarityRoll: number, animalRoll: number): string
	checkRoll(rarityRoll)
	checkRoll(animalRoll)
	local zone = Economy.getZone(zoneId)
	assert(zone ~= nil, "Unknown zone: " .. tostring(zoneId))
	local threshold = rarityRoll * 100
	local cumulative = 0
	local selectedRarity: string? = nil
	for _, rarity in orderedRarities() do
		local weight = zone.weights[rarity] or 0
		cumulative += weight
		if weight > 0 and threshold < cumulative then
			selectedRarity = rarity
			break
		end
	end
	assert(selectedRarity ~= nil, "Zone rarity weights do not cover this roll")
	local candidates = {}
	for id, animal in Config.animals do
		if animal.rarity == selectedRarity then
			table.insert(candidates, id)
		end
	end
	table.sort(candidates)
	assert(#candidates > 0, "Selected rarity has no animals")
	return candidates[math.floor(animalRoll * #candidates) + 1]
end

function Economy.income(animals: { OwnedAnimal }): number
	local total = 0
	for _, owned in animals do
		total += getAnimal(owned.id).income
	end
	return total
end

function Economy.addAnimal(animals: { OwnedAnimal }, animalId: string): ({ OwnedAnimal }, string?, boolean)
	local incoming = getAnimal(animalId)
	assert(#animals <= Config.maxAnimals, "Animal capacity already exceeded")
	local result = table.clone(animals)
	local weakestIndex = 1
	local weakestIncome = math.huge
	for index, owned in animals do
		local value = getAnimal(owned.id).income
		if value < weakestIncome then
			weakestIndex = index
			weakestIncome = value
		end
	end
	if #result < Config.maxAnimals then
		table.insert(result, { id = animalId })
		return result, nil, true
	end
	if incoming.income > weakestIncome then
		local replacedId = result[weakestIndex].id
		result[weakestIndex] = { id = animalId }
		return result, replacedId, true
	end
	return result, nil, false
end

function Economy.validateConfig(): boolean
	assert(finite(Config.startCash) and Config.startCash >= 0, "Starting cash must be nonnegative")
	assert(positiveInteger(Config.hatchSlots), "Hatch slots must be a positive integer")
	assert(positiveInteger(Config.maxAnimals), "Animal capacity must be a positive integer")
	assert(Config.hatchSlots <= Config.maxAnimals, "Hatch slots exceed animal capacity")
	assert(#Config.basePositions >= 1, "At least one base is required")
	local positions = {}
	for _, position in Config.basePositions do
		assert(finite(position.x) and finite(position.z), "Base coordinates must be finite")
		local key = tostring(position.x) .. ":" .. tostring(position.z)
		assert(not positions[key], "Duplicate base position")
		positions[key] = true
	end
	assert(finite(Config.speed.base) and Config.speed.base > 0, "Base speed must be positive")
	assert(finite(Config.speed.perLevel) and Config.speed.perLevel > 0, "Speed increase must be positive")
	assert(positiveInteger(Config.speed.maxLevel), "Maximum speed level must be a positive integer")
	assert(positiveInteger(Config.speed.baseCost), "Base upgrade cost must be a positive integer")
	assert(finite(Config.speed.costGrowth) and Config.speed.costGrowth > 1, "Upgrade costs must grow")
	assert(
		finite(Config.speed.baseCost * Config.speed.costGrowth ^ Config.speed.maxLevel),
		"Upgrade cost overflow"
	)

	local orders = {}
	local population: { [string]: number } = {}
	for rarity, definition in Config.rarities do
		assert(
			positiveInteger(definition.order) and not orders[definition.order],
			"Rarity orders must be unique"
		)
		orders[definition.order] = true
		population[rarity] = 0
	end
	for id, animal in Config.animals do
		assert(id == animal.id, "Animal key and ID must match")
		assert(population[animal.rarity] ~= nil, "Unknown animal rarity")
		assert(finite(animal.income) and animal.income > 0, "Animal income must be positive")
		population[animal.rarity] += 1
	end
	assert(#Config.zones > 0, "At least one zone is required")
	local zoneIds = {}
	for _, zone in Config.zones do
		assert(zone.id ~= "" and not zoneIds[zone.id], "Zone IDs must be nonempty and unique")
		zoneIds[zone.id] = true
		assert(finite(zone.position.x) and finite(zone.position.z), "Zone coordinates must be finite")
		assert(finite(zone.guardianOffset) and zone.guardianOffset > 0, "Guardian offset must be positive")
		assert(finite(zone.guardianSpeed) and zone.guardianSpeed > 0, "Guardian speed must be positive")
		assert(finite(zone.arenaHalfWidth) and zone.arenaHalfWidth > 0, "Arena width must be positive")
		assert(finite(zone.arenaHalfDepth) and zone.arenaHalfDepth > 0, "Arena depth must be positive")
		assert(zone.guardianOffset < zone.arenaHalfWidth, "Guardian home must be inside its arena")
		assert(finite(zone.wakeSeconds) and zone.wakeSeconds >= 0, "Wake time must be nonnegative")
		checkLevel(zone.requiredLevel)
		assert(finite(zone.hatchSeconds) and zone.hatchSeconds > 0, "Hatch time must be positive")
		assert(finite(zone.cooldownSeconds) and zone.cooldownSeconds >= 0, "Cooldown must be nonnegative")
		local total = 0
		for rarity, weight in zone.weights do
			assert(population[rarity] ~= nil, "Zone has an unknown rarity")
			assert(finite(weight) and weight >= 0, "Rarity weights must be finite and nonnegative")
			assert(weight == 0 or population[rarity] > 0, "Positive rarity weight has no animals")
			total += weight
		end
		assert(math.abs(total - 100) < 1e-9, "Zone rarity weights must sum to 100")
	end
	return true
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">PetMotion</string>
            <string name="Source"><![CDATA[--!strict
-- Pure presentation math: every client samples the same pet route from server
-- time. No pathfinding, physics, economic state, or movement remotes are needed.
local PetMotion = {}

export type Leg = {
	x: number,
	z: number,
	dx: number,
	dz: number,
	heading: number,
	previousHeading: number,
	pause: number,
	travel: number,
	start: number,
}
export type Plan = {
	legs: { Leg },
	duration: number,
	phase: number,
	speed: number,
}
export type Sample = {
	x: number,
	z: number,
	heading: number,
	speed: number,
	stride: number,
	walking: boolean,
}

local speeds: { [string]: number } = {
	turtle = 1.8,
	rabbit = 3.7,
	frog = 3.1,
	duck = 2.7,
	penguin = 2.4,
	cat = 3.2,
	dinosaur = 2.6,
}

local function finite(value: number): boolean
	return value == value and value > -math.huge and value < math.huge
end

local function smooth(value: number): number
	return value * value * (3 - 2 * value)
end

local function angleBetween(a: number, b: number): number
	return (b - a + math.pi) % (math.pi * 2) - math.pi
end

function PetMotion.new(seed: number, halfX: number, halfZ: number, species: string): Plan
	assert(finite(seed) and seed % 1 == 0, "Pet seed must be a finite integer")
	assert(finite(halfX) and finite(halfZ) and halfX > 0 and halfZ > 0, "Pet bounds must be positive")
	-- Park-Miller stays below double-precision's exact integer limit. This avoids
	-- depending on engine RNG state or frame history when a client joins later.
	local state = math.abs(seed) % 2147483646 + 1
	local function random(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
	for _ = 1, 3 do
		random()
	end
	local points: { { x: number, z: number, pause: number } } = {}
	for _ = 1, 9 do
		table.insert(points, {
			x = (random() * 2 - 1) * halfX * 0.86,
			z = (random() * 2 - 1) * halfZ * 0.86,
			pause = 1.3 + random() * (if species == "turtle" then 3.6 else 2.5),
		})
	end
	local speed = speeds[species] or 2.7
	local legs: { Leg } = {}
	local duration = 0
	for index, point in ipairs(points) do
		local nextPoint = points[index % #points + 1]
		local dx, dz = nextPoint.x - point.x, nextPoint.z - point.z
		local distance = math.sqrt(dx * dx + dz * dz)
		-- Cubic interpolation peaks at 1.5 times its average speed.
		local travel = math.max(1.2, distance * 1.5 / speed)
		table.insert(legs, {
			x = point.x,
			z = point.z,
			dx = dx,
			dz = dz,
			heading = math.atan2(-dx, -dz), -- Models face local -Z.
			previousHeading = 0,
			pause = point.pause,
			travel = travel,
			start = duration,
		})
		duration += point.pause + travel
	end
	for index, leg in ipairs(legs) do
		leg.previousHeading = legs[(index - 2) % #legs + 1].heading
	end
	return { legs = legs, duration = duration, phase = random() * duration, speed = speed }
end

function PetMotion.sample(plan: Plan, now: number): Sample
	assert(finite(now), "Pet animation time must be finite")
	local cycle = (now + plan.phase) % plan.duration
	local leg = plan.legs[#plan.legs]
	for _, candidate in ipairs(plan.legs) do
		if cycle < candidate.start + candidate.pause + candidate.travel then
			leg = candidate
			break
		end
	end
	local elapsed = cycle - leg.start
	local progress = math.clamp((elapsed - leg.pause) / leg.travel, 0, 1)
	local distance = math.sqrt(leg.dx * leg.dx + leg.dz * leg.dz)
	local speed = distance * 6 * progress * (1 - progress) / leg.travel
	-- Look around during the pause, then face the next destination before moving.
	local turn = smooth(math.clamp(elapsed / math.min(1.2, leg.pause), 0, 1))
	local heading = leg.previousHeading + angleBetween(leg.previousHeading, leg.heading) * turn
	local fraction = smooth(progress)
	return {
		x = leg.x + leg.dx * fraction,
		z = leg.z + leg.dz * fraction,
		heading = heading,
		speed = speed,
		stride = distance * fraction,
		walking = speed > 0.05,
	}
end

return PetMotion
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">GoofyEgg</string>
      </Properties>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- All rewards, balances, egg ownership, upgrades, and chase decisions live on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local shared = ReplicatedStorage:WaitForChild("GoofyEgg"):WaitForChild("Shared")
local remotes = ReplicatedStorage.GoofyEgg.Remotes
local Config = require(shared.Config)
local Economy = require(shared.Economy)
local ChaseRules = require(shared.ChaseRules)
local AnimalFactory = require(shared.AnimalFactory)
local Session = require(script.Parent.Session)
local World = require(script.Parent.World)

Economy.validateConfig()
local world = World.build(Config)
local rng = Random.new()
local sessions = {}
local owners = {}
local guardians = {}
local connections = {}
local lastAction = {}
local lastRead = {}
local motion = {}
local characterConnections = {}
local carryModels = {}
local shuttingDown = false
local checkMotion

local function clock()
	return Workspace:GetServerTimeNow()
end

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function notice(player, text, kind, sound)
	remotes.Notice:FireClient(player, { text = text, kind = kind or "info", sound = sound })
end

local function body(player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function near(player, position, distance)
	if checkMotion and not checkMotion(player, clock()) then
		return false
	end
	local root = body(player)
	return root ~= nil and (root.Position - position).Magnitude <= distance
end

local function send(player)
	local session = sessions[player]
	if not session then
		return
	end
	local snapshot = session:snapshot()
	local leaderboard = player:FindFirstChild("leaderstats")
	if leaderboard then
		leaderboard.Cash.Value = math.floor(snapshot.cash)
		leaderboard.Speed.Value = snapshot.speedLevel
	end
	remotes.State:FireClient(player, snapshot)
end

local function clearCarry(player)
	local model = carryModels[player]
	if model then
		model:Destroy()
		carryModels[player] = nil
	end
end

local function showCarry(player, zone)
	clearCarry(player)
	local root = body(player)
	if not root then
		return
	end
	local model = AnimalFactory.egg(zone.color, "CarriedEgg")
	model:PivotTo(root.CFrame * CFrame.new(0, 1, -2.8))
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.Massless = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
	end
	model.Parent = player.Character
	carryModels[player] = model
end

local function setGuardianState(guardian, state)
	guardian.state = state
	guardian.world.guardian:SetAttribute("State", state)
	guardian.world.guardian:SetAttribute("Chasing", state == "Chasing")
end

local function endChase(player)
	for _, guardian in guardians do
		if guardian.target == player then
			guardian.target = nil
			setGuardianState(guardian, "Returning")
		end
	end
end

local function resetMotion(player)
	local root = body(player)
	motion[player] = if root then { position = root.Position, time = clock(), credit = 8 } else nil
end

local function returnHome(player)
	local session = sessions[player]
	local root = body(player)
	if session and root then
		player.Character:PivotTo(world.bases[session.baseId].spawn)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		resetMotion(player)
	end
end

local function loseEgg(player, message, teleport, sound)
	local session = sessions[player]
	if not session then
		return
	end
	local hadEgg = session:loseCarry() ~= nil
	clearCarry(player)
	endChase(player)
	if teleport then
		returnHome(player)
	end
	if message and hadEgg then
		notice(player, message, "warning", sound)
	end
	send(player)
end

local function deposit(player)
	local session = sessions[player]
	if not session or not session.carrying then
		return
	end
	local base = world.bases[session.baseId]
	if not near(player, base.depositPrompt.Parent.Position, 14) then
		return
	end
	local hatch = session:deposit(clock())
	if not hatch then
		notice(player, "All hatch slots are busy!", "warning", "denied")
		return
	end
	clearCarry(player)
	endChase(player)
	world:showHatch(session.baseId, hatch.slot, hatch.zoneId, hatch.readyAt)
	notice(player, "Safe at home! Your egg is hatching.", "success", "deposit")
	send(player)
end

local function upgrade(player)
	local session = sessions[player]
	if not session or not body(player) then
		return
	end
	local ok, reason = session:upgrade()
	if ok then
		local _, humanoid = body(player)
		humanoid.WalkSpeed = Economy.walkSpeed(session.speedLevel)
		notice(player, "Speed level " .. session.speedLevel .. "!", "success", "upgrade")
	else
		notice(player, reason, "warning", "denied")
	end
	send(player)
end

local function permitted(player)
	local now = clock()
	if now - (lastAction[player] or -math.huge) < 0.25 then
		return false
	end
	lastAction[player] = now
	return sessions[player] ~= nil
end

for _, zone in Config.zones do
	local zoneWorld = world.zones[zone.id]
	local size = zoneWorld.guardian:GetExtentsSize()
	-- Keep the entire animated silhouette inside the red perimeter, not just its pivot.
	local guardian = {
		world = zoneWorld,
		state = "Idle",
		target = nil,
		readyAt = 0,
		startedAt = 0,
		inset = math.sqrt(size.X * size.X + size.Z * size.Z) * 0.5 + 0.5,
	}
	guardians[zone.id] = guardian
	setGuardianState(guardian, "Idle")
	connect(zoneWorld.prompt.Triggered, function(player)
		if not permitted(player) or guardian.state ~= "Idle" then
			return
		end
		-- Triggered can be forged by exploit clients; check actual alive character and egg distance.
		if not near(player, zoneWorld.egg:GetPivot().Position, 13) then
			return
		end
		local root = body(player)
		if not root or not ChaseRules.inside(zone, root.Position.X, root.Position.Z) then
			return
		end
		local session = sessions[player]
		local ok, reason = session:steal(zone.id)
		if not ok then
			notice(player, reason, "warning", "denied")
			return
		end
		setGuardianState(guardian, "Chasing")
		guardian.target = player
		guardian.startedAt = clock()
		world:setEggAvailable(zone.id, false)
		showCarry(player, zone)
		notice(player, "The " .. zone.guardian .. " woke up! Cross the red line!", "warning", "steal")
		send(player)
	end)
end

for _, base in world.bases do
	connect(base.depositPrompt.Triggered, function(player)
		local session = sessions[player]
		if session and session.baseId == base.id and permitted(player) then
			deposit(player)
		end
	end)
	connect(base.upgradePrompt.Triggered, function(player)
		local session = sessions[player]
		if
			session
			and session.baseId == base.id
			and permitted(player)
			and near(player, base.upgradePrompt.Parent.Position, 13)
		then
			upgrade(player)
		end
	end)
end

connect(remotes.Action.OnServerEvent, function(player, action, ...)
	-- Only fixed intents cross this boundary. Never accept prices, results, level, or target users.
	if typeof(action) ~= "string" or select("#", ...) ~= 0 or not permitted(player) then
		return
	end
	if action == "UpgradeSpeed" then
		upgrade(player)
	elseif action == "DepositEgg" then
		deposit(player)
	end
end)

remotes.GetState.OnServerInvoke = function(player, ...)
	if select("#", ...) ~= 0 then
		return nil
	end
	local now = clock()
	if now - (lastRead[player] or -math.huge) < 0.5 then
		return nil
	end
	lastRead[player] = now
	return if sessions[player] then sessions[player]:snapshot() else nil
end

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or not sessions[player] or character ~= player.Character then
		return
	end
	if characterConnections[player] then
		characterConnections[player]:Disconnect()
	end
	humanoid.WalkSpeed = Economy.walkSpeed(sessions[player].speedLevel)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 40
	returnHome(player)
	characterConnections[player] = humanoid.Died:Connect(function()
		loseEgg(player, "Oops! Your egg was lost. Your animals are safe.", false, "catch")
	end)
	send(player)
end

local function addPlayer(player)
	if sessions[player] or shuttingDown then
		return
	end
	local baseId
	for id = 1, #world.bases do
		if not owners[id] then
			baseId = id
			break
		end
	end
	if not baseId then
		player:Kick("All five bases are occupied. Please join another server.")
		return
	end
	owners[baseId] = player
	sessions[player] = Session.new(baseId, Config, Economy)
	world:setBaseOwner(baseId, player)
	local leaderboard = Instance.new("Folder")
	leaderboard.Name = "leaderstats"
	for _, name in { "Cash", "Speed" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = leaderboard
	end
	leaderboard.Parent = player
	-- Keep per-player connections separate so leaving players are not retained by closures.
	local added = player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	local removing = player.CharacterRemoving:Connect(function()
		loseEgg(player, nil, false)
		motion[player] = nil
	end)
	sessions[player].connections = { added, removing }
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

local function removePlayer(player)
	lastAction[player] = nil
	lastRead[player] = nil
	local session = sessions[player]
	if not session then
		return
	end
	clearCarry(player)
	endChase(player)
	for _, connection in session.connections do
		connection:Disconnect()
	end
	if characterConnections[player] then
		characterConnections[player]:Disconnect()
	end
	world:setBaseOwner(session.baseId, nil)
	owners[session.baseId] = nil
	sessions[player] = nil
	lastAction[player] = nil
	lastRead[player] = nil
	motion[player] = nil
	characterConnections[player] = nil
end

-- Conservative displacement budget: limits obvious teleports/speed edits during egg runs.
-- This supplements server distance/ownership checks; Studio latency testing is still required.
checkMotion = function(player, now)
	local root, humanoid = body(player)
	local session = sessions[player]
	if not root or not session then
		return false
	end
	local speed = Economy.walkSpeed(session.speedLevel)
	humanoid.WalkSpeed = speed
	local previous = motion[player]
	if not previous then
		resetMotion(player)
		return true
	end
	local elapsed = now - previous.time
	local distance = flatDistance(root.Position, previous.position)
	local available = previous.credit + speed * 1.2 * elapsed
	local invalid = distance ~= distance
		or distance == math.huge
		or distance > available
		or root.Position.Y ~= root.Position.Y
		or root.Position.Y > 40
		or root.Position.Y < -20
	if invalid then
		loseEgg(player, "Your egg run reset after unexpected movement. Your animals are safe.", true)
		return false
	else
		previous.credit = math.min(8, available - distance)
		previous.position = root.Position
		previous.time = now
	end
	return true
end

local function moveGuardian(guardian, targetPosition, speed, dt, now)
	local model = guardian.world.guardian
	local from = model:GetPivot().Position
	local zone = guardian.world.config
	local x, z = ChaseRules.clampPosition(zone, targetPosition.X, targetPosition.Z, guardian.inset)
	if not x or not z then
		return math.huge
	end
	local destination = Vector3.new(x, guardian.world.home.Position.Y, z)
	local delta = destination - Vector3.new(from.X, destination.Y, from.Z)
	local distance = delta.Magnitude
	if distance > 0.05 then
		local position = Vector3.new(from.X, destination.Y, from.Z)
			+ delta.Unit * math.min(distance, speed * dt)
		local boundedX, boundedZ = ChaseRules.clampPosition(zone, position.X, position.Z, guardian.inset)
		if not boundedX or not boundedZ then
			return math.huge
		end
		position = Vector3.new(boundedX, destination.Y, boundedZ)
		-- Tiny procedural bounce makes the original part animal waddle without physics overhead.
		position += Vector3.new(0, math.abs(math.sin(now * 9)) * 0.18, 0)
		model:PivotTo(CFrame.lookAt(position, position + delta.Unit))
	end
	return distance
end

local lastEconomy = clock()
local accumulated = 0
connect(RunService.Heartbeat, function(dt)
	if shuttingDown then
		return
	end
	accumulated += dt
	if accumulated < 0.1 then
		return
	end
	local step = math.min(accumulated, 0.25)
	accumulated = 0
	local now = clock()
	for player, session in sessions do
		checkMotion(player, now)
		if session.carrying then
			deposit(player)
		end
	end
	for zoneId, guardian in guardians do
		local zone = guardian.world.config
		if guardian.state == "Chasing" then
			local player = guardian.target
			local session = sessions[player]
			local root = player and body(player)
			if not root or not session or session.carrying ~= zoneId then
				guardian.target = nil
				setGuardianState(guardian, "Returning")
			elseif not ChaseRules.inside(zone, root.Position.X, root.Position.Z) then
				-- Release BEFORE moving or checking catches: the red perimeter is a safe exit.
				-- A secured egg stays in the player's hands, and re-entering cannot rearm this chase.
				guardian.target = nil
				setGuardianState(guardian, "Returning")
				if session:markEscaped(zoneId) then
					notice(
						player,
						"Escaped! Bring your egg home to base " .. session.baseId .. ".",
						"success",
						"escape"
					)
					send(player)
				end
			elseif now - guardian.startedAt > 60 then
				loseEgg(player, "The guardian reclaimed its egg. Try a quicker route!", true, "catch")
			elseif now - guardian.startedAt >= zone.wakeSeconds then
				moveGuardian(guardian, root.Position, zone.guardianSpeed, step, now)
				if flatDistance(guardian.world.guardian:GetPivot().Position, root.Position) < 4.5 then
					loseEgg(player, "Caught! Your egg is gone, but your animals are safe.", true, "catch")
				end
			end
		elseif guardian.state == "Returning" then
			if
				moveGuardian(guardian, guardian.world.home.Position, zone.guardianSpeed * 1.5, step, now) < 1
			then
				guardian.world.guardian:PivotTo(guardian.world.home)
				setGuardianState(guardian, "Cooldown")
				guardian.readyAt = now + zone.cooldownSeconds
			end
		elseif guardian.state == "Cooldown" and now >= guardian.readyAt then
			setGuardianState(guardian, "Idle")
			world:setEggAvailable(zoneId, true)
		end
	end
	local seconds = math.floor(now - lastEconomy)
	if seconds < 1 then
		return
	end
	lastEconomy += seconds
	for player, session in sessions do
		session:earn(seconds)
		for slot = 1, Config.hatchSlots do
			local result = session:finishHatch(slot, now, rng:NextNumber(), rng:NextNumber())
			if result then
				world:clearHatch(session.baseId, slot)
				world:setAnimals(session.baseId, session.animals)
				local animal = Config.animals[result.animalId]
				remotes.Hatch:FireClient(player, {
					animalId = result.animalId,
					rarity = animal.rarity,
					income = animal.income,
					kept = result.kept,
					replacedName = result.replacedId and Config.animals[result.replacedId].name or nil,
				})
				if not result.kept then
					notice(
						player,
						"Discovered " .. animal.name .. "! Your eight higher earners stayed on display.",
						"info"
					)
				end
			end
		end
		send(player)
	end
end)

connect(Players.PlayerAdded, addPlayer)
connect(Players.PlayerRemoving, removePlayer)
for _, player in Players:GetPlayers() do
	addPlayer(player)
end

game:BindToClose(function()
	shuttingDown = true
	remotes.GetState.OnServerInvoke = nil
	for _, connection in connections do
		connection:Disconnect()
	end
	for player in sessions do
		removePlayer(player)
	end
	world:destroy()
end)

print("Steal a Goofy Egg: garden refinement initialized (five bases, session-only progress, no music).")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[-- Pure session state: synchronous mutations make deposits/hatches exactly-once in this server.
-- Persistence and paid products intentionally belong to later phases.
local Session = {}
Session.__index = Session

function Session.new(baseId, config, economy)
	return setmetatable({
		baseId = baseId,
		cash = config.startCash,
		speedLevel = 0,
		carrying = nil,
		escaped = false,
		hatches = {},
		animals = {},
		discovered = {},
		config = config,
		economy = economy,
	}, Session)
end

function Session:freeSlot()
	for slot = 1, self.config.hatchSlots do
		if self.hatches[slot] == nil then
			return slot
		end
	end
	return nil
end

function Session:steal(zoneId)
	local zone = self.economy.getZone(zoneId)
	if not zone then
		return false, "Unknown zone."
	elseif self.carrying then
		return false, "Take your egg home first!"
	elseif self.speedLevel < zone.requiredLevel then
		return false, "Reach speed level " .. zone.requiredLevel .. " for this zone."
	elseif not self:freeSlot() then
		return false, "Your hatch slots are full. Wait for an egg to hatch."
	end
	self.carrying = zoneId
	self.escaped = false
	return true
end

function Session:markEscaped(zoneId)
	if self.carrying ~= zoneId or self.escaped then
		return false
	end
	self.escaped = true
	return true
end

function Session:deposit(now)
	local slot = self:freeSlot()
	if not self.carrying or not slot then
		return nil
	end
	local zone = self.economy.getZone(self.carrying)
	local hatch = { slot = slot, zoneId = zone.id, readyAt = now + zone.hatchSeconds }
	self.hatches[slot] = hatch
	self.carrying = nil
	self.escaped = false
	return hatch
end

function Session:loseCarry()
	local previous = self.carrying
	self.carrying = nil
	self.escaped = false
	return previous
end

function Session:finishHatch(slot, now, rarityRoll, animalRoll)
	local hatch = self.hatches[slot]
	if not hatch or now < hatch.readyAt then
		return nil
	end
	local animalId = self.economy.rollAnimal(hatch.zoneId, rarityRoll, animalRoll)
	local animals, replacedId, kept = self.economy.addAnimal(self.animals, animalId)
	-- Remove the hatch in the same non-yielding transaction that grants its reward.
	self.hatches[slot] = nil
	self.animals = animals
	self.discovered[animalId] = true
	return { animalId = animalId, replacedId = replacedId, kept = kept }
end

function Session:upgrade()
	local cost = self.economy.upgradeCost(self.speedLevel)
	if not cost then
		return false, "Your speed is already at the maximum!"
	elseif self.cash < cost then
		return false, "You need $" .. cost .. " for the next speed level."
	end
	self.cash -= cost
	self.speedLevel += 1
	return true
end

function Session:earn(seconds)
	assert(seconds >= 0 and seconds % 1 == 0 and seconds < math.huge, "Whole elapsed seconds required")
	self.cash += self.economy.income(self.animals) * seconds
end

function Session:snapshot()
	local hatches = {}
	for slot = 1, self.config.hatchSlots do
		local hatch = self.hatches[slot]
		if hatch then
			table.insert(hatches, table.clone(hatch))
		end
	end
	local animals = {}
	for _, animal in self.animals do
		table.insert(animals, { id = animal.id })
	end
	local nextZone = "All current zones unlocked!"
	for _, zone in self.config.zones do
		if self.speedLevel < zone.requiredLevel then
			nextZone = zone.name .. " unlocks at speed level " .. zone.requiredLevel
			break
		end
	end
	return {
		cash = self.cash,
		income = self.economy.income(self.animals),
		speedLevel = self.speedLevel,
		walkSpeed = self.economy.walkSpeed(self.speedLevel),
		upgradeCost = self.economy.upgradeCost(self.speedLevel),
		baseId = self.baseId,
		carrying = self.carrying,
		escaped = self.escaped,
		hatches = hatches,
		animals = animals,
		discovered = table.clone(self.discovered),
		nextZone = nextZone,
		tutorial = if self.carrying and not self.escaped
			then "Run across the red boundary to escape the guardian!"
			elseif self.carrying then "You escaped! Bring the egg to your own nest."
			elseif
				#self.animals == 0
			then "Take an egg in Turtle Meadow. Cross the red line, then bring it home!"
			else "Your animals earn cash every second. Upgrade speed and try Rabbit Ridge!",
		sessionOnly = true,
	}
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Original garden ranches and guardian courtyards, made entirely from parts.
-- World lettering is attached to physical signs: it never turns with the camera.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnimalFactory =
	require(ReplicatedStorage:WaitForChild("GoofyEgg"):WaitForChild("Shared"):WaitForChild("AnimalFactory"))

local World = {}
World.__index = World

local COLORS = {
	grass = Color3.fromRGB(88, 133, 77),
	lawn = Color3.fromRGB(105, 148, 82),
	path = Color3.fromRGB(177, 151, 112),
	stone = Color3.fromRGB(100, 110, 106),
	stoneLight = Color3.fromRGB(139, 147, 135),
	ink = Color3.fromRGB(34, 52, 47),
	wood = Color3.fromRGB(115, 78, 50),
	woodLight = Color3.fromRGB(158, 112, 69),
	leaf = Color3.fromRGB(58, 109, 69),
	leafLight = Color3.fromRGB(113, 153, 76),
	mint = Color3.fromRGB(113, 184, 137),
	cream = Color3.fromRGB(232, 218, 179),
	gold = Color3.fromRGB(210, 161, 72),
	red = Color3.fromRGB(204, 60, 57),
}

local BASE_COLORS = {
	Color3.fromRGB(87, 147, 160),
	Color3.fromRGB(190, 133, 79),
	Color3.fromRGB(145, 122, 177),
	Color3.fromRGB(179, 112, 130),
	Color3.fromRGB(128, 161, 88),
}

local function colorFrom(value)
	if typeof(value) == "Color3" then
		return value
	end
	value = value or {}
	return Color3.fromRGB(value.r or value[1] or 140, value.g or value[2] or 210, value.b or value[3] or 140)
end

local function folder(name, parent)
	local result = Instance.new("Folder")
	result.Name = name
	result.Parent = parent
	return result
end

local function model(name, parent)
	local result = Instance.new("Model")
	result.Name = name
	result.Parent = parent
	return result
end

local function part(parent, name, size, position, color, collidable, shape, rotation, material)
	local result = Instance.new("Part")
	result.Name = name
	result.Size = size
	result.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
	result.Color = color
	result.Material = material or Enum.Material.SmoothPlastic
	result.Shape = shape or Enum.PartType.Block
	result.Anchored = true
	result.CanCollide = collidable == true
	result.CanTouch = false
	result.CanQuery = collidable == true
	result.TopSurface = Enum.SurfaceType.Smooth
	result.BottomSurface = Enum.SurfaceType.Smooth
	result.Parent = parent
	return result
end

local function disc(parent, name, diameter, thickness, position, color, collidable, material)
	return part(
		parent,
		name,
		Vector3.new(thickness, diameter, diameter),
		position,
		color,
		collidable,
		Enum.PartType.Cylinder,
		CFrame.Angles(0, 0, math.pi / 2),
		material
	)
end

local function surface(board, name, maxDistance, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Adornee = board
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 44
	gui.LightInfluence = 0.15
	gui.Brightness = 1
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance or 48
	gui.Parent = board
	return gui
end

local function textLabel(parent, name, text, color, y, height, textSize)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = UDim2.fromScale(0.94, height or 0.9)
	label.Position = UDim2.fromScale(0.03, y or 0.05)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or COLORS.cream
	label.TextStrokeTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = textSize or 34
	label.TextWrapped = true
	label.Parent = parent
	return label
end

local function prompt(parent, name, action, object, holdDuration)
	local result = Instance.new("ProximityPrompt")
	result.Name = name
	result.ActionText = action
	result.ObjectText = object
	result.HoldDuration = holdDuration or 0.25
	result.MaxActivationDistance = 11
	result.RequiresLineOfSight = false
	result.KeyboardKeyCode = Enum.KeyCode.E
	result.GamepadKeyCode = Enum.KeyCode.ButtonX
	result.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	result.Parent = parent
	return result
end

local function plaque(parent, name, position, text, color, width, height, rotation, maxDistance, textSize)
	local facing = rotation or CFrame.identity
	part(
		parent,
		name .. "Frame",
		Vector3.new(width + 0.5, height + 0.5, 0.5),
		position + facing:VectorToWorldSpace(Vector3.new(0, 0, 0.14)),
		COLORS.wood,
		false,
		nil,
		facing,
		Enum.Material.Wood
	)
	local board = part(parent, name, Vector3.new(width, height, 0.35), position, color, false, nil, facing)
	local gui = surface(board, name .. "Lettering", maxDistance)
	return textLabel(gui, "Title", text, COLORS.cream, nil, nil, textSize), board
end

local function sign(parent, name, position, text, color, width, maxDistance, rotation)
	for _, side in ipairs({ -1, 1 }) do
		part(
			parent,
			name .. "Post",
			Vector3.new(0.65, 4.8, 0.65),
			position + Vector3.new(side * (width or 12) * 0.37, 2.4, 0),
			COLORS.wood,
			false,
			nil,
			nil,
			Enum.Material.Wood
		)
	end
	return plaque(
		parent,
		name,
		position + Vector3.new(0, 4.4, 0),
		text,
		color or COLORS.ink,
		width or 12,
		3,
		rotation,
		maxDistance or 48
	)
end

local function tree(parent, x, z, scale)
	local base = Vector3.new(x, 0, z)
	local treeModel = model("GardenTree", parent)
	part(
		treeModel,
		"Trunk",
		Vector3.new(2, 9, 2) * scale,
		base + Vector3.new(0, 4.5 * scale, 0),
		COLORS.wood,
		false,
		nil,
		nil,
		Enum.Material.Wood
	)
	part(
		treeModel,
		"Branch",
		Vector3.new(1, 5, 1) * scale,
		base + Vector3.new(1.4 * scale, 8 * scale, 0),
		COLORS.wood,
		false,
		nil,
		CFrame.Angles(0, 0, -0.55),
		Enum.Material.Wood
	)
	for index, offset in ipairs({
		Vector3.new(0, 11, 0),
		Vector3.new(-3, 10, 0.8),
		Vector3.new(3, 11.3, 0),
		Vector3.new(0.6, 14, -0.5),
	}) do
		part(
			treeModel,
			"Canopy",
			Vector3.new(9, 6.5, 8) * scale,
			base + offset * scale,
			index % 2 == 0 and COLORS.leafLight or COLORS.leaf,
			false,
			Enum.PartType.Ball
		)
	end
end

local function shrubs(parent, x, z, color, scale)
	scale = scale or 1
	for index = 1, 3 do
		part(
			parent,
			"Shrub",
			Vector3.new(3.8, 2.8, 3.5) * scale,
			Vector3.new(x + (index - 2) * 2.4 * scale, 1.2 * scale, z),
			color or COLORS.leaf,
			false,
			Enum.PartType.Ball
		)
	end
end

local function planter(parent, position, accent)
	part(
		parent,
		"Planter",
		Vector3.new(7, 1.1, 3),
		position + Vector3.new(0, 0.55, 0),
		COLORS.wood,
		false,
		nil,
		nil,
		Enum.Material.WoodPlanks
	)
	part(
		parent,
		"Soil",
		Vector3.new(6.6, 0.2, 2.6),
		position + Vector3.new(0, 1.12, 0),
		Color3.fromRGB(76, 63, 47),
		false
	)
	for index = 1, 5 do
		part(
			parent,
			"FlowerLeaves",
			Vector3.new(0.8, 1.1, 0.8),
			position + Vector3.new((index - 3) * 1.2, 1.65, 0),
			COLORS.leaf,
			false,
			Enum.PartType.Ball
		)
		part(
			parent,
			"Flower",
			Vector3.new(0.8, 0.5, 0.8),
			position + Vector3.new((index - 3) * 1.2, 2.25, 0),
			index % 2 == 0 and COLORS.cream or accent,
			false,
			Enum.PartType.Ball
		)
	end
end

local function lamp(parent, position)
	local lantern = model("GardenLantern", parent)
	part(
		lantern,
		"Foot",
		Vector3.new(2, 0.7, 2),
		position + Vector3.new(0, 0.35, 0),
		COLORS.stone,
		false,
		nil,
		nil,
		Enum.Material.Slate
	)
	part(
		lantern,
		"Post",
		Vector3.new(0.6, 7.5, 0.6),
		position + Vector3.new(0, 4, 0),
		COLORS.ink,
		false,
		nil,
		nil,
		Enum.Material.Metal
	)
	local glass = part(
		lantern,
		"WarmGlass",
		Vector3.new(1.5, 1.65, 1.5),
		position + Vector3.new(0, 8.1, 0),
		COLORS.cream,
		false
	)
	part(lantern, "LanternCap", Vector3.new(2, 0.4, 2), position + Vector3.new(0, 9.05, 0), COLORS.ink, false)
	part(
		lantern,
		"LanternBase",
		Vector3.new(1.9, 0.35, 1.9),
		position + Vector3.new(0, 7.2, 0),
		COLORS.ink,
		false
	)
	local glow = Instance.new("PointLight")
	glow.Name = "WarmLight"
	glow.Color = COLORS.cream
	glow.Brightness = 0.4
	glow.Range = 12
	glow.Shadows = false
	glow.Parent = glass
end

local function trail(parent, name, center, size)
	part(
		parent,
		name .. "Edging",
		size + Vector3.new(1.5, 0, 1.5),
		center,
		COLORS.stone,
		true,
		nil,
		nil,
		Enum.Material.Slate
	)
	part(
		parent,
		name,
		size + Vector3.new(0, 0.04, 0),
		center + Vector3.new(0, 0.04, 0),
		COLORS.path,
		true,
		nil,
		nil,
		Enum.Material.Cobblestone
	)
end

local function buildGround(root)
	local map = folder("Landscape", root)
	part(
		map,
		"Meadow",
		Vector3.new(360, 2, 760),
		Vector3.new(0, -1, 85),
		COLORS.grass,
		true,
		nil,
		nil,
		Enum.Material.Grass
	)
	trail(map, "VillageWalk", Vector3.new(0, 0.1, -53), Vector3.new(20, 0.2, 222))
	trail(map, "LobbyPlaza", Vector3.new(0, 0.1, 28), Vector3.new(232, 0.2, 31))
	trail(map, "GardenLane", Vector3.new(0, 0.1, -70), Vector3.new(195, 0.2, 16))
	trail(map, "GuardianWalk", Vector3.new(0, 0.1, 228.5), Vector3.new(26, 0.2, 353))
	for _, x in ipairs({ -179, 179 }) do
		part(
			map,
			"BoundaryHedge",
			Vector3.new(2, 5, 760),
			Vector3.new(x, 2.5, 85),
			COLORS.leaf,
			true,
			nil,
			nil,
			Enum.Material.Grass
		)
	end
	for _, z in ipairs({ -294, 464 }) do
		part(
			map,
			"BoundaryHedge",
			Vector3.new(360, 5, 2),
			Vector3.new(0, 2.5, z),
			COLORS.leaf,
			true,
			nil,
			nil,
			Enum.Material.Grass
		)
	end

	local walls = folder("GuardianRouteWalls", root)
	for _, side in ipairs({ -1, 1 }) do
		local x = side * 49
		part(
			walls,
			"StoneWall",
			Vector3.new(2.5, 8.5, 353),
			Vector3.new(x, 4.25, 228.5),
			COLORS.stone,
			true,
			nil,
			nil,
			Enum.Material.Cobblestone
		)
		part(
			walls,
			"TimberTop",
			Vector3.new(2.7, 2, 353),
			Vector3.new(x, 9.5, 228.5),
			COLORS.wood,
			true,
			nil,
			nil,
			Enum.Material.WoodPlanks
		)
		part(
			walls,
			"WallCap",
			Vector3.new(3.4, 0.6, 354),
			Vector3.new(x, 10.8, 228.5),
			COLORS.woodLight,
			true,
			nil,
			nil,
			Enum.Material.Wood
		)
		for index = 0, 7 do
			local z = 52 + index * 50
			part(
				walls,
				"Buttress",
				Vector3.new(3.6, 11.3, 3.3),
				Vector3.new(x, 5.65, z),
				COLORS.stoneLight,
				true,
				nil,
				nil,
				Enum.Material.Slate
			)
			part(
				walls,
				"ButtressCap",
				Vector3.new(4, 0.6, 3.8),
				Vector3.new(x, 11.6, z),
				COLORS.wood,
				false,
				nil,
				nil,
				Enum.Material.Wood
			)
		end
	end
	part(
		walls,
		"EndWall",
		Vector3.new(100, 10.5, 2.5),
		Vector3.new(0, 5.25, 405),
		COLORS.stone,
		true,
		nil,
		nil,
		Enum.Material.Cobblestone
	)
	part(
		walls,
		"EndWallCap",
		Vector3.new(101, 0.7, 3.4),
		Vector3.new(0, 10.85, 405),
		COLORS.woodLight,
		true,
		nil,
		nil,
		Enum.Material.Wood
	)

	local decor = folder("Decorations", root)
	for index = 1, 10 do
		local z = -255 + index * 67
		tree(decor, -146 - (index % 3) * 6, z, 1 + (index % 3) * 0.18)
		tree(decor, 143 + (index % 2) * 9, z + 21, 1.15 + (index % 2) * 0.2)
	end
	for _, z in ipairs({ 77, 220, 385 }) do
		for _, side in ipairs({ -1, 1 }) do
			tree(decor, side * 65, z, 1.2)
			shrubs(decor, side * 38, z, nil, 1.05)
			lamp(decor, Vector3.new(side * 41, 0, z - 8))
		end
	end
	for _, z in ipairs({ -150, -57, 24 }) do
		for _, side in ipairs({ -1, 1 }) do
			lamp(decor, Vector3.new(side * 16, 0, z))
		end
	end
	for _, x in ipairs({ -36, 36 }) do
		part(
			decor,
			"WelcomeArchPost",
			Vector3.new(2.3, 14.5, 2.3),
			Vector3.new(x, 7.25, 52),
			COLORS.wood,
			true,
			nil,
			nil,
			Enum.Material.Wood
		)
		part(
			decor,
			"WelcomeFoot",
			Vector3.new(3.5, 2.5, 3.5),
			Vector3.new(x, 1.25, 52),
			COLORS.stoneLight,
			true,
			nil,
			nil,
			Enum.Material.Slate
		)
		planter(decor, Vector3.new(x, 0, 47), COLORS.gold)
	end
	part(
		decor,
		"WelcomeArchBeam",
		Vector3.new(77, 1.8, 2.5),
		Vector3.new(0, 14, 52),
		COLORS.wood,
		false,
		nil,
		nil,
		Enum.Material.Wood
	)
	plaque(
		decor,
		"Welcome",
		Vector3.new(0, 12.5, 50.4),
		"STEAL A GOOFY EGG",
		COLORS.ink,
		28,
		3.2,
		nil,
		65,
		43
	)
	sign(
		decor,
		"HowTo",
		Vector3.new(-27, 0, 40),
		"STEAL • ESCAPE • HATCH\nBring an egg home",
		COLORS.ink,
		16,
		45
	)
	sign(
		decor,
		"Route",
		Vector3.new(27, 0, 40),
		"GUARDIAN GARDENS\nFollow the stone path",
		COLORS.ink,
		16,
		45
	)
	for _, z in ipairs({ 65, 210, 230, 383 }) do
		for _, side in ipairs({ -1, 1 }) do
			part(
				decor,
				"RouteChevron",
				Vector3.new(0.6, 0.08, 3.8),
				Vector3.new(side * 1.1, 0.27, z),
				COLORS.cream,
				false,
				nil,
				CFrame.Angles(0, side * -0.62, 0)
			)
		end
	end
	-- A distant planted end to the route, rather than another empty white slab.
	for _, x in ipairs({ -33, -22, 22, 33 }) do
		shrubs(decor, x, 397, nil, 1.35)
	end
	sign(decor, "GardenEnd", Vector3.new(0, 0, 399), "MORE GARDENS COMING SOON", COLORS.ink, 25, 45)
end

local function fence(parent, center, color)
	part(
		parent,
		"BackStoneEdge",
		Vector3.new(64, 1.3, 1.5),
		center + Vector3.new(0, 0.65, -27.5),
		COLORS.stone,
		true,
		nil,
		nil,
		Enum.Material.Slate
	)
	for _, side in ipairs({ -1, 1 }) do
		part(
			parent,
			"SideStoneEdge",
			Vector3.new(1.5, 1.3, 56),
			center + Vector3.new(side * 31.5, 0.65, 0),
			COLORS.stone,
			true,
			nil,
			nil,
			Enum.Material.Slate
		)
		for _, y in ipairs({ 2, 3.4 }) do
			part(
				parent,
				"SideFenceRail",
				Vector3.new(0.5, 0.65, 56),
				center + Vector3.new(side * 31.5, y, 0),
				COLORS.woodLight,
				true,
				nil,
				nil,
				Enum.Material.Wood
			)
			part(
				parent,
				"FrontFenceRail",
				Vector3.new(19.5, 0.65, 0.5),
				center + Vector3.new(side * 21.5, y, 27.5),
				COLORS.woodLight,
				true,
				nil,
				nil,
				Enum.Material.Wood
			)
		end
		for _, z in ipairs({ -27, -13.5, 0, 13.5, 27 }) do
			part(
				parent,
				"FencePost",
				Vector3.new(1, 4.5, 1),
				center + Vector3.new(side * 31.5, 2.25, z),
				COLORS.wood,
				true,
				nil,
				nil,
				Enum.Material.Wood
			)
		end
		part(
			parent,
			"EntrancePost",
			Vector3.new(1.6, 5, 1.6),
			center + Vector3.new(side * 12, 2.5, 27.5),
			COLORS.wood,
			true,
			nil,
			nil,
			Enum.Material.Wood
		)
		part(
			parent,
			"EntranceCap",
			Vector3.new(2, 0.5, 2),
			center + Vector3.new(side * 12, 5.2, 27.5),
			color,
			false
		)
	end
end

local function buildBase(config, parent, id, position)
	local baseModel = model("Base_" .. id, parent)
	baseModel:SetAttribute("BaseId", id)
	baseModel:SetAttribute("OwnerUserId", 0)
	local center = Vector3.new(position.x, 0, position.z)
	local color = BASE_COLORS[id] or COLORS.mint
	part(
		baseModel,
		"Foundation",
		Vector3.new(64, 0.7, 56),
		center + Vector3.new(0, 0.25, 0),
		COLORS.stone,
		true,
		nil,
		nil,
		Enum.Material.Slate
	)
	part(
		baseModel,
		"LivingLawn",
		Vector3.new(60, 0.2, 52),
		center + Vector3.new(0, 0.7, 0),
		COLORS.lawn,
		true,
		nil,
		nil,
		Enum.Material.Grass
	)
	fence(baseModel, center, color)
	trail(baseModel, "EntranceWalk", center + Vector3.new(0, 0.2, 31), Vector3.new(13, 0.25, 13))
	part(
		baseModel,
		"EntranceStep",
		Vector3.new(13, 0.45, 4),
		center + Vector3.new(0, 0.42, 26),
		COLORS.path,
		true,
		nil,
		nil,
		Enum.Material.Sandstone
	)
	for _, side in ipairs({ -1, 1 }) do
		planter(baseModel, center + Vector3.new(side * 24, 0.6, 24), color)
		shrubs(baseModel, center.X + side * 27, center.Z - 22, COLORS.leaf, 0.8)
	end

	-- The covered rear hatch nook keeps the central lawn open for roaming pets.
	part(
		baseModel,
		"HatchDeck",
		Vector3.new(56, 0.45, 17),
		center + Vector3.new(0, 0.97, -16.5),
		COLORS.woodLight,
		true,
		nil,
		nil,
		Enum.Material.WoodPlanks
	)
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -24, -9 }) do
			part(
				baseModel,
				"HatchPergolaPost",
				Vector3.new(1, 7.5, 1),
				center + Vector3.new(side * 27, 4.6, z),
				COLORS.wood,
				true,
				nil,
				nil,
				Enum.Material.Wood
			)
		end
	end
	for _, z in ipairs({ -24, -9 }) do
		part(
			baseModel,
			"HatchPergolaBeam",
			Vector3.new(58, 0.9, 1.3),
			center + Vector3.new(0, 8.1, z),
			COLORS.wood,
			false,
			nil,
			nil,
			Enum.Material.Wood
		)
	end
	for x = -24, 24, 8 do
		part(
			baseModel,
			"PergolaSlat",
			Vector3.new(1, 0.5, 18),
			center + Vector3.new(x, 8.5, -16.5),
			COLORS.woodLight,
			false,
			nil,
			nil,
			Enum.Material.Wood
		)
	end
	local ownerSign = plaque(
		baseModel,
		"OwnerSign",
		center + Vector3.new(0, 6.1, -25),
		"AVAILABLE RANCH",
		color:Lerp(COLORS.ink, 0.55),
		25,
		2.8,
		CFrame.Angles(0, math.pi, 0),
		60,
		37
	)
	local hatchFolder = folder("Hatches", baseModel)
	local animalFolder = folder("Animals", baseModel)
	local slots = {}
	for index = 1, config.hatchSlots do
		local x = (index - (config.hatchSlots + 1) / 2) * 17
		disc(
			baseModel,
			"NestRim_" .. index,
			7.8,
			0.6,
			center + Vector3.new(x, 1.43, -15),
			COLORS.wood,
			false,
			Enum.Material.Wood
		)
		local slot = disc(
			baseModel,
			"HatchSlot_" .. index,
			6.9,
			0.16,
			center + Vector3.new(x, 1.77, -15),
			COLORS.gold,
			false,
			Enum.Material.Fabric
		)
		slot:SetAttribute("SlotIndex", index)
		slots[index] = slot
		for twig = 1, 6 do
			local angle = twig * math.pi / 3
			part(
				baseModel,
				"NestStraw",
				Vector3.new(0.2, 0.16, 3),
				center + Vector3.new(x + math.cos(angle) * 2.4, 1.89, -15 + math.sin(angle) * 2.4),
				COLORS.cream:Lerp(COLORS.gold, 0.5),
				false,
				nil,
				CFrame.Angles(0, -angle, 0)
			)
		end
		plaque(
			baseModel,
			"HatchNumber_" .. index,
			center + Vector3.new(x, 2.05, -10.2),
			"NEST " .. index,
			COLORS.ink,
			5.5,
			1.3,
			CFrame.Angles(0, math.pi, 0),
			35,
			29
		)
	end
	local animalSpots = {}
	for index = 1, config.maxAnimals do
		local column = (index - 1) % 4
		local row = math.floor((index - 1) / 4)
		animalSpots[index] = CFrame.new(center + Vector3.new((column - 1.5) * 11, 0.85, 4 + row * 10))
			* CFrame.Angles(0, math.pi, 0)
	end
	local deposit = disc(
		baseModel,
		"DepositPad",
		8,
		0.14,
		center + Vector3.new(0, 0.89, 0),
		COLORS.path,
		false,
		Enum.Material.Sandstone
	)
	disc(
		baseModel,
		"DepositInlay",
		6.8,
		0.05,
		center + Vector3.new(0, 0.99, 0),
		color:Lerp(COLORS.cream, 0.3),
		false
	)
	local depositPrompt = prompt(deposit, "DepositEgg", "Hatch egg", "Your hatchery", 0.35)
	plaque(
		baseModel,
		"DepositDirections",
		center + Vector3.new(0, 3.1, -8.1),
		"BRING YOUR EGG HERE",
		COLORS.ink,
		13,
		1.5,
		CFrame.Angles(0, math.pi, 0),
		40,
		28
	)

	local shopPosition = center + Vector3.new(-27, 0, -3.5)
	local shop = part(
		baseModel,
		"SpeedShop",
		Vector3.new(5, 3, 4.5),
		shopPosition + Vector3.new(0, 2.3, 0),
		COLORS.woodLight,
		false,
		nil,
		nil,
		Enum.Material.WoodPlanks
	)
	part(
		baseModel,
		"ShopCounter",
		Vector3.new(6, 0.4, 5.2),
		shopPosition + Vector3.new(0, 4, 0),
		COLORS.wood,
		false,
		nil,
		nil,
		Enum.Material.Wood
	)
	for _, side in ipairs({ -1, 1 }) do
		part(
			baseModel,
			"KioskPost",
			Vector3.new(0.4, 5.7, 0.4),
			shopPosition + Vector3.new(side * 2.5, 3.55, 1.7),
			COLORS.wood,
			false,
			nil,
			nil,
			Enum.Material.Wood
		)
	end
	part(
		baseModel,
		"KioskAwning",
		Vector3.new(6.2, 0.45, 5.8),
		shopPosition + Vector3.new(0, 6.5, 0),
		color,
		false,
		nil,
		CFrame.Angles(0.12, 0, 0)
	)
	plaque(
		baseModel,
		"SpeedShopSign",
		shopPosition + Vector3.new(0, 5.3, 2.55),
		"SPEED",
		COLORS.ink,
		5.6,
		1.5,
		CFrame.Angles(0, math.pi, 0),
		40,
		31
	)
	local upgradePrompt = prompt(shop, "UpgradeSpeed", "Upgrade speed", "Speed shop", 0.35)
	return {
		id = id,
		center = center,
		spawn = CFrame.lookAt(center + Vector3.new(0, 4, 19), center + Vector3.new(0, 4, 35)),
		model = baseModel,
		slots = slots,
		animalSpots = animalSpots,
		sign = ownerSign,
		depositPrompt = depositPrompt,
		upgradePrompt = upgradePrompt,
		hatchFolder = hatchFolder,
		animalFolder = animalFolder,
		hatches = {},
	}
end

local function buildZone(parent, zone)
	local zoneModel = model("Zone_" .. zone.id, parent)
	zoneModel:SetAttribute("ZoneId", zone.id)
	local color = colorFrom(zone.color)
	local center = Vector3.new(zone.position.x, 0, zone.position.z)
	local halfWidth = zone.arenaHalfWidth or 46
	local halfDepth = zone.arenaHalfDepth or 55
	local courtColor = zone.guardian == "turtle" and Color3.fromRGB(112, 142, 85)
		or Color3.fromRGB(137, 133, 117)
	part(
		zoneModel,
		"ZoneCourt",
		Vector3.new(halfWidth * 2, 0.16, halfDepth * 2),
		center + Vector3.new(0, 0.18, 0),
		courtColor,
		true,
		nil,
		nil,
		Enum.Material.Grass
	)
	part(
		zoneModel,
		"CourtWalk",
		Vector3.new(24, 0.15, halfDepth * 2),
		center + Vector3.new(0, 0.29, 0),
		COLORS.path,
		true,
		nil,
		nil,
		Enum.Material.Cobblestone
	)
	-- These visible strips match the server's rectangular chase boundary exactly.
	for _, side in ipairs({ -1, 1 }) do
		part(
			zoneModel,
			"RedSideBoundary",
			Vector3.new(0.9, 0.12, halfDepth * 2),
			center + Vector3.new(side * halfWidth, 0.34, 0),
			COLORS.red,
			false
		)
		part(
			zoneModel,
			"RedEscapeLine",
			Vector3.new(halfWidth * 2, 0.12, 1.4),
			center + Vector3.new(0, 0.44, side * halfDepth),
			COLORS.red,
			false
		)
		for stripe = -4, 4 do
			part(
				zoneModel,
				"BoundaryDash",
				Vector3.new(3, 0.08, 0.45),
				center + Vector3.new(stripe * 9, 0.47, side * halfDepth + side * 1.5),
				COLORS.cream,
				false
			)
		end
		shrubs(zoneModel, center.X + side * 39, center.Z + 25, color:Lerp(COLORS.leaf, 0.75), 1.2)
		shrubs(zoneModel, center.X + side * 39, center.Z - 18, nil, 0.95)
		for rock = 1, 3 do
			part(
				zoneModel,
				"GardenRock",
				Vector3.new(3 + rock, 2 + rock * 0.5, 3.5),
				center + Vector3.new(side * (35 + rock * 2), 0.8, 35 + rock * 2),
				COLORS.stoneLight,
				false,
				Enum.PartType.Ball,
				CFrame.Angles(0, rock, 0)
			)
		end
	end
	local levelText = zone.requiredLevel > 0 and ("SPEED LEVEL " .. zone.requiredLevel) or "YOUR FIRST HEIST"
	sign(
		zoneModel,
		"ZoneSign",
		center + Vector3.new(-27, 0, -halfDepth - 4),
		string.upper(zone.name) .. "\n" .. levelText,
		color:Lerp(COLORS.ink, 0.65),
		24,
		60
	)
	sign(
		zoneModel,
		"EscapeSign",
		center + Vector3.new(27, 0, -halfDepth - 4),
		"CROSS RED LINE TO ESCAPE\nGuardians stay in this garden",
		COLORS.ink,
		24,
		55
	)
	-- The back face is useful while running home with an egg.
	plaque(
		zoneModel,
		"EscapeReturnSign",
		center + Vector3.new(27, 4.4, -halfDepth - 3.5),
		"CROSS RED LINE\nSAFE BEYOND THIS GARDEN",
		COLORS.ink,
		24,
		3,
		CFrame.Angles(0, math.pi, 0),
		55,
		34
	)
	disc(
		zoneModel,
		"EggPlinth",
		8.5,
		0.75,
		center + Vector3.new(0, 0.65, 0),
		COLORS.stoneLight,
		true,
		Enum.Material.Slate
	)
	disc(
		zoneModel,
		"EggNest",
		7,
		0.25,
		center + Vector3.new(0, 1.15, 0),
		COLORS.woodLight,
		false,
		Enum.Material.Wood
	)
	disc(
		zoneModel,
		"EggStraw",
		5.5,
		0.15,
		center + Vector3.new(0, 1.36, 0),
		COLORS.gold,
		false,
		Enum.Material.Fabric
	)
	for twig = 1, 8 do
		local angle = twig * math.pi / 4
		part(
			zoneModel,
			"WildNestTwig",
			Vector3.new(0.3, 0.3, 2.8),
			center + Vector3.new(math.cos(angle) * 3.1, 1.46, math.sin(angle) * 3.1),
			COLORS.wood,
			false,
			nil,
			CFrame.Angles(0, -angle, 0)
		)
	end
	local egg = AnimalFactory.egg(zone.color, "WildEgg")
	egg:SetAttribute("ZoneId", zone.id)
	egg:SetAttribute("Available", true)
	egg:PivotTo(CFrame.new(center + Vector3.new(0, 2.9, 0)))
	egg.Parent = zoneModel
	local stealPrompt = prompt(egg.PrimaryPart, "StealEgg", "Steal egg", zone.name, 0.65)
	local homePosition = center + Vector3.new(zone.guardianOffset or 20, 0.3, 0)
	local home = CFrame.lookAt(homePosition, Vector3.new(center.X, homePosition.Y, center.Z))
	local guardian = AnimalFactory.create(zone.guardian, zone.color, "Guardian")
	guardian:SetAttribute("VisualRole", "Guardian")
	guardian:SetAttribute("ZoneId", zone.id)
	guardian:SetAttribute("State", "Idle")
	guardian:SetAttribute("HomeX", homePosition.X)
	guardian:SetAttribute("HomeY", homePosition.Y)
	guardian:SetAttribute("HomeZ", homePosition.Z)
	guardian:ScaleTo(zone.guardian == "rabbit" and 2.2 or 2.1)
	guardian:SetAttribute("RigScale", guardian:GetScale())
	guardian:PivotTo(home)
	guardian.Parent = zoneModel
	return {
		config = zone,
		home = home,
		egg = egg,
		prompt = stealPrompt,
		guardian = guardian,
		model = zoneModel,
	}
end

function World.build(config)
	local previous = workspace:FindFirstChild("GoofyEggWorld")
	if previous then
		previous:Destroy()
	end
	local root = folder("GoofyEggWorld", workspace)
	local self = setmetatable({ config = config, root = root, bases = {}, zones = {} }, World)
	buildGround(root)
	local basesFolder = folder("Bases", root)
	for id, position in ipairs(config.basePositions) do
		self.bases[id] = buildBase(config, basesFolder, id, position)
	end
	local zonesFolder = folder("Zones", root)
	for _, zone in ipairs(config.zones) do
		self.zones[zone.id] = buildZone(zonesFolder, zone)
	end
	return self
end

function World:setBaseOwner(baseId, player)
	local base = self.bases[baseId]
	if not base then
		return
	end
	base.model:SetAttribute("OwnerUserId", player and player.UserId or 0)
	base.sign.Text = player and (player.DisplayName .. "'S RANCH") or "AVAILABLE RANCH"
	base.depositPrompt.ObjectText = player and (player.DisplayName .. "'s hatchery") or "Unclaimed hatchery"
	if not player then
		for index = 1, self.config.hatchSlots do
			self:clearHatch(baseId, index)
		end
		self:setAnimals(baseId, {})
	end
end

function World:showHatch(baseId, slotIndex, zoneId, readyAt)
	local base = self.bases[baseId]
	local zone = self.zones[zoneId]
	if not base or not base.slots[slotIndex] or not zone then
		return
	end
	self:clearHatch(baseId, slotIndex)
	local egg = AnimalFactory.egg(zone.config.color, "Hatch_" .. slotIndex)
	egg:SetAttribute("VisualRole", "HatchingEgg")
	egg:SetAttribute("ReadyAt", readyAt)
	egg:SetAttribute("ZoneId", zoneId)
	egg:SetAttribute("BaseId", baseId)
	egg:SetAttribute("SlotIndex", slotIndex)
	local slotPosition = base.slots[slotIndex].Position
	egg:PivotTo(CFrame.new(slotPosition + Vector3.new(0, 1.65, 0)))
	-- A separate fixed board is a child of the egg for countdown discovery/cleanup.
	-- It is never attached to the moving shell or turned toward the camera.
	local _, board = plaque(
		egg,
		"HatchStatus",
		slotPosition + Vector3.new(0, 2, -5.1),
		zone.config.name,
		COLORS.ink,
		9,
		2.6,
		CFrame.Angles(0, math.pi, 0),
		40,
		29
	)
	local gui = board:FindFirstChild("HatchStatusLettering")
	local title = gui and gui:FindFirstChild("Title")
	if title then
		title.Size = UDim2.fromScale(0.94, 0.45)
		title.Position = UDim2.fromScale(0.03, 0.05)
	end
	textLabel(
		gui,
		"Countdown",
		math.max(0, math.ceil(readyAt - workspace:GetServerTimeNow())) .. "s",
		COLORS.mint,
		0.52,
		0.42,
		36
	)
	egg.Parent = base.hatchFolder
	base.hatches[slotIndex] = egg
end

function World:clearHatch(baseId, slotIndex)
	local base = self.bases[baseId]
	if not base then
		return
	end
	local egg = base.hatches[slotIndex]
	if egg then
		egg:Destroy()
		base.hatches[slotIndex] = nil
	end
end

function World:setAnimals(baseId, animals)
	local base = self.bases[baseId]
	if not base then
		return
	end
	base.animalFolder:ClearAllChildren()
	for index, owned in ipairs(animals) do
		local animalConfig = self.config.animals[owned.id]
		local spot = base.animalSpots[index]
		if animalConfig and spot then
			local animal = AnimalFactory.create(animalConfig.species, animalConfig.color, animalConfig.name)
			animal:SetAttribute("AnimalId", owned.id)
			animal:SetAttribute("BaseId", baseId)
			animal:SetAttribute("SlotIndex", index)
			animal:SetAttribute("Personality", animalConfig.personality)
			animal:SetAttribute("VisualRole", "Animal")
			animal:SetAttribute("RoamCenterX", base.center.X)
			animal:SetAttribute("RoamCenterY", 0.85)
			animal:SetAttribute("RoamCenterZ", base.center.Z + 8.5)
			animal:SetAttribute("RoamHalfX", 23)
			animal:SetAttribute("RoamHalfZ", 10.5)
			animal:SetAttribute("RoamSeed", baseId * 100 + index)
			animal:ScaleTo(1.3)
			animal:SetAttribute("RigScale", animal:GetScale())
			animal:PivotTo(spot)
			animal.Parent = base.animalFolder
		end
	end
end

function World:setEggAvailable(zoneId, available)
	local zone = self.zones[zoneId]
	if not zone then
		return
	end
	zone.egg:SetAttribute("Available", available)
	zone.prompt.Enabled = available
	for _, descendant in ipairs(zone.egg:GetDescendants()) do
		if descendant:IsA("BasePart") then
			if descendant:GetAttribute("OriginalTransparency") == nil then
				descendant:SetAttribute("OriginalTransparency", descendant.Transparency)
			end
			descendant.Transparency = available and descendant:GetAttribute("OriginalTransparency") or 1
		end
	end
end

function World:destroy()
	self.root:Destroy()
	self.bases = {}
	self.zones = {}
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="22">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="23">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="Folder" referent="24">
      <Properties>
        <string name="Name">GoofyUI</string>
      </Properties>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Original interface artwork uses Roblox UI primitives; gameplay remains server-authoritative.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Hud = {}
Hud.__index = Hud

local C = {
	ink = Color3.fromRGB(37, 49, 45),
	muted = Color3.fromRGB(105, 119, 109),
	paper = Color3.fromRGB(251, 248, 238),
	blue = Color3.fromRGB(91, 153, 255),
	lilac = Color3.fromRGB(187, 156, 255),
	mint = Color3.fromRGB(161, 213, 170),
	yellow = Color3.fromRGB(240, 204, 111),
	pink = Color3.fromRGB(228, 144, 121),
}

local function make(class, properties, parent)
	local instance = Instance.new(class)
	for key, value in pairs(properties) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local function round(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

local function border(parent, color, thickness)
	return make("UIStroke", {
		Color = color or C.ink,
		Thickness = thickness or 1,
		Transparency = 0.82,
		-- Contextual mode strokes TextButton letters, making the text illegible.
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function label(parent, text, size, color, position, dimensions, bold)
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		Font = if bold then Enum.Font.GothamMedium else Enum.Font.Gotham,
		TextSize = size,
		TextColor3 = color or C.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = position or UDim2.new(),
		Size = dimensions or UDim2.fromScale(1, 1),
	}, parent)
end

local function panel(parent, name, color, position, dimensions)
	local frame = make("Frame", {
		Name = name,
		BackgroundColor3 = color or C.paper,
		BorderSizePixel = 0,
		Position = position,
		Size = dimensions,
	}, parent)
	round(frame)
	border(frame)
	return frame
end

local function cash(value)
	value = tonumber(value) or 0
	if value >= 1e9 then
		return string.format("%.1fB", value / 1e9)
	elseif value >= 1e6 then
		return string.format("%.1fM", value / 1e6)
	elseif value >= 1e4 then
		return string.format("%.1fK", value / 1e3)
	end
	local formatted = tostring(math.floor(value))
	while true do
		local changed
		formatted, changed = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if changed == 0 then
			break
		end
	end
	return formatted
end

local function tint(rgb, fallback)
	if type(rgb) ~= "table" then
		return fallback or C.mint
	end
	return Color3.fromRGB(rgb.r or 150, rgb.g or 200, rgb.b or 170)
end

-- A small original egg mascot, also used as the unrevealed collection portrait.
local function eggArt(parent, position, dimensions, color, asleep)
	local art = make("Frame", {
		BackgroundTransparency = 1,
		Position = position,
		Size = dimensions,
	}, parent)
	local egg = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromScale(0.66, 0.83),
		BackgroundColor3 = color or C.yellow,
		BorderSizePixel = 0,
		Rotation = -7,
	}, art)
	make("UICorner", { CornerRadius = UDim.new(0.48, 0) }, egg)
	border(egg, C.ink, 2)
	for _, x in ipairs({ 0.32, 0.68 }) do
		local eye = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, 0.52),
			Size = UDim2.fromScale(0.085, if asleep then 0.025 else 0.12),
			BackgroundColor3 = C.ink,
			BorderSizePixel = 0,
		}, egg)
		round(eye, 8)
	end
	local smile = label(egg, "v", 18, C.ink, UDim2.fromScale(0.35, 0.57), UDim2.fromScale(0.3, 0.22), true)
	smile.TextXAlignment = Enum.TextXAlignment.Center
	return art
end

-- Flat animal portraits echo the procedural world models without external artwork.
local function animalArt(parent, position, dimensions, animal)
	local art = make("Frame", { BackgroundTransparency = 1, Position = position, Size = dimensions }, parent)
	local color = tint(animal.color)
	local function shape(x, y, w, h, fill, radius)
		local piece = make("Frame", {
			Position = UDim2.fromScale(x, y),
			Size = UDim2.fromScale(w, h),
			BackgroundColor3 = fill,
			BorderSizePixel = 0,
		}, art)
		make("UICorner", { CornerRadius = UDim.new(radius or 0.5, 0) }, piece)
		return piece
	end
	local species = animal.species
	if species == "rabbit" then
		shape(0.25, 0.02, 0.16, 0.49, color)
		shape(0.59, 0.02, 0.16, 0.49, color)
		shape(0.3, 0.06, 0.06, 0.3, C.pink)
		shape(0.64, 0.06, 0.06, 0.3, C.pink)
	elseif species == "cat" then
		local left = shape(0.2, 0.14, 0.26, 0.31, color, 0.18)
		left.Rotation = -20
		local right = shape(0.54, 0.14, 0.26, 0.31, color, 0.18)
		right.Rotation = 20
	elseif species == "dinosaur" then
		shape(0.43, 0.12, 0.16, 0.29, C.mint, 0.2)
	end
	local head = shape(0.12, 0.29, 0.76, 0.61, color)
	border(head, C.ink, 1.5)
	if species == "penguin" then
		shape(0.28, 0.45, 0.44, 0.38, C.paper)
	elseif species == "turtle" then
		shape(0.3, 0.78, 0.4, 0.12, color:Lerp(C.ink, 0.2))
	end
	if species == "frog" then
		shape(0.22, 0.22, 0.23, 0.25, color)
		shape(0.55, 0.22, 0.23, 0.25, color)
	end
	local eyeY = if species == "frog" then 0.28 else 0.48
	shape(0.31, eyeY, 0.075, 0.1, C.ink)
	shape(0.62, eyeY, 0.075, 0.1, C.ink)
	if species == "duck" or species == "penguin" then
		shape(0.37, 0.61, 0.28, 0.14, C.yellow:Lerp(C.pink, 0.25))
	else
		local smile =
			label(art, "v", 17, C.ink, UDim2.fromScale(0.38, 0.59), UDim2.fromScale(0.24, 0.21), true)
		smile.TextXAlignment = Enum.TextXAlignment.Center
	end
	return art
end

function Hud:_connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

function Hud:_sound(cue)
	if self.sfxEnabled and self.callbacks.sound then
		self.callbacks.sound(cue)
	end
end

function Hud:_button(parent, text, color, position, dimensions, callback)
	local button = make("TextButton", {
		Text = text,
		TextColor3 = C.ink,
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = position,
		Size = dimensions,
		AutoButtonColor = true,
	}, parent)
	round(button, 11)
	border(button)
	self:_connect(button.Activated, function()
		if self.destroyed then
			return
		end
		self:_sound("ui")
		callback()
	end)
	return button
end

function Hud:_action(action)
	if not self.state then
		self:notice({ text = "Finding your garden. One moment!", kind = "info" })
		return
	end
	local now = os.clock()
	if now - self.lastAction < 0.3 then
		return
	end
	self.lastAction = now
	-- Prices, distance checks, and rewards always belong to the server.
	self.callbacks.action(action)
end

function Hud:_closeMenu()
	self.modal.Visible = false
	self.activePanel = nil
end

function Hud:_open(name)
	if self.activePanel == name and self.modal.Visible then
		self:_closeMenu()
		return
	end
	self.activePanel = name
	self.modal.Visible = true
	self.modalTitle.Text = name
	for key, page in pairs(self.pages) do
		page.Visible = key == name
	end
end

-- Small original geometric icons. Labels remain available beside every icon.
local function navigationIcon(parent, kind)
	local icon = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 13),
		Size = UDim2.fromOffset(18, 18),
	}, parent)
	local function shape(x, y, w, h, color)
		local piece = make("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
		}, icon)
		round(piece, 3)
		return piece
	end
	if kind == "Collection" then
		for row = 0, 1 do
			for col = 0, 1 do
				shape(col * 10, row * 10, 7, 7, C.ink)
			end
		end
	elseif kind == "Shop" then
		local coin = shape(1, 1, 16, 16, C.yellow)
		round(coin, 8)
		border(coin, C.ink, 1.5)
		shape(7, 5, 3, 8, C.ink)
	else
		for row = 0, 2 do
			shape(1, 2 + row * 6, 16, 2, C.muted)
			shape(if row == 1 then 10 else 4, row * 6, 4, 6, C.ink)
		end
	end
	return icon
end

function Hud.new(config, callbacks)
	local self = setmetatable({}, Hud)
	self.config = config
	self.callbacks = callbacks
	self.connections = {}
	self.state = nil
	self.lastAction = 0
	self.noticeUntil = 0
	self.revealUntil = 0
	self.reducedMotion = false
	self.effects = true
	self.sfxEnabled = (config.audio or {}).enabled ~= false
	self.destroyed = false
	self.collectionCards = {}
	self.slotLabels = {}
	self.navigationItems = {}
	self.zoneById = {}
	for _, zone in ipairs(config.zones) do
		self.zoneById[zone.id] = zone
	end

	self.gui = make("ScreenGui", {
		Name = "GoofyEggHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 20,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.root = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, self.gui)

	self.wallet = panel(self.root, "Wallet", C.paper, UDim2.fromOffset(12, 10), UDim2.fromOffset(214, 48))
	local coin = make("Frame", {
		BackgroundColor3 = C.yellow,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(11, 13),
		Size = UDim2.fromOffset(22, 22),
	}, self.wallet)
	round(coin, 11)
	local coinMark = label(coin, "$", 13, C.ink, UDim2.new(), UDim2.fromScale(1, 1), true)
	coinMark.TextXAlignment = Enum.TextXAlignment.Center
	self.cashLabel =
		label(self.wallet, "$0", 18, C.ink, UDim2.fromOffset(41, 5), UDim2.new(1, -50, 0, 22), true)
	self.incomeLabel =
		label(self.wallet, "+$0 / sec", 12, C.muted, UDim2.fromOffset(42, 27), UDim2.new(1, -50, 0, 15))
	self.speedChip = panel(self.root, "Speed", C.paper, UDim2.fromOffset(234, 10), UDim2.fromOffset(102, 48))
	label(self.speedChip, "SPEED", 10, C.muted, UDim2.fromOffset(13, 7), UDim2.new(1, -20, 0, 14), true)
	self.speedLabel =
		label(self.speedChip, "Level 0", 15, C.ink, UDim2.fromOffset(13, 23), UDim2.new(1, -20, 0, 20), true)

	self.mission = panel(self.root, "NextStep", C.paper, UDim2.fromOffset(12, 66), UDim2.fromOffset(336, 40))
	self.mission.BackgroundTransparency = 0.08
	self.missionDot = make("Frame", {
		BackgroundColor3 = C.mint,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 16),
		Size = UDim2.fromOffset(8, 8),
	}, self.mission)
	round(self.missionDot, 4)
	self.missionText = label(
		self.mission,
		"Finding your garden...",
		13,
		C.ink,
		UDim2.fromOffset(28, 4),
		UDim2.new(1, -39, 1, -8)
	)
	self.missionText.TextWrapped = true

	self.hatching = make("Frame", {
		Name = "OccupiedNests",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 114),
		Size = UDim2.fromOffset(336, 30),
		Visible = false,
	}, self.root)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, self.hatching)
	for index = 1, config.hatchSlots do
		local chip = panel(self.hatching, "Nest" .. index, C.paper, UDim2.new(), UDim2.fromOffset(105, 30))
		chip.LayoutOrder = index
		chip.Visible = false
		round(chip, 9)
		local slot = label(chip, "", 11, C.ink, UDim2.fromOffset(9, 0), UDim2.new(1, -18, 1, 0), true)
		self.slotLabels[index] = slot
	end

	self.actionBar = make("Frame", {
		Name = "ContextAction",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(210, 44),
	}, self.root)
	self.upgrade = self:_button(
		self.actionBar,
		"Speed up  ·  ...",
		C.mint,
		UDim2.new(),
		UDim2.fromScale(1, 1),
		function()
			self:_action("UpgradeSpeed")
		end
	)
	self.deposit = self:_button(
		self.actionBar,
		"Nest egg at home",
		C.yellow,
		UDim2.new(),
		UDim2.fromScale(1, 1),
		function()
			self:_action("DepositEgg")
		end
	)
	self.deposit.Visible = false

	self.navigation = make("Frame", {
		Name = "Navigation",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(340, 44),
	}, self.root)
	for index, name in ipairs({ "Collection", "Shop", "Settings" }) do
		local button = self:_button(
			self.navigation,
			"",
			C.paper,
			UDim2.new((index - 1) / 3, 0, 0, 0),
			UDim2.new(1 / 3, -5, 1, 0),
			function()
				self:_open(name)
			end
		)
		button.Name = name
		local icon = navigationIcon(button, name)
		local caption = label(button, name, 12, C.ink, UDim2.fromOffset(36, 0), UDim2.new(1, -40, 1, 0), true)
		table.insert(self.navigationItems, { icon = icon, caption = caption })
	end

	self.noticeFrame = panel(self.root, "Notice", C.yellow, self.mission.Position, self.mission.Size)
	self.noticeFrame.ZIndex = 80
	self.noticeFrame.Visible = false
	self.noticeText =
		label(self.noticeFrame, "", 13, C.ink, UDim2.fromOffset(12, 4), UDim2.new(1, -24, 1, -8), true)
	self.noticeText.TextWrapped = true

	self.modal = make("Frame", {
		Name = "Menus",
		BackgroundColor3 = C.ink,
		BackgroundTransparency = 0.4,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 40,
		Active = true,
	}, self.root)
	self.modalPanel =
		panel(self.modal, "MenuCard", C.paper, UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(610, 490))
	self.modalPanel.AnchorPoint = Vector2.new(0.5, 0.5)
	self.modalTitle = label(
		self.modalPanel,
		"Collection",
		22,
		C.ink,
		UDim2.fromOffset(20, 16),
		UDim2.new(1, -95, 0, 36),
		true
	)
	self:_button(
		self.modalPanel,
		"×",
		C.paper,
		UDim2.new(1, -58, 0, 12),
		UDim2.fromOffset(44, 44),
		function()
			self:_closeMenu()
		end
	)
	self.pages = {}
	for _, name in ipairs({ "Collection", "Shop", "Settings" }) do
		self.pages[name] = make("ScrollingFrame", {
			Name = name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(18, 66),
			Size = UDim2.new(1, -36, 1, -82),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = C.mint:Lerp(C.ink, 0.2),
			Visible = false,
		}, self.modalPanel)
	end
	self:_buildCollection()
	self:_buildShop()
	self:_buildSettings()
	self:_buildReveal()

	self:_connect(self.gui:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:_layout()
	end)
	self:_layout()
	local elapsed = 0
	self:_connect(RunService.Heartbeat, function(dt)
		elapsed += dt
		if elapsed < 0.1 then
			return
		end
		elapsed = 0
		self:_tick()
	end)
	self:notice({ text = "Welcome! This session's progress resets when you leave.", kind = "info" })
	self.noticeUntil = os.clock() + 6
	return self
end

function Hud:_layout()
	local size = self.gui.AbsoluteSize
	local width, height = math.max(size.X, 280), math.max(size.Y, 240)
	local short = height < 440
	-- Landscape phones have room for one compact header, but not stacked menus
	-- and a hatch reveal. Keep the full 44px button height and omit only icons.
	local compactLandscape = short and width >= 540
	local compactHeader = compactLandscape and width < 700
	local portrait = width < 700 and not compactLandscape
	local margin = 12
	local available = width - margin * 2
	local walletWidth = if compactHeader then 142 elseif portrait then available - 110 else 214
	local leftWidth = if compactLandscape
		then math.min(336, available - 282)
		elseif portrait then available
		else 336
	self.wallet.Size = UDim2.fromOffset(walletWidth, 48)
	self.speedChip.Position = UDim2.fromOffset(margin + walletWidth + 8, 10)
	self.mission.Size = UDim2.fromOffset(leftWidth, 40)
	self.navigation.AnchorPoint = Vector2.new(if portrait then 0 else 1, 0)
	self.navigation.Position = if portrait
		then UDim2.fromOffset(margin, 114)
		else UDim2.new(1, -margin, 0, 12)
	self.navigation.Size =
		UDim2.fromOffset(if compactHeader then 260 elseif portrait then available + 5 else 340, 44)
	for _, item in ipairs(self.navigationItems) do
		item.icon.Visible = not compactHeader
		item.caption.Position = UDim2.fromOffset(if compactHeader then 6 else 36, 0)
		item.caption.Size = UDim2.new(1, if compactHeader then -12 else -40, 1, 0)
		item.caption.TextXAlignment = if compactHeader
			then Enum.TextXAlignment.Center
			else Enum.TextXAlignment.Left
	end
	self.hatching.Position = UDim2.fromOffset(margin, if portrait then 166 else 114)
	self.hatching.Size = UDim2.fromOffset(leftWidth, 30)
	for _, slot in ipairs(self.slotLabels) do
		local chipWidth = math.floor((math.min(leftWidth, 336) - 12) / self.config.hatchSlots)
		slot.Parent.Size = UDim2.fromOffset(chipWidth, 30)
		slot.TextSize = if chipWidth < 96 then 10 else 11
	end
	-- No global UIScale: phone tap targets stay 44px, text stays legible.
	-- The lower corners are reserved for Roblox's thumbstick and jump button.
	self.actionBar.Position = UDim2.new(0.5, 0, 1, if portrait and not short then -130 else -18)
	if compactLandscape and height < 280 then
		-- Very shallow Studio windows need separate columns for reveal and action.
		self.actionBar.Position = UDim2.new(0, margin + leftWidth / 2, 1, -18)
	end
	self.modalPanel.Size = UDim2.fromOffset(math.min(610, available), math.min(490, height - 24))
	self.noticeFrame.Position = self.mission.Position
	self.noticeFrame.Size = self.mission.Size
	self.collectionGrid.CellSize = UDim2.new(if width < 510 then 0.5 else 1 / 3, -8, 0, 168)
	self.revealCard.Size = UDim2.fromOffset(if compactLandscape then 270 else math.min(346, available), 144)
	if portrait then
		self.revealCard.AnchorPoint = Vector2.new(0.5, 0)
		self.revealCard.Position = UDim2.new(0.5, 0, 0, 204)
	elseif short then
		self.revealCard.AnchorPoint = Vector2.new(1, 0)
		self.revealCard.Position = UDim2.new(1, -12, 0, 68)
	else
		self.revealCard.AnchorPoint = Vector2.new(0.5, 1)
		self.revealCard.Position = UDim2.new(0.5, 0, 1, -74)
	end
end

function Hud:_buildCollection()
	local page = self.pages.Collection
	self.collectionCount =
		label(page, "Your garden starts with one egg.", 13, C.muted, UDim2.new(), UDim2.new(1, -8, 0, 36))
	self.collectionCount.TextWrapped = true
	local grid = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, -6, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, page)
	self.collectionGrid = make("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -8, 0, 168),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	make(
		"UIPadding",
		{ PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2) },
		grid
	)
	local entries = {}
	for id, animal in pairs(self.config.animals) do
		table.insert(entries, { id = id, animal = animal })
	end
	table.sort(entries, function(a, b)
		local aOrder = self.config.rarities[a.animal.rarity].order
		local bOrder = self.config.rarities[b.animal.rarity].order
		return if aOrder == bOrder then a.id < b.id else aOrder < bOrder
	end)
	for index, entry in ipairs(entries) do
		local card = panel(grid, entry.id, C.paper:Lerp(C.muted, 0.08), UDim2.new(), UDim2.new())
		card.LayoutOrder = index
		local art = eggArt(
			card,
			UDim2.new(0.5, -34, 0, 9),
			UDim2.fromOffset(68, 70),
			C.paper:Lerp(C.muted, 0.2),
			true
		)
		local name =
			label(card, "Mystery friend", 13, C.ink, UDim2.fromOffset(8, 82), UDim2.new(1, -16, 0, 34), true)
		name.TextWrapped = true
		name.TextXAlignment = Enum.TextXAlignment.Center
		local rarity = label(
			card,
			entry.animal.rarity,
			11,
			C.muted,
			UDim2.fromOffset(8, 115),
			UDim2.new(1, -16, 0, 18),
			true
		)
		rarity.TextXAlignment = Enum.TextXAlignment.Center
		local income =
			label(card, "Not discovered", 11, C.muted, UDim2.fromOffset(8, 136), UDim2.new(1, -16, 0, 24))
		income.TextWrapped = true
		income.TextXAlignment = Enum.TextXAlignment.Center
		self.collectionCards[entry.id] =
			{ frame = card, name = name, rarity = rarity, income = income, art = art }
	end
end

function Hud:_buildShop()
	local page = self.pages.Shop
	label(page, "A little faster. A bigger adventure.", 16, C.ink, UDim2.new(), UDim2.new(1, -8, 0, 40), true).TextWrapped =
		true
	self.shopSpeed =
		label(page, "Finding your speed...", 13, C.muted, UDim2.fromOffset(0, 43), UDim2.new(1, -8, 0, 38))
	self.shopSpeed.TextWrapped = true
	self.shopUpgrade = self:_button(
		page,
		"Speed up",
		C.mint,
		UDim2.fromOffset(2, 91),
		UDim2.new(1, -12, 0, 48),
		function()
			self:_action("UpgradeSpeed")
		end
	)
	label(page, "BEYOND THE RED LINE", 11, C.muted, UDim2.fromOffset(0, 163), UDim2.new(1, -8, 0, 24), true)
	self.zoneGuide =
		label(page, "", 13, C.ink, UDim2.fromOffset(0, 197), UDim2.new(1, -8, 0, #self.config.zones * 46))
	self.zoneGuide.TextWrapped = true
	self.zoneGuide.TextYAlignment = Enum.TextYAlignment.Top
	local footer = label(
		page,
		"Guardians stop at their red boundary. Get the egg across, then head home.\n\nUpgrades use earned coins. There are no paid purchases.",
		13,
		C.muted,
		UDim2.fromOffset(0, 214 + #self.config.zones * 46),
		UDim2.new(1, -12, 0, 100)
	)
	footer.TextWrapped = true
	footer.TextYAlignment = Enum.TextYAlignment.Top
end

function Hud:_buildSettings()
	local page = self.pages.Settings
	self.soundButton = self:_button(
		page,
		"Sound effects   ·   " .. (if self.sfxEnabled then "On" else "Off"),
		C.paper,
		UDim2.fromOffset(2, 4),
		UDim2.new(1, -12, 0, 48),
		function()
			self.sfxEnabled = not self.sfxEnabled
			self.soundButton.Text = "Sound effects   ·   " .. (if self.sfxEnabled then "On" else "Off")
			-- Reach the client's enabled-state sync even when sound has just been
			-- switched off, cancelling voices already queued by a hatch or upgrade.
			if self.callbacks.sound then
				self.callbacks.sound("ui")
			end
		end
	)
	self.motionButton = self:_button(
		page,
		"Reduced motion   ·   Off",
		C.paper,
		UDim2.fromOffset(2, 62),
		UDim2.new(1, -12, 0, 48),
		function()
			self.reducedMotion = not self.reducedMotion
			self.motionButton.Text = "Reduced motion   ·   " .. (if self.reducedMotion then "On" else "Off")
			if self.reducedMotion and self.revealTween then
				self.revealTween:Cancel()
				self.revealTween = nil
				self.revealScale.Scale = 1
			end
		end
	)
	self.effectsButton = self:_button(
		page,
		"Visual effects   ·   On",
		C.paper,
		UDim2.fromOffset(2, 120),
		UDim2.new(1, -12, 0, 48),
		function()
			self.effects = not self.effects
			self.effectsButton.Text = "Visual effects   ·   " .. (if self.effects then "On" else "Off")
		end
	)
	local details = label(
		page,
		"Sound effects play for game events; there is no background music.\n\nReduced motion limits decorative movement and hatch animation.\n\nSESSION PROGRESS\nCoins, animals, upgrades, and settings reset when you leave. Saving is not available yet.",
		13,
		C.muted,
		UDim2.fromOffset(3, 190),
		UDim2.new(1, -15, 0, 210)
	)
	details.TextWrapped = true
	details.TextYAlignment = Enum.TextYAlignment.Top
end

function Hud:_buildReveal()
	-- A toast, not a full-screen input blocker: movement and prompts stay available.
	self.revealOverlay = make("Frame", {
		Name = "HatchReveal",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 30,
		Active = false,
	}, self.root)
	self.revealCard =
		panel(self.revealOverlay, "NewFriend", C.paper, UDim2.new(0.5, 0, 1, -74), UDim2.fromOffset(346, 144))
	self.revealCard.AnchorPoint = Vector2.new(0.5, 1)
	self.revealScale = make("UIScale", { Scale = 1 }, self.revealCard)
	self.revealTitle = label(
		self.revealCard,
		"A NEW FRIEND!",
		10,
		C.muted,
		UDim2.fromOffset(91, 12),
		UDim2.new(1, -137, 0, 16),
		true
	)
	self.revealArt =
		eggArt(self.revealCard, UDim2.fromOffset(12, 27), UDim2.fromOffset(65, 78), C.yellow, false)
	self.revealName =
		label(self.revealCard, "", 16, C.ink, UDim2.fromOffset(90, 32), UDim2.new(1, -108, 0, 36), true)
	self.revealName.TextWrapped = true
	self.revealRarity =
		label(self.revealCard, "", 12, C.ink, UDim2.fromOffset(91, 69), UDim2.new(1, -108, 0, 18), true)
	self.revealNote =
		label(self.revealCard, "", 11, C.muted, UDim2.fromOffset(91, 91), UDim2.new(1, -108, 0, 43))
	self.revealNote.TextWrapped = true
	self.revealNote.TextYAlignment = Enum.TextYAlignment.Top
	self:_button(self.revealCard, "×", C.paper, UDim2.new(1, -45, 0, 0), UDim2.fromOffset(44, 44), function()
		self.revealOverlay.Visible = false
	end)
end

function Hud:update(state)
	if self.destroyed or type(state) ~= "table" then
		return
	end
	self.state = state
	self.cashLabel.Text = "$" .. cash(state.cash)
	self.incomeLabel.Text = "+$" .. cash(state.income) .. " / sec"
	self.speedLabel.Text = "Level " .. tostring(state.speedLevel or 0)
	local cost = state.upgradeCost
	local upgradeText = if cost then "Speed up  ·  $" .. cash(cost) else "Maximum speed"
	self.upgrade.Text = upgradeText
	self.shopUpgrade.Text = upgradeText
	self.upgrade.BackgroundColor3 = if cost and (state.cash or 0) >= cost then C.mint else C.paper
	self.shopUpgrade.BackgroundColor3 = self.upgrade.BackgroundColor3
	self.shopSpeed.Text = string.format(
		"Level %d of %d  ·  Run speed %d",
		state.speedLevel or 0,
		self.config.speed.maxLevel,
		state.walkSpeed or self.config.speed.base
	)
	self.deposit.Visible = state.carrying ~= nil
	self.upgrade.Visible = state.carrying == nil
	if state.carrying then
		local pursued = state.escaped ~= true
		self.missionText.Text = if pursued
			then "Run! Cross the red line to lose the guardian."
			else "Egg secured! Take it to garden " .. tostring(state.baseId or "?") .. "."
		self.missionDot.BackgroundColor3 = if pursued then C.pink else C.yellow
		self.mission.BackgroundColor3 = if pursued
			then C.pink:Lerp(C.paper, 0.68)
			else C.yellow:Lerp(C.paper, 0.7)
	else
		local hatches = #(state.hatches or {})
		local animals = #(state.animals or {})
		self.missionText.Text = if hatches > 0
			then "Eggs are warming. Explore while they hatch!"
			elseif animals == 0 then "Follow the path. Hold the egg prompt to steal!"
			else "Garden " .. tostring(state.baseId or "?") .. "  ·  Grow your crew. Upgrade. Explore."
		self.missionDot.BackgroundColor3 = C.mint
		self.mission.BackgroundColor3 = C.paper
	end
	local lines = {}
	for _, zone in ipairs(self.config.zones) do
		local unlocked = (state.speedLevel or 0) >= zone.requiredLevel
		table.insert(
			lines,
			(if unlocked then "Open   " else "Level " .. tostring(zone.requiredLevel) .. "   ") .. zone.name
		)
	end
	self.zoneGuide.Text = table.concat(lines, "\n\n")
	local owned = {}
	for _, animal in ipairs(state.animals or {}) do
		owned[animal.id] = (owned[animal.id] or 0) + 1
	end
	local found, total = 0, 0
	for id, card in pairs(self.collectionCards) do
		total += 1
		local discovered = (state.discovered or {})[id] == true
		local animal = self.config.animals[id]
		local rarityColor = tint(self.config.rarities[animal.rarity].color)
		if discovered then
			found += 1
		end
		card.name.Text = if discovered then animal.name else "Mystery friend"
		card.income.Text = if discovered
			then "$" .. cash(animal.income) .. "/s  ·  Owned " .. tostring(owned[id] or 0)
			else "Not discovered"
		card.rarity.TextColor3 = if discovered then rarityColor:Lerp(C.ink, 0.62) else C.muted
		card.frame.BackgroundColor3 = if discovered
			then rarityColor:Lerp(C.paper, 0.87)
			else C.paper:Lerp(C.muted, 0.08)
		if discovered and not card.discovered then
			card.art:Destroy()
			card.art = animalArt(card.frame, UDim2.new(0.5, -34, 0, 9), UDim2.fromOffset(68, 70), animal)
			card.discovered = true
		end
	end
	self.collectionCount.Text = string.format(
		"%d / %d discovered   ·   %d / %d in your garden",
		found,
		total,
		#(state.animals or {}),
		self.config.maxAnimals
	)
	self:_tick()
end

function Hud:_tick()
	if self.destroyed then
		return
	end
	local now = os.clock()
	self.noticeFrame.Visible = now < self.noticeUntil
	self.mission.Visible = not self.noticeFrame.Visible
	if self.revealOverlay.Visible and now >= self.revealUntil then
		self.revealOverlay.Visible = false
	end
	local bySlot = {}
	for _, hatch in ipairs(if self.state then self.state.hatches or {} else {}) do
		bySlot[hatch.slot] = hatch
	end
	local occupied = false
	local serverNow = Workspace:GetServerTimeNow()
	for index, slot in ipairs(self.slotLabels) do
		local hatch = bySlot[index]
		slot.Parent.Visible = hatch ~= nil
		if hatch then
			occupied = true
			local remaining = math.max(0, math.ceil(hatch.readyAt - serverNow))
			slot.Text = if remaining > 0
				then "Nest " .. index .. "  ·  " .. remaining .. "s"
				else "Hatching!"
		end
	end
	self.hatching.Visible = occupied
end

function Hud:notice(payload)
	if self.destroyed or type(payload) ~= "table" then
		return
	end
	self.noticeText.Text = tostring(payload.text or "")
	self.noticeFrame.BackgroundColor3 = if payload.kind == "error"
		then C.pink:Lerp(C.paper, 0.35)
		elseif payload.kind == "success" then C.mint
		else C.yellow:Lerp(C.paper, 0.3)
	self.noticeUntil = os.clock() + 4
	self.noticeFrame.Visible = true
	self.mission.Visible = false
end

function Hud:reveal(payload)
	if self.destroyed or type(payload) ~= "table" then
		return
	end
	local animal = self.config.animals[payload.animalId]
	if not animal then
		return
	end
	local rarity = self.config.rarities[animal.rarity]
	self.revealTitle.Text = if payload.kept == false then "DISCOVERED!" else "A NEW FRIEND!"
	self.revealName.Text = animal.name
	self.revealRarity.Text = animal.rarity .. "  ·  $" .. cash(payload.income or animal.income) .. "/s"
	self.revealRarity.TextColor3 = tint(rarity.color):Lerp(C.ink, 0.62)
	self.revealNote.Text = if payload.kept == false
		then "Collection updated. Your stronger earners kept their garden spots."
		elseif payload.replacedName then "Moved in for " .. payload.replacedName .. "."
		else animal.personality or "Your newest garden friend!"
	self.revealCard.BackgroundColor3 = tint(rarity.color):Lerp(C.paper, 0.89)
	self.revealArt:Destroy()
	self.revealArt = animalArt(self.revealCard, UDim2.fromOffset(12, 27), UDim2.fromOffset(65, 78), animal)
	self.revealOverlay.Visible = true
	self.revealUntil = os.clock() + 3
	if self.revealTween then
		self.revealTween:Cancel()
		self.revealTween = nil
	end
	if not self.reducedMotion and self.effects then
		self.revealScale.Scale = 0.94
		self.revealTween = TweenService:Create(
			self.revealScale,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = 1 }
		)
		self.revealTween:Play()
	else
		self.revealScale.Scale = 1
	end
end

function Hud:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	self.connections = {}
	if self.revealTween then
		self.revealTween:Cancel()
	end
	self.gui:Destroy()
end

return Hud
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">48</float>
      <float name="CameraMinZoomDistance">7</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">GoofyEgg</string>
        </Properties>
        <Item class="LocalScript" referent="29">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Presentation only. The server owns cash, movement levels, catches, and hatch results.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local connections = {}
local animated = {}
local countdowns = {}
local guardians = {}
local pendingModels = {}
local modelWatches = {}
local closed = false
local receivedState = false
local hud
local sound
local PetMotion

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function required(parent, name)
	local child = parent:WaitForChild(name, 25)
	assert(child, "Missing " .. parent:GetFullName() .. "." .. name)
	return child
end

local function showBootstrapError()
	local screen = Instance.new("ScreenGui")
	screen.Name = "GoofyEggStartupError"
	screen.ResetOnSpawn = false
	screen.Parent = playerGui
	local text = Instance.new("TextLabel")
	text.AnchorPoint = Vector2.new(0.5, 0)
	text.Position = UDim2.new(0.5, 0, 0, 70)
	text.Size = UDim2.new(0.9, 0, 0, 94)
	text.BackgroundColor3 = Color3.fromRGB(255, 216, 105)
	text.TextColor3 = Color3.fromRGB(39, 37, 63)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 17
	text.TextWrapped = true
	text.Text =
		"Your goofy world could not finish loading. Rejoin to try again.\nIn Studio, check Output for the missing setup item."
	text.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = text
end

local ok, problem = pcall(function()
	local packageFolder = required(ReplicatedStorage, "GoofyEgg")
	local config = require(required(required(packageFolder, "Shared"), "Config"))
	PetMotion = require(required(required(packageFolder, "Shared"), "PetMotion"))
	local SoundEffects = require(required(script.Parent, "SoundEffects"))
	sound = SoundEffects.new(config)
	local Hud = require(required(required(playerGui, "GoofyUI"), "Hud"))
	local remotes = required(packageFolder, "Remotes")
	local stateRemote = required(remotes, "State")
	local actionRemote = required(remotes, "Action")
	local noticeRemote = required(remotes, "Notice")
	local hatchRemote = required(remotes, "Hatch")
	local getState = required(remotes, "GetState")

	hud = Hud.new(config, {
		sound = function(cue)
			if not closed then
				sound:setEnabled(not hud or hud.sfxEnabled ~= false)
				sound:play(cue)
			end
		end,
		action = function(action)
			if not closed and (action == "UpgradeSpeed" or action == "DepositEgg") then
				actionRemote:FireServer(action)
			end
		end,
	})
	-- Subscribe first so a live server update cannot be missed during the initial request.
	connect(stateRemote.OnClientEvent, function(state)
		if not closed and type(state) == "table" then
			receivedState = true
			hud:update(state)
		end
	end)
	connect(noticeRemote.OnClientEvent, function(payload)
		if not closed then
			hud:notice(payload)
			if type(payload) == "table" and type(payload.sound) == "string" then
				sound:setEnabled(hud.sfxEnabled ~= false)
				sound:play(payload.sound)
			end
		end
	end)
	connect(hatchRemote.OnClientEvent, function(payload)
		if not closed then
			hud:reveal(payload)
			sound:setEnabled(hud.sfxEnabled ~= false)
			sound:play("hatch")
		end
	end)

	task.spawn(function()
		local success, initial = pcall(function()
			return getState:InvokeServer()
		end)
		if closed then
			return
		end
		if success and type(initial) == "table" then
			-- A periodic live update may have arrived while InvokeServer was in flight.
			if not receivedState then
				receivedState = true
				hud:update(initial)
			end
		elseif not receivedState then
			hud:notice({ text = "Your base is still loading. Waiting for the server...", kind = "info" })
		end
	end)
	task.delay(15, function()
		if not closed and not receivedState then
			hud:notice({
				text = "Still waiting for a base. If this continues, rejoin the server.",
				kind = "error",
			})
		end
	end)
end)

if not ok then
	warn("Goofy Egg client setup failed: " .. tostring(problem))
	if hud then
		hud:destroy()
	end
	if sound then
		sound:destroy()
	end
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	closed = true
	showBootstrapError()
	return
end

local function rigReady(model)
	local expected = model:GetAttribute("RigPartCount")
	local scale = model:GetAttribute("RigScale")
	if
		not model.PrimaryPart
		or type(expected) ~= "number"
		or type(scale) ~= "number"
		or type(model:GetAttribute("Species")) ~= "string"
	then
		return false
	end
	local count = 0
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			if
				typeof(part:GetAttribute("AnimationRest")) ~= "CFrame"
				or type(part:GetAttribute("AnimationRole")) ~= "string"
				or type(part:GetAttribute("AnimationSide")) ~= "number"
				or type(part:GetAttribute("AnimationPhase")) ~= "number"
			then
				return false
			end
			count += 1
		end
	end
	return count == expected
end

local function cacheRig(model)
	local scale = model:GetAttribute("RigScale")
	local origin = model:GetPivot()
	local parts = {}
	for _, child in ipairs(model:GetDescendants()) do
		if child:IsA("BasePart") and child ~= model.PrimaryPart then
			local rest = child:GetAttribute("AnimationRest")
			table.insert(parts, {
				part = child,
				rest = CFrame.new(rest.Position * scale) * rest.Rotation,
				role = child:GetAttribute("AnimationRole"),
				side = child:GetAttribute("AnimationSide") or 1,
				phase = child:GetAttribute("AnimationPhase") or 0,
			})
		end
	end
	return {
		origin = origin,
		parts = parts,
		species = model:GetAttribute("Species"),
		scale = scale,
		seed = model:GetAttribute("RoamSeed") or 0,
		posed = false,
		moved = false,
	}
end

-- All offsets are applied to cached rest poses, never to the previous frame.
-- Root transforms belong to roaming (pets) or the server (guardians).
local function poseRig(entry, pivot, now, speed, stride, active)
	local weight = if active then math.clamp(speed / 1.8, 0, 1) else 0
	local gait = stride * 3.2
	local bob = math.abs(math.sin(gait)) * 0.045 * weight
	local roll = math.sin(gait) * 0.025 * weight
	if entry.species == "rabbit" or entry.species == "frog" then
		bob = math.abs(math.sin(gait)) * 0.28 * weight
	elseif entry.species == "duck" or entry.species == "penguin" then
		roll = math.sin(gait) * 0.065 * weight
	end
	local body = CFrame.new(0, bob * entry.scale, 0) * CFrame.Angles(0, 0, roll)
	local idle = if active then math.sin(now * 1.9 + entry.seed) else 0
	for _, joint in ipairs(entry.parts) do
		if joint.part.Parent then
			local offset = body
			local rotation = CFrame.identity
			if joint.role == "Foot" then
				local step = gait + joint.phase + (if joint.side < 0 then math.pi else 0)
				if entry.species == "frog" or entry.species == "rabbit" then
					step = gait -- These two hop with both feet together.
				end
				offset = CFrame.new(
					0,
					math.max(0, math.sin(step)) * 0.26 * entry.scale * weight,
					math.cos(step) * 0.23 * entry.scale * weight
				)
				rotation = CFrame.Angles(math.sin(step) * 0.22 * weight, 0, 0)
			elseif joint.role == "Wing" or joint.role == "Arm" then
				rotation = CFrame.Angles(
					math.sin(gait) * 0.18 * weight,
					0,
					joint.side * (idle * 0.035 + math.sin(gait) * 0.22 * weight)
				)
			elseif joint.role == "Ear" then
				rotation = CFrame.Angles(-math.sin(gait) * 0.09 * weight, 0, idle * 0.045 * joint.side)
			elseif joint.role == "Tail" then
				rotation = CFrame.Angles(0, idle * 0.18 + math.sin(gait) * 0.1 * weight, idle * 0.05)
			end
			joint.part.CFrame = pivot * offset * joint.rest * rotation
		end
	end
	entry.posed = active
end

-- Replication may deliver attributes and descendants in different frames.
-- Retry only pending rigs, and listen for later metadata instead of caching partial models.
local function observe(instance)
	local role = instance:GetAttribute("VisualRole")
	if role == "Animal" and not animated[instance] then
		local x, y, z =
			instance:GetAttribute("RoamCenterX"),
			instance:GetAttribute("RoamCenterY"),
			instance:GetAttribute("RoamCenterZ")
		local halfX, halfZ = instance:GetAttribute("RoamHalfX"), instance:GetAttribute("RoamHalfZ")
		if
			type(x) ~= "number"
			or type(y) ~= "number"
			or type(z) ~= "number"
			or type(halfX) ~= "number"
			or type(halfZ) ~= "number"
			or type(instance:GetAttribute("RoamSeed")) ~= "number"
			or type(instance:GetAttribute("Species")) ~= "string"
			or not rigReady(instance)
		then
			return false
		end
		local entry = cacheRig(instance)
		entry.center = Vector3.new(x, y, z)
		entry.plan = PetMotion.new(entry.seed, halfX, halfZ, entry.species)
		animated[instance] = entry
	elseif role == "Guardian" and not guardians[instance] then
		if not rigReady(instance) then
			return false
		end
		guardians[instance] = cacheRig(instance)
	end
	if role == "HatchingEgg" then
		if type(instance:GetAttribute("ReadyAt")) ~= "number" then
			return false
		end
		countdowns[instance] = true
	end
	return true
end

local function watchModel(instance)
	if not instance:IsA("Model") or modelWatches[instance] then
		return
	end
	local function retry()
		if not closed and instance:IsDescendantOf(Workspace) then
			pendingModels[instance] = true
		end
	end
	modelWatches[instance] = {
		instance.AttributeChanged:Connect(retry),
		instance:GetPropertyChangedSignal("PrimaryPart"):Connect(retry),
		instance.DescendantAdded:Connect(retry),
	}
	retry()
end

for _, descendant in Workspace:GetDescendants() do
	watchModel(descendant)
end
connect(Workspace.DescendantAdded, watchModel)
connect(Workspace.DescendantRemoving, function(instance)
	animated[instance] = nil
	countdowns[instance] = nil
	guardians[instance] = nil
	pendingModels[instance] = nil
	local watches = modelWatches[instance]
	if watches then
		for _, connection in watches do
			connection:Disconnect()
		end
		modelWatches[instance] = nil
	end
end)

local accumulated = 0
local countdownElapsed = 0
connect(RunService.Heartbeat, function(dt)
	if closed then
		return
	end
	accumulated += dt
	countdownElapsed += dt
	-- Decorative world updates are capped at 20Hz, keeping mobile cost predictable.
	if accumulated >= 0.05 then
		accumulated = 0
		local active = hud.effects
		local gaitEnabled = active and not hud.reducedMotion
		local now = Workspace:GetServerTimeNow()
		local camera = Workspace.CurrentCamera
		for model, entry in pairs(animated) do
			if not model.Parent then
				animated[model] = nil
			elseif active and camera and (entry.center - camera.CFrame.Position).Magnitude < 160 then
				local sample = PetMotion.sample(entry.plan, now)
				local pivot = CFrame.new(entry.center + Vector3.new(sample.x, 0, sample.z))
					* CFrame.Angles(0, sample.heading, 0)
				model:PivotTo(pivot)
				poseRig(entry, pivot, now, sample.speed, sample.stride, gaitEnabled)
				entry.moved = true
			elseif entry.posed then
				poseRig(entry, model:GetPivot(), now, 0, 0, false)
			end
		end
		for model, entry in pairs(guardians) do
			if not model.Parent then
				guardians[model] = nil
			elseif camera and (model:GetPivot().Position - camera.CFrame.Position).Magnitude < 160 then
				local moving = model:GetAttribute("Chasing") or model:GetAttribute("State") == "Returning"
				local speed = if moving then 3 else 0
				poseRig(entry, model:GetPivot(), now, speed, now * speed, gaitEnabled)
			elseif entry.posed then
				poseRig(entry, model:GetPivot(), now, 0, 0, false)
			end
		end
	end
	if countdownElapsed >= 0.25 then
		countdownElapsed = 0
		local serverNow = Workspace:GetServerTimeNow()
		for model in pendingModels do
			if not model.Parent or observe(model) then
				pendingModels[model] = nil
			end
		end
		for model in pairs(countdowns) do
			local readyAt = model:GetAttribute("ReadyAt")
			if not model.Parent or type(readyAt) ~= "number" then
				countdowns[model] = nil
			else
				local countdown = model:FindFirstChild("Countdown", true)
				if countdown and countdown:IsA("TextLabel") then
					local remaining = math.max(0, math.ceil(readyAt - serverNow))
					countdown.Text = if remaining > 0 then "Hatching · " .. remaining .. "s" else "Hatching!"
				end
			end
		end
		for model in pairs(guardians) do
			if not model.Parent then
				guardians[model] = nil
			else
				local stateLabel = model:FindFirstChild("State", true)
				if stateLabel and stateLabel:IsA("TextLabel") then
					stateLabel.Text = if model:GetAttribute("Chasing")
						then "HEY! THAT'S MY EGG!"
						else "Keeping one eye on the nest..."
				end
			end
		end
	end
end)

connect(script.Destroying, function()
	closed = true
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	for model, entry in pairs(animated) do
		if model.Parent and entry.moved then
			model:PivotTo(entry.origin)
			poseRig(entry, entry.origin, 0, 0, 0, false)
		end
	end
	for model, entry in pairs(guardians) do
		if model.Parent then
			poseRig(entry, model:GetPivot(), 0, 0, 0, false)
		end
	end
	for _, watches in modelWatches do
		for _, connection in watches do
			connection:Disconnect()
		end
	end
	table.clear(modelWatches)
	table.clear(pendingModels)
	table.clear(animated)
	table.clear(countdowns)
	table.clear(guardians)
	hud:destroy()
	sound:destroy()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">SoundEffects</string>
            <string name="Source"><![CDATA[-- Local, short interaction cues using sounds shipped with Roblox itself.
-- No external audio IDs, uploads, looping tracks, or background music.
-- Edit profiles here for owned/licensed custom SoundIds later; volume is in Config.audio.
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")

local SoundEffects = {}
SoundEffects.__index = SoundEffects

local SPRING = "rbxasset://sounds/action_get_up.mp3"
local WHOOSH = "rbxasset://sounds/action_jump.mp3"
local TAP = "rbxasset://sounds/action_jump_land.mp3"
local SPLASH = "rbxasset://sounds/impact_water.mp3"

-- Sound profiles are brief mechanical/animal-like cues, not a musical soundtrack.
local CUES = {
	ui = { { id = TAP, pitch = 1.9, volume = 0.22, lifetime = 0.16 } },
	steal = { { id = WHOOSH, pitch = 0.85, volume = 0.65, lifetime = 0.55 } },
	escape = { { id = SPRING, pitch = 1.45, volume = 0.6, lifetime = 0.5 } },
	catch = { { id = TAP, pitch = 0.65, volume = 0.85, lifetime = 0.7 } },
	deposit = { { id = TAP, pitch = 1.2, volume = 0.48, lifetime = 0.45 } },
	upgrade = {
		{ id = WHOOSH, pitch = 1.25, volume = 0.48, lifetime = 0.4 },
		{ id = SPRING, pitch = 1.75, volume = 0.5, lifetime = 0.4, delay = 0.1 },
	},
	denied = { { id = TAP, pitch = 0.85, volume = 0.35, lifetime = 0.28 } },
	hatch = {
		{ id = SPLASH, pitch = 1.5, volume = 0.6, lifetime = 0.65 },
		{ id = SPRING, pitch = 1.65, volume = 0.7, lifetime = 0.5, delay = 0.13 },
	},
}

function SoundEffects.new(config)
	local audio = config.audio or {}
	local self = setmetatable({
		enabled = audio.enabled ~= false,
		volume = math.clamp(audio.volume or 0.4, 0, 1),
		destroyed = false,
		active = {},
		lastPlayed = {},
		generation = 0,
	}, SoundEffects)
	self.folder = Instance.new("Folder")
	self.folder.Name = "GoofyEggLocalSFX"
	self.folder.Parent = SoundService
	-- Preloading is optional and never blocks player input or game startup.
	task.spawn(function()
		local ok = pcall(function()
			ContentProvider:PreloadAsync({ SPRING, WHOOSH, TAP, SPLASH })
		end)
		if not ok and not self.destroyed then
			warn("Goofy Egg: sound preloading was unavailable; cues will load on demand.")
		end
	end)
	return self
end

function SoundEffects:_voice(profile, generation)
	if self.destroyed or not self.enabled or self.generation ~= generation then
		return
	end
	-- Bound simultaneous voices even if notices arrive in a burst.
	local count = 0
	for voice in self.active do
		if voice.Parent then
			count += 1
		end
	end
	if count >= 6 then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "InteractionCue"
	sound.SoundId = profile.id
	sound.Volume = self.volume * profile.volume
	sound.PlaybackSpeed = profile.pitch
	sound.Looped = false
	sound.Parent = self.folder
	self.active[sound] = true
	sound:Play()
	task.delay(profile.lifetime, function()
		self.active[sound] = nil
		sound:Destroy()
	end)
end

function SoundEffects:play(cue)
	if self.destroyed or not self.enabled then
		return
	end
	local profiles = CUES[cue]
	if not profiles then
		return
	end
	local now = os.clock()
	if now - (self.lastPlayed[cue] or -math.huge) < 0.12 then
		return
	end
	self.lastPlayed[cue] = now
	local generation = self.generation
	for _, profile in profiles do
		if profile.delay then
			task.delay(profile.delay, function()
				self:_voice(profile, generation)
			end)
		else
			self:_voice(profile, generation)
		end
	end
end

function SoundEffects:setEnabled(enabled)
	self.enabled = enabled == true
	if not self.enabled then
		self.generation += 1
		for sound in self.active do
			sound:Destroy()
		end
		table.clear(self.active)
	end
end

function SoundEffects:destroy()
	if self.destroyed then
		return
	end
	self:setEnabled(false)
	self.destroyed = true
	self.folder:Destroy()
end

return SoundEffects
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="31">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-80</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>